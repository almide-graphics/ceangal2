#!/usr/bin/env bash
# Pinned Almide toolchain. Downloads the release named in .almide-version into
# .tools/ on first use, then execs it. CI and local builds go through this.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ver="$(tr -d '[:space:]' < "$root/.almide-version")"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) asset=almide-macos-aarch64 ;;
  Darwin-x86_64) asset=almide-macos-x86_64 ;;
  Linux-x86_64) asset=almide-linux-x86_64 ;;
  Linux-aarch64) asset=almide-linux-aarch64 ;;
  MINGW*|MSYS*|CYGWIN*) asset=almide-windows-x86_64 ;;
  *) echo "tools/almide: unsupported host $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
dir="$root/.tools/$ver/$asset"
bin="$dir/almide"; [[ $asset == almide-windows-* ]] && bin="$dir/almide.exe"
if [[ ! -x "$bin" ]]; then
  mkdir -p "$root/.tools/$ver"
  url="https://github.com/almide/almide/releases/download/v$ver/$asset"
  if [[ $asset == almide-windows-* ]]; then
    curl -fsSL "$url.zip" -o "$root/.tools/$ver/a.zip" && (cd "$root/.tools/$ver" && unzip -qo a.zip)
  else
    curl -fsSL "$url.tar.gz" | tar xz -C "$root/.tools/$ver"
  fi
fi
exec "$bin" "$@"
