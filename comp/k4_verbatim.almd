// k4_verbatim: composite built up one feature at a time, 1024x1024 canvas.
import math

type Rgba = { r: Float, g: Float, b: Float, a: Float }
type Mat = { a: Float, b: Float, c: Float, d: Float, e: Float, f: Float }
type Grad = { linear: Bool, x1: Float, y1: Float, x2: Float, y2: Float, r: Float, offs: List[Float], cols: List[Rgba], user: Bool }
let transparent: Rgba = { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
fn clamp01(x: Float) -> Float = float.max(0.0, float.min(1.0, x))
fn apply_x(m: Mat, x: Float, y: Float) -> Float = m.a * x + m.c * y + m.e
fn apply_y(m: Mat, x: Float, y: Float) -> Float = m.b * x + m.d * y + m.f
fn getf(b: Bytes, i: Int) -> Float = bytes.get_f32_le(b, i * 4) ?? 0.0
fn setf(mut b: Bytes, i: Int, v: Float) -> Unit = bytes.put_f32_le(b, i * 4, v)

fn grad_color(g: Grad, t0: Float) -> Rgba = {
  let t = clamp01(t0)
  let n = list.len(g.offs)
  if n == 0 then transparent
  else if t <= g.offs[0] then g.cols[0]
  else if t >= g.offs[n - 1] then g.cols[n - 1]
  else {
    var c = g.cols[n - 1]
    var found = false
    for i in 1..<n {
      if not found and t <= g.offs[i] then {
        let span = float.max(0.000001, g.offs[i] - g.offs[i - 1])
        let u = (t - g.offs[i - 1]) / span
        let a = g.cols[i - 1]
        let b = g.cols[i]
        c = { r: a.r + (b.r - a.r) * u, g: a.g + (b.g - a.g) * u, b: a.b + (b.b - a.b) * u, a: a.a + (b.a - a.a) * u }
        found = true
      } else ()
    }
    c
  }
}fn comp(w: Int, h: Int, mut buf: Bytes, pxo: Int, x0: Int, x1: Int, y0: Int, y1: Int, color: Rgba, grad: Grad?, inv: Mat, bx: Float, by: Float, bw: Float, bh: Float, alpha: Float, evenodd: Bool) -> Unit = {
  let stride = w + 2
  for y in int.max(0, y0)..<int.min(h, y1) {
    var sum = 0.0
    for x in int.max(0, x0)..<int.min(stride, x1) {
      let i = y * stride + x
      sum = sum + getf(buf, i)
      setf(buf, i, 0.0)
      if x < w then {
        let cov0 = if evenodd then { let m = float.abs(sum) % 2.0; if m > 1.0 then 2.0 - m else m } else float.min(1.0, float.abs(sum))
        if cov0 > 0.002 then {
          let col = match grad {
            some(g) => {
              let qx = float.from(x) + 0.5
              let qy = float.from(y) + 0.5
              let ux0 = apply_x(inv, qx, qy)
              let uy0 = apply_y(inv, qx, qy)
              let ux = if g.user then ux0 else (ux0 - bx) / float.max(0.000001, bw)
              let uy = if g.user then uy0 else (uy0 - by) / float.max(0.000001, bh)
              if g.linear then {
                let dx = g.x2 - g.x1
                let dy = g.y2 - g.y1
                let l2 = float.max(0.000001, dx * dx + dy * dy)
                grad_color(g, ((ux - g.x1) * dx + (uy - g.y1) * dy) / l2)
              } else grad_color(g, math.sqrt((ux - g.x1) * (ux - g.x1) + (uy - g.y1) * (uy - g.y1)) / float.max(0.000001, g.r))
            },
            none => color,
          }
          let a = col.a * alpha * cov0
          let o = (y * w + x) * 4
          let da = getf(buf, pxo + o + 3)
          let out_a = a + da * (1.0 - a)
          if out_a > 0.0 then {
            setf(buf, pxo + o, (col.r * a + getf(buf, pxo + o) * da * (1.0 - a)) / out_a)
            setf(buf, pxo + o + 1, (col.g * a + getf(buf, pxo + o + 1) * da * (1.0 - a)) / out_a)
            setf(buf, pxo + o + 2, (col.b * a + getf(buf, pxo + o + 2) * da * (1.0 - a)) / out_a)
            setf(buf, pxo + o + 3, out_a)
          } else ()
        } else ()
      } else ()
    }
  }
}
effect fn main() -> Unit = {
  let w = 1024
  let h = 1024
  let pxo = (w + 2) * h + 4
  var buf = bytes.zeros((pxo + w * h * 4) * 4)
  for y in 0..<h { bytes.put_f32_le(buf, (y * (w + 2)) * 4, 1.0) }
  let m = { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
  comp(w, h, buf, pxo, 0, w + 2, 0, h, { r: 0.5, g: 0.6, b: 0.9, a: 1.0 }, none, m, 0.0, 0.0, 1.0, 1.0, 1.0, false)
  println("${getf(buf, pxo + 4 * (w * h - 1))}")
}
