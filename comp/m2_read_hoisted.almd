// m1 with the read moved into a `let` before the call.
fn getf(b: Bytes, i: Int) -> Float = bytes.get_f32_le(b, i * 4) ?? 0.0
fn setf(mut b: Bytes, i: Int, v: Float) -> Unit = bytes.put_f32_le(b, i * 4, v)

fn bump(mut buf: Bytes, n: Int) -> Unit = {
  for i in 0..<n {
    let v = getf(buf, i) + 1.0
    setf(buf, i, v)
  }
}

effect fn main() -> Unit = {
  var buf = bytes.zeros(4000000)
  bump(buf, 20000)
  println("${getf(buf, 19999)}")
}
