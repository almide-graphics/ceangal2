# Store identity, read by tools/package_*.sh.
APP_ID=dev.almide.playground
APP_NAME="Almide Playground"
VERSION=0.1.0
VERSION_CODE=1
# Asset directories bundled with the app (relative to the repo root).
APP_ASSETS="apps/playground/assets assets"
# The app talks to the network (AI assistant, BYOK).
APP_NETWORK=1
