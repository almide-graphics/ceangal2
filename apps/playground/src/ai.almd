// The AI assistant (bring your own key): Anthropic / OpenAI / Gemini over
// the host's `net` namespace, SSE streamed into the project's tabs, then an
// automatic repair loop — run the project, send any error back, up to three
// times.
//
// A session is one conversation. Each request either writes a new program
// (the project is replaced) or edits the project; either way the AI sees
// every file and answers with the files it writes, each after a
// `=== name.almd ===` line, and every request can be undone.

import ceangal
import ceangal.editor as ed
import ceangal.host.sys as sys
import ceangal.host.net as net
import ceangal.host.storage as storage
import json
import self.state as st

type Model = { id: String, label: String, effort: Bool }
type Msg = { role: String, content: String }
// One line of the AI panel's conversation. kind: 0 the user's request,
// 1 writing (updated while streaming), 2 ran fine, 3 an error, 4 a repair
// (detail: its diff), 5 a note (cancelled, request failed).
// A request (kind 0) keeps the files as they were before it, for Undo.
type Entry = { kind: Int, text: String, detail: String, files: List[(String, String)] }

let PROVIDERS = ["Claude", "OpenAI", "Gemini"]
let MAX_REPAIRS = 3
let FORMAT = "Reply with each file you write: a line `=== name.almd ===`, then the file's whole content. main.almd holds `main`. Leave out files you do not change. No explanations, no code fences."
let REPAIR_INSTRUCTION = "\n\nFix it. " + FORMAT

pub fn models(p: Int) -> List[Model] =
  if p == 0 then [
    { id: "claude-opus-5-5", label: "Opus 5.5", effort: true },
    { id: "claude-sonnet-5-5", label: "Sonnet 5.5", effort: true },
    { id: "claude-haiku-4-5", label: "Haiku 4.5", effort: false },
  ] else if p == 1 then [
    { id: "gpt-4o", label: "GPT-4o", effort: false },
    { id: "gpt-4o-mini", label: "GPT-4o mini", effort: false },
  ] else [
    { id: "gemini-2.5-flash", label: "Gemini 2.5 Flash", effort: false },
    { id: "gemini-2.0-flash", label: "Gemini 2.0 Flash", effort: false },
  ]

fn key_placeholder(p: Int) -> String = if p == 0 then "sk-ant-…" else if p == 1 then "sk-…" else "AIza…"

// ── State ──

var open = false
var settings_open = false
var provider = 0
var model_ix = 0
var key_field = ed.with_secret(ed.text_field("", key_placeholder(0)), true)
var prompt_field = ed.text_field("", "Describe a program and press Enter")
var entries: List[Entry] = []
var expanded: List[Int] = []   // entries showing their detail
var turns = 0                  // programs written in this conversation
var phase = 0            // 0 idle, 1 streaming, 2 waiting for the run
var req_id = -1
var http_status = 0
var pending: Bytes = bytes.new(0)   // undecoded tail of the SSE stream
var error_body = ""
var generated = ""
var messages: List[Msg] = []
var attempt = 0
var my_run = -1             // the run this request started
var before_stream: List[(String, String)] = []   // the files when this stream started
var replacing = false        // this stream writes a new program (the project is replaced)
var started = false          // text has arrived on this stream
var mode = -1                // -1 automatic, 0 edit the project, 1 a new program
var loaded = false

pub fn busy() -> Bool = phase != 0

// ── Persistence: provider, model, and the key in secret storage ──

fn kv_get(k: String, secret: Bool) -> String = {
  let kb = bytes.from_string(k)
  let n = if secret then storage.secret_len(bytes.data_ptr(kb), bytes.len(kb)) else storage.storage_len(bytes.data_ptr(kb), bytes.len(kb))
  if n <= 0 then ""
  else {
    var b = bytes.new(n)
    let _ = if secret then storage.secret_read(bytes.data_ptr(kb), bytes.len(kb), bytes.data_ptr(b), n) else storage.storage_read(bytes.data_ptr(kb), bytes.len(kb), bytes.data_ptr(b), n)
    bytes.to_string_lossy(b)
  }
}

fn kv_set(k: String, v: String, secret: Bool) -> Unit = {
  let kb = bytes.from_string(k)
  let vb = bytes.from_string(v)
  if secret then storage.secret_write(bytes.data_ptr(kb), bytes.len(kb), bytes.data_ptr(vb), bytes.len(vb))
  else storage.storage_write(bytes.data_ptr(kb), bytes.len(kb), bytes.data_ptr(vb), bytes.len(vb))
}

fn key_name(p: Int) -> String = "ai-key-" + int.to_string(p)

fn load_provider(p: Int) -> Unit = {
  provider = p
  key_field = ed.with_secret(ed.text_field(kv_get(key_name(p), true), key_placeholder(p)), true)
  let saved = kv_get("ai-model-" + int.to_string(p), false)
  var ix = 0
  let ms = models(p)
  for i in 0..<list.len(ms) { if ms[i].id == saved then ix = i else () }
  model_ix = ix
}

fn ensure_loaded() -> Unit = if not loaded then {
  loaded = true
  let p = int.parse(kv_get("ai-provider", false)) ?? 0
  load_provider(if p >= 0 and p <= 2 then p else 0)
} else ()

pub fn toggle() -> Unit = {
  ensure_loaded()
  open = not open
  // without a key the card stays until Done (it must not vanish mid-typing)
  if open and not has_key() then settings_open = true else ()
  if open then ceangal.focus(if has_key() then "ai-prompt" else "ai-key") else ()
}

pub fn close() -> Unit = { open = false }

// The key / provider / model card: shown until a key is set, then on ⚙.
pub fn show_settings() -> Bool = settings_open or not has_key()
pub fn toggle_settings() -> Unit = {
  ensure_loaded()
  settings_open = not show_settings()
  if settings_open then ceangal.focus("ai-key") else ceangal.focus("ai-prompt")
}
pub fn model_label() -> String = { ensure_loaded(); models(provider)[model_ix].label }

// A new session: the conversation starts over (the files stay as they are).
pub fn new_chat() -> Unit = if phase == 0 then { entries = []; expanded = []; turns = 0; mode = -1; ceangal.focus("ai-prompt") } else ()

// Whether the next request writes a new program: the user's pick, else a new
// program when the session is fresh and the project is still an untouched
// example, else an edit.
pub fn writes_new() -> Bool = if mode >= 0 then mode == 1 else turns == 0 and st.untouched()
pub fn set_mode(new_program: Bool) -> Unit = { mode = if new_program then 1 else 0; ceangal.focus("ai-prompt") }

fn names(fs: List[(String, String)]) -> String = {
  var ns: List[String] = []
  for (n, _) in fs { list.push(ns, n) }
  string.join(ns, ", ")
}

// What the next request will see and write, in a line.
pub fn scope() -> String =
  if writes_new() then "Writes a new program in place of " + names(st.files()) + " (Undo brings it back)"
  else "Sees and edits " + names(st.files())

pub fn placeholder() -> String = if writes_new() then "Describe a new program…" else "Describe a change…"

// Undo request `i`: the files as they were before it.
pub fn undo(i: Int) -> Unit = if phase == 0 then match list.get(entries, i) {
  some(e) => if e.kind == 0 and list.len(e.files) > 0 then {
    st.set_files(e.files)
    note(5, "Undid “" + e.text + "”", "")
  } else (),
  none => (),
} else ()

pub fn toggle_entry(i: Int) -> Unit =
  if list.contains(expanded, i) then expanded = list.filter(expanded, (j) => j != i)
  else list.push(expanded, i)

pub fn is_expanded(i: Int) -> Bool = list.contains(expanded, i)

// A suggestion chip: fill the prompt and send it.
pub fn suggest(s: String) -> Unit = { prompt_field = ed.set_text(prompt_field, s); generate() }

pub fn select_provider(p: Int) -> Unit = {
  kv_set(key_name(provider), ed.to_string(key_field), true)
  load_provider(p)
  kv_set("ai-provider", int.to_string(p), false)
}

pub fn select_model(i: Int) -> Unit = {
  model_ix = i
  kv_set("ai-model-" + int.to_string(provider), models(provider)[i].id, false)
}

pub fn set_key_field(e: ed.Editor) -> Unit = {
  let before = ed.to_string(key_field)
  key_field = e
  let after = ed.to_string(e)
  if after != before then kv_set(key_name(provider), string.trim(after), true) else ()
}

pub fn set_prompt_field(e: ed.Editor) -> Unit = { prompt_field = e }

pub fn has_key() -> Bool = { ensure_loaded(); string.trim(ed.to_string(key_field)) != "" }

// ── The conversation ──

fn note(kind: Int, text: String, detail: String) -> Unit = {
  list.push(entries, { kind: kind, text: text, detail: detail, files: [] })
  ceangal.scroll_to_end("ai-log")
}

// While streaming, the last entry counts the lines written so far.
fn writing(text: String) -> Unit = {
  let n = list.len(entries)
  if n > 0 and entries[n - 1].kind == 1 then { entries[n - 1] = { kind: 1, text: text, detail: "", files: [] }; ceangal.scroll_to_end("ai-log") }
  else note(1, text, "")
}

// The line that says what went wrong: the first one that is not just a
// heading such as "Compile error:".
fn first_line(s: String) -> String = {
  let ls = list.filter(string.split(string.trim(s), "\n"), (l) => string.trim(l) != "")
  match list.find(ls, (l) => not string.ends_with(string.trim(l), ":")) {
    some(l) => string.trim(l),
    none => match list.get(ls, 0) { some(l) => l, none => "" },
  }
}

fn lines_of(s: String) -> Int = list.len(string.split(string.trim(s), "\n"))

fn n_lines(n: Int) -> String = int.to_string(n) + (if n == 1 then " line" else " lines")

// A short line diff around the changes (as in the previous playground), and
// how many lines it adds and removes.
fn diff(before: String, after: String) -> (String, Int, Int) = {
  let a = string.split(before, "\n")
  let b = string.split(after, "\n")
  var out: List[String] = []
  var plus = 0
  var minus = 0
  var i = 0
  var j = 0
  while i < list.len(a) or j < list.len(b) {
    if i < list.len(a) and j < list.len(b) and a[i] == b[j] then { i = i + 1; j = j + 1 }
    else if j < list.len(b) and (i >= list.len(a) or not list.contains(a, b[j])) then { list.push(out, "+ " + b[j]); plus = plus + 1; j = j + 1 }
    else if i < list.len(a) and (j >= list.len(b) or not list.contains(b, a[i])) then { list.push(out, "- " + a[i]); minus = minus + 1; i = i + 1 }
    else { list.push(out, "- " + a[i]); list.push(out, "+ " + b[j]); plus = plus + 1; minus = minus + 1; i = i + 1; j = j + 1 }
  }
  (string.join(list.take(out, 80), "\n"), plus, minus)
}

// ── Files in requests and replies ──

fn project_block(fs: List[(String, String)]) -> String = {
  var out = "The project's files:\n"
  for (n, t) in fs { out = out + "\n=== " + n + " ===\n" + t + (if string.ends_with(t, "\n") then "" else "\n") }
  out
}

fn marker_name(line: String) -> String? = {
  let l = string.trim(line)
  if string.starts_with(l, "=== ") and string.ends_with(l, " ===") and string.len(l) > 8 then {
    let n = string.trim(string.slice(l, 4, string.len(l) - 4))
    if n != "" and not string.contains(n, " ") and not string.contains(n, "/") then some(n) else none
  } else none
}

fn is_fence(line: String) -> Bool = string.starts_with(string.trim(line), "```")

// The files in a reply: blocks after `=== name ===` lines; a reply without
// them is one file, `fallback`. Code fences are dropped.
fn split_files(t: String, fallback: String) -> List[(String, String)] = {
  var out: List[(String, String)] = []
  var name = ""
  var buf: List[String] = []
  var any = false
  for line in string.split(t, "\n") {
    match marker_name(line) {
      some(n) => {
        if name != "" then list.push(out, (name, string.join(buf, "\n"))) else ()
        name = n
        buf = []
        any = true
      },
      none => if not is_fence(line) then list.push(buf, line) else (),
    }
  }
  if any then { if name != "" then list.push(out, (name, string.join(buf, "\n"))) else () }
  else list.push(out, (fallback, string.join(buf, "\n")))
  var tidy: List[(String, String)] = []
  for (n, c) in out { list.push(tidy, (n, string.trim(c) + "\n")) }
  tidy
}

// Where a reply without file markers goes: main.almd for a new program, the
// only file, or the file on screen.
fn fallback_file() -> String =
  if replacing or list.len(before_stream) <= 1 then st.ENTRY else st.active_name()

// Put what has streamed so far into the tabs (a new program first empties
// the project).
fn apply_reply(t: String) -> List[(String, String)] = {
  let fs = split_files(t, fallback_file())
  if replacing and not started then st.set_files([(st.ENTRY, "")]) else ()
  started = true
  for (n, c) in fs { st.set_file(n, c) }
  fs
}

// The diff of a reply against the files before it, as one summary line and
// the details.
fn summary(before: List[(String, String)], wrote: List[(String, String)]) -> (String, String) = {
  var parts: List[String] = []
  var detail: List[String] = []
  for (n, c) in wrote {
    var old = ""
    var had = false
    for (bn, bt) in before { if bn == n then { old = bt; had = true } else () }
    if not had or replacing then {
      list.push(parts, (if had then "rewrote " else "wrote ") + n + " (" + n_lines(lines_of(c)) + ")")
    } else {
      let (d, plus, minus) = diff(old, c)
      if plus + minus > 0 then {
        list.push(parts, n + " +" + int.to_string(plus) + " −" + int.to_string(minus))
        list.push(detail, "── " + n + "\n" + d)
      } else ()
    }
  }
  let line = if list.len(parts) == 0 then "no changes" else string.join(parts, ", ")
  (line, string.join(detail, "\n"))
}

// ── Requests ──

// Tests point the providers at a mock server with an `ai/base.txt` asset
// (never shipped; not reachable from a link, so a key cannot be redirected).
fn endpoint(real: String) -> String = {
  let k = bytes.from_string("ai/base.txt")
  let n = sys.asset_len(bytes.data_ptr(k), bytes.len(k))
  if n <= 0 then real
  else {
    var b = bytes.new(n)
    let _ = sys.asset_read(bytes.data_ptr(k), bytes.len(k), bytes.data_ptr(b), n)
    let base = string.trim(bytes.to_string_lossy(b))
    match string.index_of(real, "/v1") { some(i) => base + string.drop(real, i), none => base }
  }
}

fn system_prompt() -> String = {
  let k = bytes.from_string("ai/system.md")
  let n = sys.asset_len(bytes.data_ptr(k), bytes.len(k))
  if n <= 0 then "You write Almide (.almd) programs. Output only source code."
  else {
    var b = bytes.new(n)
    let _ = sys.asset_read(bytes.data_ptr(k), bytes.len(k), bytes.data_ptr(b), n)
    bytes.to_string_lossy(b)
  }
}

fn msg_values(ms: List[Msg]) -> List[Value] = {
  var out: List[Value] = []
  for m in ms { list.push(out, value.object([("role", value.str(m.role)), ("content", value.str(m.content))])) }
  out
}

fn header(id: Int, name: String, v: String) -> Unit = {
  let nb = bytes.from_string(name)
  let vb = bytes.from_string(v)
  net.http_header(id, bytes.data_ptr(nb), bytes.len(nb), bytes.data_ptr(vb), bytes.len(vb))
}

fn begin(url: String) -> Int = {
  let mb = bytes.from_string("POST")
  let ub = bytes.from_string(url)
  // bound, not returned directly: a value-returning call in tail position
  // sees its Bytes already freed on wasm (almide/almide#3420)
  let id = net.http_begin(bytes.data_ptr(mb), bytes.len(mb), bytes.data_ptr(ub), bytes.len(ub))
  id
}

fn start_stream() -> Unit = {
  let key = string.trim(ed.to_string(key_field))
  let m = models(provider)[model_ix]
  generated = ""
  pending = bytes.new(0)
  error_body = ""
  http_status = 0
  // The code stays on screen until the first streamed text replaces it, and
  // comes back if the request fails or is stopped.
  before_stream = st.files()
  started = false
  let id =
    if provider == 0 then {
      let r = begin(endpoint("https://api.anthropic.com/v1/messages"))
      header(r, "content-type", "application/json")
      header(r, "x-api-key", key)
      header(r, "anthropic-version", "2023-06-01")
      header(r, "anthropic-dangerous-direct-browser-access", "true")
      r
    } else if provider == 1 then {
      let r = begin(endpoint("https://api.openai.com/v1/chat/completions"))
      header(r, "content-type", "application/json")
      header(r, "authorization", "Bearer " + key)
      r
    } else {
      let r = begin(endpoint("https://generativelanguage.googleapis.com/v1beta/models/" + m.id + ":streamGenerateContent?alt=sse"))
      header(r, "content-type", "application/json")
      header(r, "x-goog-api-key", key)
      r
    }
  let sp = system_prompt()
  let body =
    if provider == 0 then {
      var fields: List[(String, Value)] = [
        ("model", value.str(m.id)), ("max_tokens", value.int(16000)), ("system", value.str(sp)),
        ("stream", value.bool(true)), ("messages", value.array(msg_values(messages))),
      ]
      // low effort keeps adaptive thinking shallow so the first token lands fast
      if m.effort then list.push(fields, ("output_config", value.object([("effort", value.str("low"))]))) else ()
      value.object(fields)
    } else if provider == 1 then
      value.object([
        ("model", value.str(m.id)), ("max_tokens", value.int(4096)), ("stream", value.bool(true)),
        ("messages", value.array([value.object([("role", value.str("system")), ("content", value.str(sp))])] + msg_values(messages))),
      ])
    else {
      var contents: List[Value] = []
      for mm in messages {
        let role = if mm.role == "assistant" then "model" else "user"
        list.push(contents, value.object([("role", value.str(role)), ("parts", value.array([value.object([("text", value.str(mm.content))])]))]))
      }
      value.object([
        ("system_instruction", value.object([("parts", value.array([value.object([("text", value.str(sp))])]))])),
        ("contents", value.array(contents)),
      ])
    }
  let bb = bytes.from_string(json.stringify(body))
  net.http_send(id, bytes.data_ptr(bb), bytes.len(bb))
  req_id = id
  phase = 1
}

// ── SSE ──

fn field_of(v: Value, k: String) -> Value? = match value.field(v, k) { ok(x) => some(x), err(_) => none }

fn first_of(v: Value?) -> Value? = match v {
  some(x) => match value.as_array(x) { ok(xs) => list.get(xs, 0), err(_) => none },
  none => none,
}

fn str_of(v: Value?) -> String = match v {
  some(x) => match value.as_string(x) { ok(s) => s, err(_) => "" },
  none => "",
}

fn deep(v: Value?, k: String) -> Value? = match v { some(x) => field_of(x, k), none => none }

// The text one SSE event carries, per provider.
fn event_text(data: String) -> String = match json.parse(data) {
  ok(v) =>
    if provider == 0 then (if str_of(field_of(v, "type")) == "content_block_delta" then str_of(deep(field_of(v, "delta"), "text")) else "")
    else if provider == 1 then str_of(deep(deep(first_of(field_of(v, "choices")), "delta"), "content"))
    else {
      var t = ""
      match deep(deep(first_of(field_of(v, "candidates")), "content"), "parts") {
        some(ps) => match value.as_array(ps) {
          ok(parts) => { for p in parts { t = t + str_of(field_of(p, "text")) } },
          err(_) => (),
        },
        none => (),
      }
      t
    },
  err(_) => "",
}

// Feed a body chunk: decode whole lines only (a UTF-8 sequence or a line may
// straddle two chunks), and append any streamed text to the active tab.
fn feed(chunk: Bytes) -> Unit = {
  let all = bytes.concat(pending, chunk)
  var last_nl = -1
  for i in 0..<bytes.len(all) { if bytes.read_u8(all, i) == 10 then last_nl = i else () }
  if last_nl < 0 then pending = all
  else {
    let text = bytes.to_string_lossy(bytes.slice(all, 0, last_nl + 1))
    pending = bytes.slice(all, last_nl + 1, bytes.len(all))
    var added = ""
    for line in string.split(text, "\n") {
      let l = string.trim_end(line)
      if string.starts_with(l, "data: ") then {
        let data = string.drop(l, 6)
        if data != "[DONE]" then added = added + event_text(data) else ()
      } else ()
    }
    if added != "" then {
      generated = generated + added
      let _ = apply_reply(generated)
      writing(if attempt == 0 then "Writing… " + n_lines(lines_of(generated)) else "Fixing… " + n_lines(lines_of(generated)))
    } else ()
  }
}


// ── Flow ──

fn finish(msg: String) -> Unit = { phase = 0; req_id = -1; st.set_status(msg) }

pub fn generate() -> Unit = {
  ensure_loaded()
  if phase != 0 then stop()
  else if not has_key() then { open = true; settings_open = true; st.set_status("Enter your API key first"); ceangal.focus("ai-key") }
  else {
    let prompt = string.trim(ed.to_string(prompt_field))
    if prompt == "" then { st.set_status("Describe what to generate"); ceangal.focus("ai-prompt") }
    else {
      prompt_field = ed.set_text(prompt_field, "")
      settings_open = false
      // Phone layout: close the sheet and show the editor, so the code is
      // seen streaming in.
      if ceangal.viewport_width() < 760.0 then { open = false; st.show_code() } else ()
      let fresh = writes_new()
      let fs = st.files()
      list.push(entries, { kind: 0, text: prompt, detail: if fresh then "New program" else "Edit · " + names(fs), files: fs })
      ceangal.scroll_to_end("ai-log")
      // A new program needs only the request; an edit carries every file.
      messages = [{ role: "user", content:
        if fresh then prompt + "\n\n" + FORMAT
        else project_block(fs) + "\nChange the project: " + prompt + "\n\n" + FORMAT }]
      replacing = fresh
      attempt = 0
      st.set_status("Generating…")
      start_stream()
    }
  }
}

// "Fix with AI" after a failed run: start the repair loop from the project.
pub fn fix_last_run() -> Unit = {
  ensure_loaded()
  if not has_key() then { open = true; settings_open = true; st.set_status("Add an API key to fix with AI"); ceangal.focus("ai-key") }
  else if phase == 0 and not st.last_run_ok and st.last_run_error != "" then {
    if ceangal.viewport_width() >= 760.0 then open = true else ()
    let fs = st.files()
    list.push(entries, { kind: 0, text: "Fix the last run", detail: "Edit · " + names(fs), files: fs })
    note(3, first_line(st.last_run_error), st.last_run_error)
    messages = [{ role: "user", content: project_block(fs) + "\nRunning the project fails:\n\n" + st.last_run_error + REPAIR_INSTRUCTION }]
    replacing = false
    attempt = 1
    st.set_status("Repairing (1/" + int.to_string(MAX_REPAIRS) + ")…")
    start_stream()
  } else ()
}

fn repair(error: String) -> Unit = {
  attempt = attempt + 1
  replacing = false
  list.push(messages, { role: "user", content: error + REPAIR_INSTRUCTION })
  st.set_status("Repairing (" + int.to_string(attempt) + "/" + int.to_string(MAX_REPAIRS) + ")…")
  start_stream()
}

pub fn stop() -> Unit = if phase != 0 then {
  if req_id >= 0 then net.http_cancel(req_id) else ()
  if phase == 1 then restore() else ()
  drop_writing()
  note(5, "Stopped", "")
  finish("Cancelled")
} else ()

fn restore() -> Unit = if started then st.set_files(before_stream) else ()

fn drop_writing() -> Unit = {
  let n = list.len(entries)
  if n > 0 and entries[n - 1].kind == 1 then entries = list.take(entries, n - 1) else ()
}

// What the provider's error body says, in one line.
fn api_message(body: String) -> String = match json.parse(body) {
  ok(v) => {
    let m = str_of(deep(field_of(v, "error"), "message"))
    if m != "" then m else first_line(body)
  },
  err(_) => first_line(body),
}

fn stream_done() -> Unit = {
  drop_writing()
  if http_status < 200 or http_status >= 300 then {
    let why =
      if http_status == 0 then "The request did not reach " + PROVIDERS[provider] + "."
      else if http_status == 401 or http_status == 403 then "The API key was refused (" + int.to_string(http_status) + "). Check it in ⚙."
      else if http_status == 429 then "Rate limited or out of credit (429)."
      else "Error " + int.to_string(http_status) + " from " + PROVIDERS[provider] + "."
    restore()
    note(5, why + " Your code is unchanged.", api_message(string.slice(error_body, 0, 2000)))
    finish(if http_status == 0 then "AI request failed" else "AI error " + int.to_string(http_status))
  } else {
    let wrote = apply_reply(generated)
    // the reply as the conversation's next turn (fences dropped)
    var reply = ""
    for (n, c) in wrote { reply = reply + "=== " + n + " ===\n" + c }
    list.push(messages, { role: "assistant", content: reply })
    let (line, detail) = summary(before_stream, wrote)
    note(4, (if attempt > 0 then "Fix " + int.to_string(attempt) + "/" + int.to_string(MAX_REPAIRS) + " · " else "") + line, detail)
    phase = 2
    req_id = -1
    // Stopping a run still going reports it finished at once: wait for the
    // run started here, by its id.
    st.run_fresh()
    my_run = st.run_id
  }
}

// Results for our request (main forwards every event 10 here first).
pub fn on_result(id: Int, code: Int, body: Bytes) -> Bool =
  if id != req_id or phase != 1 then false
  else {
    if code >= 1000 then {
      http_status = code - 1000
      if http_status >= 200 and http_status < 300 then feed(body) else { error_body = error_body + bytes.to_string_lossy(body) }
    } else {
      if code == 0 then error_body = error_body + bytes.to_string_lossy(body) else ()
      http_status = code
      if code >= 200 and code < 300 then feed(bytes.from_string("\n")) else ()
      stream_done()
    }
    true
  }

// Per frame: notice when the run we started has finished.
pub fn tick() -> Unit = if phase == 2 and st.finished_run == my_run and not st.running then {
  if st.last_run_ok then {
    note(2, if attempt == 0 then "Compiled and ran" else "Fixed — compiled and ran", "")
    turns = turns + 1
    mode = -1
    finish(if attempt == 0 then "Generated & running" else "Repaired (" + int.to_string(attempt) + ") & running")
  } else if attempt < MAX_REPAIRS then {
    note(3, first_line(st.last_run_error), st.last_run_error)
    repair(st.last_run_error)
  } else {
    note(3, first_line(st.last_run_error), st.last_run_error)
    note(5, "Gave up after " + int.to_string(MAX_REPAIRS) + " fixes", "")
    turns = turns + 1
    mode = -1
    finish("AI repair failed")
  }
} else ()
