// Small UI icons the fonts do not carry (✦, ⚙…): SVG paths rasterised by
// snaidhm.vector into textures, one per name, colour and pixel size, kept
// for the life of the app. The sparkle is almide/playground's AI mark.

import snaidhm
import snaidhm.vector as vector

var cache: List[(String, Int)] = []

fn hex2(n: Int) -> String = {
  let d = "0123456789abcdef"
  string.slice(d, n / 16, n / 16 + 1) + string.slice(d, n % 16, n % 16 + 1)
}

fn hex(rgb: Int) -> String = "#" + hex2((rgb / 65536) % 256) + hex2((rgb / 256) % 256) + hex2(rgb % 256)

fn shapes(name: String, c: String) -> String =
  if name == "sparkle" then
    "<path fill=\"" + c + "\" d=\"M12 2l1.9 5.72a2 2 0 0 0 1.26 1.26L21 10.9l-5.84 1.92a2 2 0 0 0-1.26 1.26L12 19.9l-1.9-5.82a2 2 0 0 0-1.26-1.26L3 10.9l5.84-1.92A2 2 0 0 0 10.1 7.72L12 2z\"/>"
    + "<path fill=\"" + c + "\" d=\"M19.2 14.4l.75 2.25 2.25.75-2.25.75-.75 2.25-.75-2.25-2.25-.75 2.25-.75.75-2.25z\"/>"
  else if name == "gear" then {
    // eight teeth around a ring
    var t = ""
    for i in 0..<8 {
      t = t + "<rect x=\"10.2\" y=\"1.5\" width=\"3.6\" height=\"5\" rx=\"1\" fill=\"" + c + "\" transform=\"rotate(" + int.to_string(i * 45) + " 12 12)\"/>"
    }
    t + "<circle cx=\"12\" cy=\"12\" r=\"6.6\" fill=\"none\" stroke=\"" + c + "\" stroke-width=\"3.4\"/>"
  }
  else if name == "more" then
    "<circle cx=\"5\" cy=\"12\" r=\"2.1\" fill=\"" + c + "\"/><circle cx=\"12\" cy=\"12\" r=\"2.1\" fill=\"" + c + "\"/><circle cx=\"19\" cy=\"12\" r=\"2.1\" fill=\"" + c + "\"/>"
  else if name == "chevron" then
    "<path d=\"M6 9l6 6 6-6\" fill=\"none\" stroke=\"" + c + "\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>"
  else if name == "send" then
    "<path d=\"M12 19V6M6 11l6-6 6 6\" fill=\"none\" stroke=\"" + c + "\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>"
  else if name == "stop" then
    "<rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\" fill=\"" + c + "\"/>"
  else if name == "close" then
    "<path d=\"M6 6l12 12M18 6L6 18\" fill=\"none\" stroke=\"" + c + "\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>"
  else if name == "new" then
    "<path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"" + c + "\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>"
  else if name == "play" then
    "<path d=\"M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z\" fill=\"" + c + "\"/>"
  else ""

// The texture for `name` in colour `rgb` (0xRRGGBB) at `px` pixels square.
pub fn texture(name: String, rgb: Int, px: Int) -> Int = {
  let key = name + "/" + int.to_string(rgb) + "/" + int.to_string(px)
  var found = 0
  for kv in cache { if kv.0 == key then found = kv.1 else () }
  if found != 0 then found
  else {
    let svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\">" + shapes(name, hex(rgb)) + "</svg>"
    let img = vector.rasterize_svg(svg, px)
    let tex = if img.w > 0 then snaidhm.create_image(img.w, img.h, img.rgba) else 0
    if tex != 0 then list.push(cache, (key, tex)) else ()
    tex
  }
}
