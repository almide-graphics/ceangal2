let keep_ai_set_mode = ai.set_mode

fn c(n: Int) -> snaidhm.Color = snaidhm.hex(n)

fn label(s: String, size: Float, col: Int) -> v.View = v.text(s) |> v.font(size) |> v.color(c(col))

// Text broken into lines at word boundaries to fit `width` (labels are one
// line). The paragraph is one node for screen readers.
fn wrap_lines(s: String, size: Float, width: Float) -> List[String] = {
  var lines: List[String] = []
  var cur = ""
  for w in string.split(s, " ") {
    if w != "" then {
      let next = if cur == "" then w else cur + " " + w
      if cur != "" and text.width(next, size, false, false) > width then { list.push(lines, cur); cur = w }
      else cur = next
    } else ()
  }
  if cur != "" then list.push(lines, cur) else ()
  lines
}

fn para(s: String, size: Float, col: Int, width: Float) -> v.View = {
  var rows: List[v.View] = []
  for l in wrap_lines(s, size, width) { list.push(rows, label(l, size, col) |> v.a11y_hidden()) }
  v.col(rows) |> v.gap(size * 0.35) |> v.role(4) |> v.label(s)
}

// The code views' theme: Almide's syntax colours on the playground surface.
pub fn code_theme() -> ed.Theme = if st.is_light() then {
  ...ed.light_theme(),
  bg: c(pal.bg), gutter_bg: c(pal.bg), gutter_fg: c(0x9AABBA), gutter_active: c(pal.faint),
  caret: c(pal.accent),
  selection: snaidhm.rgba(0.035, 0.396, 0.471, 0.18),
  active_line: snaidhm.rgba(0.035, 0.396, 0.471, 0.05),
  error: c(pal.stop), warning: c(pal.warn), placeholder: c(pal.faint),
} else {
  ...ed.dark_theme(),
  bg: c(pal.bg), gutter_bg: c(pal.bg), gutter_fg: c(pal.faint), gutter_active: c(pal.muted),
  caret: c(pal.accent_light),
  selection: snaidhm.rgba(0.078, 0.635, 0.635, 0.3),
  active_line: snaidhm.rgba(0.078, 0.635, 0.635, 0.07),
  error: c(pal.stop), warning: c(pal.warn), placeholder: c(pal.faint),
}

fn button(s: String, on: Bool, f: () -> Unit) -> v.View =
  label(s, 12.5, if on then pal.on_accent else pal.button_text)
    |> v.px(14.0) |> v.py(6.0) |> v.rounded(6.0)
    |> v.bg(if on then c(pal.accent) else c(pal.button))
    |> v.border(1.0, c(if on then pal.accent_light else pal.button_border))
    |> v.on_click(f) |> v.role(3) |> v.label(s)

// An icon from icons.almd, `size` logical px square, in colour `rgb`.
fn icon(name: String, size: Float, rgb: Int) -> v.View =
  v.custom("icon-" + name, (x, y, w, h) => {
    let k = ceangal.pixel_scale()
    let px = float.to_int(size * k + 0.999)
    let tex = icons.texture(name, rgb, px)
    if tex != 0 then snaidhm.image(tex, (x + (w - size) / 2.0) * k, (y + (h - size) / 2.0) * k, size * k, size * k, 0.0, 1.0) else ()
  }) |> v.size(size, size)

// A quiet header control: no fill until it is on (a menu open).
fn ghost(content: List[v.View], on: Bool, name: String, f: () -> Unit) -> v.View =
  v.row(content) |> v.gap(6.0) |> v.align(v.Middle) |> v.px(10.0) |> v.h(32.0) |> v.rounded(7.0)
    |> v.bg(if on then c(pal.raised) else snaidhm.rgba(0.0, 0.0, 0.0, 0.0))
    |> v.border(1.0, c(if on then pal.border else pal.header))
    |> v.on_click(f) |> v.role(3) |> v.label(name)

// ── Header ──
//
// The Almide mark and name, the files (wide screens), Examples, then the
// quiet controls (⋯ Share / Export, AI, theme) and Run, the one filled
// button. Phones move AI and Run to the bottom bar and the files below.

fn header(narrow: Bool) -> v.View = {
  var items: List[v.View] = [logo()]
  list.push(items, label("Almide", if narrow then 15.0 else 16.0, pal.header_text) |> v.bold())
  if not narrow then {
    list.push(items, v.empty() |> v.w(8.0))
    for i in 0..<list.len(st.tabs) { list.push(items, tab_view(i, true)) }
    list.push(items, new_file(true))
  } else ()
  if not st.embed then {
    if not narrow then list.push(items, v.empty() |> v.w(4.0)) else list.push(items, v.spacer())
    list.push(items, examples_button())
  } else ()
  if not narrow then list.push(items, v.spacer()) else ()
  if not st.embed then list.push(items, more_button()) else ()
  if not st.embed and not narrow then list.push(items, ai_button()) else ()
  list.push(items, theme_button())
  if not narrow then list.push(items, run_button(false)) else ()
  v.row(items) |> v.gap(if narrow then 6.0 else 8.0) |> v.align(v.Middle)
    |> v.h(if narrow then 50.0 else 54.0) |> v.px(if narrow then 12.0 else 18.0) |> v.bg(c(pal.header)) |> v.clip()
}

fn examples_button() -> v.View =
  ghost([label("Examples", 13.0, pal.header_text), icon("chevron", 14.0, pal.header_sub)], st.examples_open, "Examples", () => st.toggle_examples())
    |> v.key("examples-button")

fn more_button() -> v.View =
  ghost([icon("more", 18.0, pal.header_text)], st.more_open, "More", () => st.toggle_more())
    |> v.px(7.0) |> v.key("more-button")

// The one filled button: Run, or Stop while a program runs.
fn run_button(big: Bool) -> v.View = {
  let fg = pal.on_accent
  v.row([
    icon(if st.running then "stop" else "play", if big then 16.0 else 14.0, fg),
    label(if st.running then "Stop" else "Run", if big then 15.0 else 13.5, fg) |> v.bold(),
  ]) |> v.gap(6.0) |> v.align(v.Middle) |> v.justify(v.Center)
    |> v.px(if big then 18.0 else 16.0) |> v.h(if big then 46.0 else 34.0) |> v.rounded(8.0)
    |> v.bg(c(if st.running then pal.stop else pal.accent))
    |> v.shadow(6.0, 2.0, snaidhm.rgba(0.0, 0.0, 0.0, if st.is_light() then 0.12 else 0.35))
    |> v.on_click(() => st.run()) |> v.role(3) |> v.label(if st.running then "Stop" else "Run")
}

// Light / dark: a moon in light mode (go dark), a sun in dark mode (go light),
// drawn from circles (no glyph needed in the fonts).
fn theme_button() -> v.View = {
  let light = st.is_light()
  v.custom("theme", (x, y, w, h) => {
    let k = ceangal.pixel_scale()
    let cx = (x + w / 2.0) * k
    let cy = (y + h / 2.0) * k
    let fg = c(pal.header_text)
    let bgc = c(pal.header)
    if light then {
      // crescent: a disc with a disc of the header colour cut out of it
      let r = 7.0 * k
      snaidhm.fill(cx - r, cy - r, r * 2.0, r * 2.0, r, fg)
      snaidhm.fill(cx - r + 4.5 * k, cy - r - 2.5 * k, r * 2.0, r * 2.0, r, bgc)
    } else {
      let r = 4.0 * k
      snaidhm.fill(cx - r, cy - r, r * 2.0, r * 2.0, r, fg)
      for i in 0..<8 {
        let a = int.to_float(i) * 0.7854
        let px = cx + math.cos(a) * 7.5 * k
        let py = cy + math.sin(a) * 7.5 * k
        let d = 1.4 * k
        snaidhm.fill(px - d, py - d, d * 2.0, d * 2.0, d, fg)
      }
    }
  }) |> v.size(34.0, 32.0) |> v.rounded(7.0)
    |> v.on_click(() => st.toggle_theme()) |> v.role(3) |> v.label(if light then "Dark mode" else "Light mode")
}

// The AI button: the sparkle in the accent colour, filled while the panel is
// open; a dot while the assistant works with the panel closed.
fn ai_button() -> v.View = {
  let on = ai.open
  var parts: List[v.View] = [
    icon("sparkle", 15.0, if on then pal.on_accent else pal.accent_light),
    label("AI", 13.0, if on then pal.on_accent else pal.header_text) |> v.bold(),
  ]
  if ai.busy() and not on then list.push(parts, v.empty() |> v.size(6.0, 6.0) |> v.rounded(3.0) |> v.bg(c(pal.accent_light))) else ()
  v.row(parts) |> v.gap(6.0) |> v.align(v.Middle) |> v.px(12.0) |> v.h(32.0) |> v.rounded(7.0)
    |> v.bg(c(if on then pal.accent else pal.header))
    |> v.border(1.0, c(if on then pal.accent else pal.accent_light))
    |> v.on_click(() => ai.toggle()) |> v.role(3) |> v.label("AI assistant")
}

// Phones: one pane at a time; the bar flips between them, opens the AI sheet
// and runs (Run flips to the output by itself, loading an example flips
// back to the code).
fn mobile_bar() -> v.View = {
  let bar_button = (content: List[v.View], name: String, f: () -> Unit) =>
    v.row(content) |> v.gap(6.0) |> v.align(v.Middle) |> v.justify(v.Center)
      |> v.px(14.0) |> v.h(46.0) |> v.rounded(8.0)
      |> v.bg(c(pal.raised)) |> v.border(1.0, c(pal.border))
      |> v.on_click(f) |> v.role(3) |> v.label(name)
  var items: List[v.View] = []
  if not st.embed then {
    var ai_parts: List[v.View] = [icon("sparkle", 15.0, pal.accent_light), label("AI", 14.0, pal.text) |> v.bold()]
    if ai.busy() then list.push(ai_parts, v.empty() |> v.size(6.0, 6.0) |> v.rounded(3.0) |> v.bg(c(pal.accent_light))) else ()
    list.push(items, bar_button(ai_parts, "AI assistant", () => ai.toggle()))
  } else ()
  let pane = if st.mobile_output then "Code" else "Output"
  list.push(items, bar_button([label(pane, 14.0, pal.muted)], pane, () => st.toggle_mobile_output()) |> v.min_w(92.0))
  list.push(items, run_button(true) |> v.grow(1.0))
  v.row(items) |> v.gap(8.0) |> v.align(v.Middle) |> v.px(12.0) |> v.py(10.0)
    |> v.bg(c(pal.panel)) |> v.border(1.0, c(pal.border))
}

// The Almide mark (assets/brand/logo.rgba, made by tools/build_brand.py),
// shown as delivered: the brand guideline forbids recolouring the shell.
fn logo() -> v.View =
  v.custom("logo", (x, y, w, h) => {
    let k = ceangal.pixel_scale()
    let tex = st.logo_texture(not st.is_light())
    if tex != 0 then snaidhm.image(tex, x * k, y * k, w * k, h * k, 0.0, 1.0) else ()
  }) |> v.size(28.0, 28.0) |> v.role(13) |> v.label("Almide")

// ── Menus ──

// Closes whatever menu is open when the page around it is tapped.
fn menu_backdrop() -> v.View =
  v.empty() |> v.absolute() |> v.top(0.0) |> v.left(0.0) |> v.right(0.0) |> v.bottom(0.0)
    |> v.on_click(() => st.close_menus())

fn menu_item(text: String, hint: String, name: String, f: () -> Unit) -> v.View =
  v.col([
    label(text, 13.0, pal.text),
    label(hint, 11.5, pal.faint),
  ]) |> v.gap(2.0) |> v.px(14.0) |> v.py(8.0) |> v.rounded(6.0)
    |> v.on_click(() => { st.close_menus(); f() }) |> v.role(11) |> v.label(name)

fn menu_frame(body: v.View, under: String, w: Float, name: String) -> v.View = {
  let r = ceangal.rect_of(under)
  let vw = ceangal.viewport_width()
  let left = float.max(8.0, float.min(r.x + r.w - w, vw - w - 8.0))
  body |> v.w(w) |> v.py(6.0) |> v.px(4.0) |> v.bg(c(pal.raised)) |> v.rounded(10.0)
    |> v.border(1.0, c(pal.border)) |> v.shadow(22.0, 8.0, snaidhm.rgba(0.0, 0.0, 0.0, 0.4))
    |> v.absolute() |> v.top(r.y + r.h + 6.0) |> v.left(if under == "examples-button" then float.max(8.0, float.min(r.x, vw - w - 8.0)) else left)
    |> v.role(6) |> v.label(name) |> v.clip()
}

fn more_menu() -> v.View =
  menu_frame(v.col([
    menu_item("Share link", "Copy a URL with every file", "Share", () => st.share()),
    menu_item("Export project", "Download a .zip that builds with the CLI", "Export", () => st.export_zip()),
  ]), "more-button", 250.0, "More menu")

// ── AI panel ──
//
// One place for the assistant: the request, what it did (written, errors,
// fixes with their diffs, the run), and the box for the next request — a
// follow-up changes the program on screen. The key, provider and model live
// on a card that shows until a key is set, then behind ⚙. Wide screens put
// the panel beside the editor; phones show it as a sheet from the bottom.

fn chip(s: String, on: Bool, f: () -> Unit) -> v.View =
  label(s, 12.0, if on then pal.on_accent else pal.muted)
    |> v.px(10.0) |> v.py(5.0) |> v.rounded(12.0)
    |> v.bg(if on then c(pal.accent) else c(pal.panel))
    |> v.border(1.0, c(if on then pal.accent else pal.border))
    |> v.on_click(f) |> v.role(3) |> v.label(s)

fn provider_chip(i: Int) -> v.View = chip(ai.PROVIDERS[i], ai.provider == i, () => ai.select_provider(i))

fn model_chip(i: Int, m: ai.Model) -> v.View = chip(m.label, ai.model_ix == i, () => ai.select_model(i))

fn icon_button(name: String, rgb: Int, a11y: String, f: () -> Unit) -> v.View =
  icon(name, 16.0, rgb) |> v.size(30.0, 30.0) |> v.rounded(6.0) |> v.center()
    |> v.on_click(f) |> v.role(3) |> v.label(a11y)

fn settings_card(width: Float) -> v.View = {
  var providers: List[v.View] = []
  for i in 0..<3 { list.push(providers, provider_chip(i)) }
  var ms: List[v.View] = []
  let models = ai.models(ai.provider)
  for i in 0..<list.len(models) { list.push(ms, model_chip(i, models[i])) }
  let key = ed.field("ai-key", () => ai.key_field, (e) => ai.set_key_field(e), code_theme())
    |> v.h(34.0) |> v.w(width) |> v.rounded(6.0) |> v.border(1.0, c(pal.border)) |> v.clip() |> v.label("API key")
  var parts: List[v.View] = [
    label("Provider", 11.5, pal.faint) |> v.bold(),
    v.wrap_row(providers) |> v.gap(6.0),
    label("Model", 11.5, pal.faint) |> v.bold(),
    v.wrap_row(ms) |> v.gap(6.0),
    label("Your key", 11.5, pal.faint) |> v.bold(),
    key,
    para("Kept in this device's keychain. Requests go straight to " + ai.PROVIDERS[ai.provider] + "; nothing passes through Almide.", 11.5, pal.faint, width - 24.0),
  ]
  if ai.has_key() then list.push(parts, button("Done", true, () => ai.toggle_settings()) |> v.align_self(v.Bottom)) else ()
  v.col(parts) |> v.gap(7.0) |> v.padding(12.0) |> v.bg(c(pal.panel)) |> v.rounded(10.0)
    |> v.border(1.0, c(pal.border)) |> v.role(2) |> v.label("AI key and model")
}

fn entry_view(i: Int, e: ai.Entry, width: Float) -> v.View =
  if e.kind == 0 then {
    // the request, what it worked on, and Undo (the files as before it)
    var meta: List[v.View] = [label(e.detail, 11.0, pal.faint) |> v.shrink(1.0)]
    if not ai.busy() and list.len(e.files) > 0 then
      list.push(meta, label("Undo", 11.0, pal.accent_light) |> v.bold() |> v.on_click(() => ai.undo(i)) |> v.role(3) |> v.label("Undo " + e.text))
    else ()
    v.col([
      para(e.text, 13.0, pal.text, width * 0.8 - 52.0),
      v.row(meta) |> v.gap(10.0) |> v.align(v.Middle),
    ]) |> v.gap(5.0) |> v.px(12.0) |> v.py(8.0) |> v.rounded(10.0) |> v.bg(c(pal.raised)) |> v.align_self(v.Bottom)
  }
  else {
    let colour = if e.kind == 2 then pal.accent_light else if e.kind == 3 then pal.stop else if e.kind == 5 then pal.warn else pal.muted
    let mark = if e.kind == 1 then "…" else if e.kind == 2 then "✓" else if e.kind == 3 then "✕" else if e.kind == 4 then "↻" else "!"
    let open = ai.is_expanded(i)
    var parts: List[v.View] = [
      v.row([
        label(mark, 13.0, colour) |> v.w(14.0),
        para(e.text, 12.5, if e.kind == 3 then pal.text else pal.muted, width - 120.0) |> v.shrink(1.0) |> v.grow(1.0),
        v.spacer(),
        if e.detail != "" then label(if open then "Hide" else "Details", 11.5, pal.faint) else v.empty(),
      ]) |> v.gap(8.0) |> v.align(v.Middle),
    ]
    if open and e.detail != "" then {
      var lines: List[v.View] = []
      for l in string.split(e.detail, "\n") {
        let col = if string.starts_with(l, "+ ") then pal.accent_light else if string.starts_with(l, "- ") then pal.stop else pal.muted
        list.push(lines, label(l, 11.5, col) |> v.mono())
      }
      list.push(parts, v.col(lines) |> v.gap(1.0) |> v.padding(8.0) |> v.bg(c(pal.panel)) |> v.rounded(6.0) |> v.clip())
    } else ()
    var row = v.col(parts) |> v.gap(6.0) |> v.px(4.0) |> v.py(2.0)
    if e.detail != "" then row = row |> v.on_click(() => ai.toggle_entry(i)) |> v.role(3) else ()
    row |> v.label(e.text)
  }

fn conversation(width: Float) -> v.View = {
  var items: List[v.View] = []
  if list.len(ai.entries) == 0 then {
    list.push(items, para("Ask for a new program or a change to this one. The assistant sees every file, runs what it writes and fixes what fails; each request can be undone.", 13.0, pal.muted, width - 28.0))
    let tries = ["A maze generator that prints the maze", "Fireworks drawn as an SVG", "FizzBuzz with pattern matching"]
    for t in tries {
      list.push(items, label(t, 12.5, pal.text) |> v.px(12.0) |> v.py(8.0) |> v.rounded(8.0)
        |> v.border(1.0, c(pal.border)) |> v.on_click(() => ai.suggest(t)) |> v.role(3) |> v.label(t))
    }
  } else {
    for i in 0..<list.len(ai.entries) { list.push(items, entry_view(i, ai.entries[i], width)) }
  }
  v.col(items) |> v.gap(10.0) |> v.px(14.0) |> v.py(12.0) |> v.scroll_y("ai-log") |> v.grow(1.0) |> v.clip()
    |> v.role(2) |> v.label("AI conversation")
}

// New program / edit: what the next request does, and what it sees.
fn mode_switch() -> v.View = {
  let fresh = ai.writes_new()
  let seg = (text: String, on: Bool, f: () -> Unit) =>
    label(text, 12.0, if on then pal.text else pal.faint)
      |> v.px(10.0) |> v.h(26.0) |> v.center() |> v.rounded(6.0)
      |> v.bg(if on then c(pal.bg) else snaidhm.rgba(0.0, 0.0, 0.0, 0.0))
      |> v.border(1.0, c(if on then pal.border else pal.panel))
      |> v.on_click(f) |> v.role(3) |> v.label(text)
  v.row([
    seg("Edit project", not fresh, () => ai.set_mode(false)),
    seg("New program", fresh, () => ai.set_mode(true)),
  ]) |> v.gap(2.0) |> v.padding(2.0) |> v.rounded(8.0) |> v.bg(c(pal.raised)) |> v.role(2) |> v.label("AI mode")
}

fn prompt_box(width: Float) -> v.View = {
  let busy = ai.busy()
  let field = ed.field("ai-prompt", () => { ...ai.prompt_field, placeholder: ai.placeholder() }, (e) => ai.set_prompt_field(e), code_theme())
    |> v.h(38.0) |> v.grow(1.0) |> v.rounded(8.0) |> v.clip() |> v.label("Prompt")
    |> v.on_key((phase, code, mods) => if phase != 1 and code == 1 then { ai.generate(); true } else false)
  let send =
    icon(if busy then "stop" else "send", 16.0, pal.on_accent) |> v.size(38.0, 38.0) |> v.rounded(8.0) |> v.center()
      |> v.bg(c(if busy then pal.stop else pal.accent))
      |> v.on_click(() => ai.generate()) |> v.role(3) |> v.label(if busy then "Stop AI" else "Generate")
  v.col([
    mode_switch(),
    v.row([field, send]) |> v.gap(8.0) |> v.align(v.Middle),
    para(ai.scope(), 11.0, pal.faint, width - 24.0),
  ]) |> v.gap(8.0) |> v.padding(10.0) |> v.border(1.0, c(pal.border)) |> v.bg(c(pal.panel))
}

fn ai_panel(narrow: Bool, width: Float) -> v.View = {
  let head = v.row([
    icon("sparkle", 16.0, pal.accent_light),
    label("AI", 14.0, pal.text) |> v.bold(),
    v.spacer(),
    label(ai.model_label(), 12.0, pal.faint) |> v.px(6.0) |> v.on_click(() => ai.toggle_settings()) |> v.role(3) |> v.label("Model " + ai.model_label()),
    icon_button("gear", pal.muted, "AI settings", () => ai.toggle_settings()),
    v.row([icon("new", 13.0, pal.muted), label("New session", 12.0, pal.muted)]) |> v.gap(4.0) |> v.align(v.Middle)
      |> v.px(8.0) |> v.h(30.0) |> v.rounded(6.0) |> v.on_click(() => ai.new_chat()) |> v.role(3) |> v.label("New session"),
    icon_button("close", pal.muted, "Close AI", () => ai.close()),
  ]) |> v.gap(4.0) |> v.align(v.Middle) |> v.px(12.0) |> v.h(44.0) |> v.border(1.0, c(pal.border))
  var parts: List[v.View] = [head]
  if ai.show_settings() then list.push(parts, settings_card(width - 48.0) |> v.margin(12.0)) else ()
  list.push(parts, conversation(width))
  if ai.has_key() then list.push(parts, prompt_box(width)) else ()
  let panel = v.col(parts) |> v.bg(c(pal.bg)) |> v.role(2) |> v.label("AI panel")
  if narrow then
    panel |> v.rounded(14.0) |> v.border(1.0, c(pal.border)) |> v.clip()
      |> v.shadow(50.0, 18.0, snaidhm.rgba(0.0, 0.0, 0.0, 0.55))
      |> v.absolute() |> v.left(8.0) |> v.right(8.0) |> v.bottom(8.0) |> v.h(ceangal.viewport_height() * 0.78)
  else panel |> v.w(width) |> v.grow(0.0) |> v.clip()
}

// Dims the playground behind the phone AI sheet; a tap closes the sheet.
fn backdrop() -> v.View =
  v.empty() |> v.absolute() |> v.top(0.0) |> v.left(0.0) |> v.right(0.0) |> v.bottom(0.0)
    |> v.bg(snaidhm.rgba(0.02, 0.04, 0.063, 0.6)) |> v.on_click(() => ai.close())

// ── File tabs ──

fn tab_view(i: Int, in_header: Bool) -> v.View = {
  let t = st.tabs[i]
  let on = i == st.active
  let errs = list.len(list.filter(t.ed.diags, (d) => d.severity == 0))
  if st.renaming == i then
    ed.field("rename", () => st.rename_field, (e) => st.set_rename_field(e), code_theme())
      |> v.size(150.0, 28.0) |> v.rounded(5.0) |> v.clip()
      |> v.on_key((phase, code, mods) => {
        if phase != 1 and code == 1 then { st.commit_rename(); true }
        else if phase != 1 and code == 5 then { st.cancel_rename(); true }
        else false
      })
  else {
    let fg = if in_header then (if on then pal.header_text else pal.header_sub) else (if on then pal.text else pal.muted)
    var parts: List[v.View] = [label(t.name, 13.0, fg)]
    if errs > 0 then list.push(parts, v.empty() |> v.size(6.0, 6.0) |> v.rounded(3.0) |> v.bg(c(pal.stop))) else ()
    if list.len(st.tabs) > 1 and t.name != st.ENTRY then
      list.push(parts, label("×", 13.0, pal.faint) |> v.px(3.0) |> v.on_click(() => st.close_tab(i)) |> v.label("Close " + t.name))
    else ()
    let base = v.row(parts) |> v.gap(6.0) |> v.align(v.Middle) |> v.px(12.0)
    let styled =
      if in_header then base |> v.h(32.0) |> v.rounded(7.0) |> v.bg(if on then c(pal.raised) else snaidhm.rgba(0.0, 0.0, 0.0, 0.0))
      else base |> v.h(34.0) |> v.bg(if on then c(pal.bg) else c(pal.panel))
    styled |> v.on_click(() => st.select_tab(i)) |> v.role(8) |> v.label(t.name)
  }
}

fn new_file(in_header: Bool) -> v.View =
  label("+", 16.0, if in_header then pal.header_sub else pal.muted) |> v.px(10.0) |> v.h(if in_header then 32.0 else 34.0) |> v.center()
    |> v.rounded(7.0) |> v.on_click(() => st.add_tab()) |> v.role(3) |> v.label("New file")

fn tab_bar() -> v.View = {
  var items: List[v.View] = []
  for i in 0..<list.len(st.tabs) { list.push(items, tab_view(i, false)) }
  list.push(items, new_file(false))
  v.row(items) |> v.h(34.0) |> v.bg(c(pal.panel)) |> v.clip() |> v.role(9)
}

// ── Editor + problems ──

fn editor_pane() -> v.View = {
  var parts: List[v.View] = [
    ed.view("editor", () => st.current(), (e) => st.set_current(e), code_theme()) |> v.grow(1.0) |> v.label("Code editor"),
  ]
  if st.problems > 0 then
    list.push(parts, v.row([
      label("●", 11.0, pal.stop),
      label(st.problem_text, 12.0, pal.text) |> v.shrink(1.0),
      v.spacer(),
      label(if st.problems == 1 then "1 problem" else int.to_string(st.problems) + " problems", 12.0, pal.muted),
    ]) |> v.gap(8.0) |> v.align(v.Middle) |> v.h(28.0) |> v.px(12.0) |> v.bg(c(pal.panel)) |> v.clip())
  else ()
  v.col(parts) |> v.grow(1.0) |> v.clip()
}

// ── Output panel ──

fn out_tab(i: Int, name: String) -> v.View = {
  let on = st.out_tab == i
  label(name, 12.0, if on then pal.text else pal.muted)
    |> v.px(12.0) |> v.h(32.0) |> v.center()
    |> v.bg(if on then c(pal.bg) else c(pal.panel))
    |> v.on_click(() => {
      if i == 2 then st.show_rust() else if i == 3 then st.show_ast() else st.set_out_tab(i)
    }) |> v.role(8) |> v.label(name)
}

// The running GUI program's window: the page puts the program's own canvas
// exactly over this rect.
// The running GUI program's window. Web: the page lays the program's own
// canvas over this rect. Native: the program renders offscreen and we draw
// its texture here, forwarding input (pointer coordinates are already
// relative to the view) and its IME caret.
fn gui_view() -> v.View =
  v.custom("gui", (x, y, w, h) => {
    let k = ceangal.pixel_scale()
    snaidhm.fill(x * k, y * k, w * k, h * k, 0.0, c(pal.panel))
    let tex = st.gui_place(x, y, w, h)
    if tex != 0 then snaidhm.image(tex, x * k, y * k, w * k, h * k, 0.0, 1.0) else ()
    let cx = st.gui_ime(0)
    if cx >= 0.0 and ceangal.is_focused("gui") then ceangal.set_caret(x + cx, y + st.gui_ime(1), st.gui_ime(2), st.gui_ime(3)) else ()
  })
    |> v.grow(1.0) |> v.role(13) |> v.label("Program window")
    |> v.text_input("gui")
    |> v.on_pointer((p) => { if p.phase == 0 then ceangal.focus("gui") else (); st.gui_event(4, p.phase, p.id, p.x, p.y, int.to_float(p.buttons), int.to_float(p.mods)) })
    |> v.on_wheel((x, y, dx, dy) => st.gui_event(5, 0, 1, x, y, dx, dy))
    |> v.on_key((phase, code, mods) => st.gui_event(6, phase, code, int.to_float(mods), 0.0, 0.0, 0.0))
    |> v.on_text((kind, s, cur) => st.gui_text(kind, s, cur))

fn picture_view() -> v.View = {
  let p = st.picture
  if st.gui_running then gui_view()
  else if p.kind == visual.Html then v.col([html.render(p.text, c(pal.text))]) |> v.grow(1.0) |> v.clip()
  else if p.kind == visual.NoVisual then
    label("Print an SVG document, a PPM image or simple HTML to see it here.", 13.0, pal.faint) |> v.padding(16.0)
  else v.custom("picture", (x, y, w, h) => {
    let tex = st.picture_texture()
    let k = ceangal.pixel_scale()
    let pw = int.to_float(p.w)
    let ph = int.to_float(p.h)
    let s = float.min((w - 24.0) / pw, (h - 24.0) / ph)
    let dw = pw * s
    let dh = ph * s
    let dx = x + (w - dw) * 0.5
    let dy = y + (h - dh) * 0.5
    snaidhm.image(tex, dx * k, dy * k, dw * k, dh * k, 4.0 * k, 1.0)
  }) |> v.grow(1.0) |> v.role(13) |> v.label("Visual output")
}

fn output_pane() -> v.View = {
  let body =
    if st.out_tab == 0 then ed.view("output", () => st.out, (e) => st.set_out(e), code_theme()) |> v.grow(1.0) |> v.label("Program output")
    else if st.out_tab == 1 then picture_view()
    else if st.out_tab == 2 then ed.view("rust", () => st.rust_view, (e) => st.set_rust_view(e), code_theme()) |> v.grow(1.0) |> v.label("Generated Rust")
    else ed.view("ast", () => st.ast_view, (e) => st.set_ast_view(e), code_theme()) |> v.grow(1.0) |> v.label("Syntax tree")
  var tabs: List[v.View] = [out_tab(0, "Output"), out_tab(1, "Visual")]
  if not list.contains(st.hidden, "rust") then list.push(tabs, out_tab(2, "Rust")) else ()
  if not list.contains(st.hidden, "ast") then list.push(tabs, out_tab(3, "AST")) else ()
  v.col([
    v.row(tabs) |> v.h(32.0) |> v.bg(c(pal.panel)),
    body,
  ]) |> v.grow(1.0) |> v.clip() |> v.bg(c(pal.bg))
}

// ── Status bar ──

fn status_bar(narrow: Bool) -> v.View = {
  // narrow screens keep the status and drop the version string
  var right = if narrow then "" else st.version_text
  if st.compile_ms >= 0 then right = "compiled in " + int.to_string(st.compile_ms) + " ms" + (if right == "" then "" else " · " + right) else ()
  v.row([
    label(st.status, 12.0, pal.muted) |> v.shrink(1.0),
    fix_button(),
    v.spacer(),
    label(right, 12.0, pal.faint),
  ]) |> v.gap(8.0) |> v.align(v.Middle) |> v.h(26.0) |> v.px(12.0) |> v.bg(c(pal.panel)) |> v.clip()
}

// After a failed run, offer the AI repair loop (it asks for a key first
// when there is none).
fn can_fix() -> Bool = not st.embed and not st.running and not st.last_run_ok and st.last_run_error != "" and not ai.busy()

fn fix_button() -> v.View =
  if can_fix() then
    v.row([icon("sparkle", 12.0, pal.on_accent), label("Fix with AI", 12.0, pal.on_accent) |> v.bold()])
      |> v.gap(5.0) |> v.align(v.Middle) |> v.px(10.0) |> v.h(22.0) |> v.rounded(11.0) |> v.bg(c(pal.accent))
      |> v.on_click(() => ai.fix_last_run()) |> v.role(3) |> v.label("Fix with AI")
  else v.empty()

// ── Examples menu ──

fn examples_menu(narrow: Bool) -> v.View = {
  var rows: List[v.View] = []
  for cat in st.categories {
    list.push(rows, label(cat.title, 11.0, pal.faint) |> v.bold() |> v.pad(10.0, 12.0, 4.0, 12.0))
    for e in cat.examples {
      let id = e.id
      list.push(rows, label(e.title, 13.0, pal.text) |> v.px(if narrow then 16.0 else 12.0) |> v.py(if narrow then 12.0 else 6.0) |> v.rounded(4.0)
        |> v.on_click(() => { let _ = st.load_example(id) }) |> v.role(11) |> v.label(e.title))
    }
  }
  // at most 70% of the screen tall, scrolling (wheel / finger) beyond that
  v.col(rows) |> v.scroll_y("examples-menu") |> v.max_h(ceangal.viewport_height() * 0.7)
    |> v.w(260.0) |> v.py(6.0) |> v.bg(c(pal.raised)) |> v.rounded(8.0) |> v.role(6) |> v.label("Examples menu")
    |> v.border(1.0, c(pal.border)) |> v.shadow(22.0, 8.0, snaidhm.rgba(0.0, 0.0, 0.0, 0.4))
    |> v.absolute() |> v.top(ceangal.rect_of("examples-button").y + ceangal.rect_of("examples-button").h + 6.0)
    |> v.left(float.max(8.0, float.min(ceangal.rect_of("examples-button").x, ceangal.viewport_width() - 268.0))) |> v.clip()
}

// ── Root ──

pub fn root() -> v.View = {
  let light = st.is_light()
  pal = if light then light_pal() else dark_pal()
  ceangal.set_background(c(pal.bg))
  let vw = ceangal.viewport_width()
  let narrow = vw < 760.0
  st.set_code_layout(if narrow then 15.0 else 13.0, narrow)
  let ai_shown = ai.open and not st.embed
  // Wide enough: editor, output and the AI panel side by side; otherwise the
  // panel takes the output's place while it is open.
  let ai_w = if vw >= 1180.0 then 380.0 else float.max(320.0, vw * 0.42)
  let ai_beside = ai_shown and not narrow and vw >= 1180.0
  let ai_instead = ai_shown and not narrow and not ai_beside
  // Hide the program window unless the Visual pane is on screen (it is
  // placed again when gui_view paints).
  let gui_shown = st.gui_running and st.out_tab == 1 and (not narrow or st.mobile_output) and not st.examples_open and not ai_instead and not (narrow and ai_shown)
  if st.gui_running and not gui_shown then { let _ = st.gui_place(0.0, 0.0, 0.0, 0.0); () } else ()
  let rule = v.empty() |> v.w(1.0) |> v.bg(c(pal.border))
  let body =
    if narrow then (if st.mobile_output then output_pane() else editor_pane())
    else {
      var cols: List[v.View] = [editor_pane(), rule]
      if ai_instead then list.push(cols, ai_panel(false, ai_w))
      else {
        list.push(cols, output_pane() |> v.w(float.max(320.0, (vw - (if ai_beside then ai_w else 0.0)) * 0.42)) |> v.grow(0.0))
        if ai_beside then { list.push(cols, rule); list.push(cols, ai_panel(false, ai_w)) } else ()
      }
      v.row(cols) |> v.grow(1.0)
    }
  let header_shown = not (st.embed and list.contains(st.hidden, "header"))
  var parts: List[v.View] = []
  if header_shown then {
    list.push(parts, header(narrow))
    list.push(parts, v.empty() |> v.h(1.0) |> v.bg(c(pal.header_line)))
  } else ()
  // wide screens carry the files in the header
  if narrow or not header_shown then list.push(parts, tab_bar()) else ()
  list.push(parts, body |> v.grow(1.0))
  // phones: the status line gives way to the action bar
  list.push(parts, if narrow then mobile_bar() else status_bar(narrow))
  if st.examples_open or st.more_open then list.push(parts, menu_backdrop()) else ()
  if st.examples_open then list.push(parts, examples_menu(narrow)) else ()
  if st.more_open then list.push(parts, more_menu()) else ()
  if ai_shown and narrow then {
    list.push(parts, backdrop())
    list.push(parts, ai_panel(true, vw - 16.0))
  } else ()
  v.col(parts) |> v.bg(c(pal.bg))
}
