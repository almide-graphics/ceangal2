// Playground views. Everything is ceangal: header, file tabs, the editor,
// the output / visual / Rust / AST panel, examples menu and status bar.

import ceangal
import ceangal.view as v
import ceangal.editor as ed
import ceangal.text as text
import snaidhm
import math
import self.state as st
import self.visual as visual
import self.html as html
import self.ai as ai
import self.icons as icons

// ── Theme ── the Almide v2 palettes: dark from almide/playground's CSS
// variables, light from almide/docs' light theme (Shell 05 on white).

type Pal = {
  bg: Int, panel: Int, raised: Int, subtle: Int, border: Int,
  text: Int, muted: Int, faint: Int,
  accent: Int, accent_light: Int, on_accent: Int, stop: Int, warn: Int,
  button: Int, button_border: Int, button_text: Int,
  header: Int, header_text: Int, header_sub: Int, header_line: Int,
}

fn dark_pal() -> Pal = {
  bg: 0x0B1420, panel: 0x101B29, raised: 0x152233, subtle: 0x1A2A3D, border: 0x22344A,
  text: 0xF4F7F8, muted: 0xA3B3C2, faint: 0x6B7F93,
  accent: 0x0E7E86, accent_light: 0x14A2A2, on_accent: 0xFFFFFF, stop: 0xD94F5E, warn: 0xE0B060,
  button: 0x1F3A5F, button_border: 0x2B4F7A, button_text: 0xE8EEF3,
  header: 0x13202F, header_text: 0xF4F7F8, header_sub: 0xA3B3C2, header_line: 0x22344A,
}

fn light_pal() -> Pal = {
  bg: 0xFFFFFF, panel: 0xF7FAFA, raised: 0xEEF3F4, subtle: 0xD8E4E6, border: 0xD8E4E6,
  text: 0x2B2B2B, muted: 0x3A4B5E, faint: 0x5A6B7D,
  accent: 0x096578, accent_light: 0x0E7E86, on_accent: 0xFFFFFF, stop: 0xC43C4B, warn: 0x9A6A00,
  button: 0x1F3A5F, button_border: 0x2B4F7A, button_text: 0xE8EEF3,
  header: 0xFFFFFF, header_text: 0x2B2B2B, header_sub: 0x5A6B7D, header_line: 0xD8E4E6,
}

// The palette of the frame being built (root picks it).
var pal = dark_pal()

