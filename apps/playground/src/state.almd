// Playground state and actions: tabs, running, checking, output, examples,
// persistence and share links. Views (ui.almd) read these vars and call the
// actions; results from the compiler service arrive in `on_result`.

import ceangal
import snaidhm
import ceangal.editor as ed
import ceangal.host.sys as sys
import ceangal.host.storage as storage
import json
import zlib
import base64
import self.host.runner as runner
import self.visual as visual
import self.deflate as deflate
import self.zip as zip
import ceangal.host.file as file

let ENTRY = "main.almd"
let STORAGE_KEY = "files-v2"
let CHECK_DEBOUNCE_MS = 500.0
let MAX_OUTPUT_LINES = 5000
let WEB_URL = "https://almide-graphics.github.io/ceangal2/"

type Tab = { name: String, ed: ed.Editor }

// ── State ──

var tabs: List[Tab] = []
var active = 0
var out = ed.log()
var out_tab = 0          // 0 output, 1 visual, 2 rust, 3 ast, 4 ai
var rust_view = ed.with_read_only(ed.from_string(""), true)
var ast_view = ed.with_syntax(ed.with_read_only(ed.from_string(""), true), false)
var running = false
var run_id = -1
var check_id = -1
var rust_id = -1
var ast_id = -1
var check_due = -1.0
var checked_version = -1
var saved_version = -1
var stdout_text: List[String] = []
var picture = visual.empty()
var picture_tex = 0
var status = "Ready"
var version_text = ""
var compile_ms = -1
var run_ms = -1
var problems = 0
var problem_text = ""
var examples_open = false
var mobile_output = false
var renaming = -1
var rename_field = ed.text_field("", "name.almd")
var last_tab_click = 0.0
var last_tab_index = -1
var base_url = WEB_URL
var embed = false
var hidden: List[String] = []
// The last finished run, for the AI repair loop (ai.almd polls `runs_finished`).
var runs_finished = 0
var last_run_ok = false
var last_run_error = ""
var stderr_text: List[String] = []

// ── Tabs ──

fn editor_for(name: String, text: String) -> ed.Editor =
  ed.with_syntax(ed.from_string(text), string.ends_with(name, ".almd"))

pub fn set_files(files: List[(String, String)]) -> Unit = {
  var ts: List[Tab] = []
  for (name, text) in files { list.push(ts, { name: name, ed: editor_for(name, text) }) }
  if list.len(ts) == 0 then list.push(ts, { name: ENTRY, ed: editor_for(ENTRY, "") }) else ()
  // the entry file first
  var ordered: List[Tab] = []
  for t in ts { if t.name == ENTRY then list.push(ordered, t) else () }
  for t in ts { if t.name != ENTRY then list.push(ordered, t) else () }
  tabs = ordered
  active = 0
  check_due = 0.0
  ceangal.focus("editor")
}

pub fn files() -> List[(String, String)] = {
  var out_files: List[(String, String)] = []
  for t in tabs { list.push(out_files, (t.name, ed.to_string(t.ed))) }
  out_files
}

pub fn files_json() -> String = {
  var pairs: List[(String, Value)] = []
  for (n, t) in files() { list.push(pairs, (n, value.str(t))) }
  value.stringify(value.object(pairs))
}

pub fn current() -> ed.Editor = tabs[active].ed

pub fn set_current(e: ed.Editor) -> Unit = {
  tabs[active] = { ...tabs[active], ed: e }
}

fn total_version() -> Int = {
  var v = 0
  for t in tabs { v = v + t.ed.version }
  v + list.len(tabs) * 1000000
}

pub fn select_tab(i: Int) -> Unit = {
  let now = sys.now_ms()
  // a second click on the active tab within 400 ms renames it
  if i == active and last_tab_index == i and now - last_tab_click < 400.0 and tabs[i].name != ENTRY then begin_rename(i) else ()
  last_tab_click = now
  last_tab_index = i
  if i >= 0 and i < list.len(tabs) then { active = i; ceangal.focus("editor") } else ()
}

fn free_name(base: String, ext: String) -> String = {
  var n = 1
  var name = base + ext
  var taken = true
  while taken {
    taken = false
    for t in tabs { if t.name == name then taken = true else () }
    if taken then { n = n + 1; name = base + int.to_string(n) + ext } else ()
  }
  name
}

pub fn add_tab() -> Unit = {
  let name = free_name("module", ".almd")
  list.push(tabs, { name: name, ed: editor_for(name, "") })
  active = list.len(tabs) - 1
  begin_rename(active)
}

pub fn close_tab(i: Int) -> Unit =
  if list.len(tabs) > 1 and tabs[i].name != ENTRY then {
    tabs = list.take(tabs, i) + list.drop(tabs, i + 1)
    if active >= list.len(tabs) then active = list.len(tabs) - 1 else ()
    if active > i then active = active - 1 else ()
    check_due = 0.0
  } else ()

pub fn begin_rename(i: Int) -> Unit = {
  renaming = i
  rename_field = ed.select_all(ed.text_field(tabs[i].name, "name.almd"))
  ceangal.focus("rename")
}

fn valid_name(n: String) -> Bool =
  string.len(n) > 0 and string.len(n) <= 64 and not string.contains(n, "/") and not string.contains(n, " ") and not string.starts_with(n, ".")

pub fn commit_rename() -> Unit = {
  if renaming >= 0 and renaming < list.len(tabs) then {
    let n = string.trim(ed.to_string(rename_field))
    var clash = false
    for i in 0..<list.len(tabs) { if i != renaming and tabs[i].name == n then clash = true else () }
    if valid_name(n) and not clash and tabs[renaming].name != ENTRY then {
      let t = tabs[renaming]
      tabs[renaming] = { name: n, ed: ed.with_syntax(t.ed, string.ends_with(n, ".almd")) }
      check_due = 0.0
    } else if not valid_name(n) or clash then status = "Invalid tab name: " + n
    else ()
  } else ()
  renaming = -1
  ceangal.focus("editor")
}

pub fn cancel_rename() -> Unit = { renaming = -1; ceangal.focus("editor") }

// ── Output ──

fn append_out(line: String, style: Int) -> Unit = {
  if ed.line_count(out) < MAX_OUTPUT_LINES then out = ed.append_line(out, line, style)
  else if ed.line_count(out) == MAX_OUTPUT_LINES then out = ed.append_line(out, "… output truncated at 5000 lines", 2)
  else ()
}

fn clear_output() -> Unit = {
  out = ed.clear(out)
  stdout_text = []
  stderr_text = []
  if picture_tex != 0 then { snaidhm.release_image(picture_tex); picture_tex = 0 } else ()
  picture = visual.empty()
}

// ── Run / check ──

pub fn run() -> Unit = {
  if running then stop() else {
    clear_output()
    let fj = bytes.from_string(files_json())
    let en = bytes.from_string(ENTRY)
    run_id = runner.runner_run(bytes.data_ptr(fj), bytes.len(fj), bytes.data_ptr(en), bytes.len(en))
    running = true
    compile_ms = -1
    run_ms = -1
    status = "Compiling…"
    if out_tab != 0 and out_tab != 1 then out_tab = 0 else ()
    if mobile_output == false then mobile_output = true else ()
    save()
  }
}

pub fn stop() -> Unit =
  if running then {
    runner.runner_stop(run_id)
    running = false
    append_out("■ stopped", 2)
    status = "Stopped"
  } else ()

fn start_check() -> Unit = {
  let fj = bytes.from_string(files_json())
  let en = bytes.from_string(ENTRY)
  check_id = runner.runner_check(bytes.data_ptr(fj), bytes.len(fj), bytes.data_ptr(en), bytes.len(en))
  checked_version = total_version()
}

pub fn show_rust() -> Unit = {
  out_tab = 2
  let fj = bytes.from_string(files_json())
  let en = bytes.from_string(ENTRY)
  rust_id = runner.runner_rust(bytes.data_ptr(fj), bytes.len(fj), bytes.data_ptr(en), bytes.len(en))
  rust_view = ed.set_text(rust_view, "// compiling…")
}

pub fn show_ast() -> Unit = {
  out_tab = 3
  let src = bytes.from_string(ed.to_string(current()))
  ast_id = runner.runner_ast(bytes.data_ptr(src), bytes.len(src))
  ast_view = ed.set_text(ast_view, "// parsing…")
}

// Per frame: debounce checks after edits, save, refresh the version text.
pub fn tick(now: Float) -> Bool = {
  let v = total_version()
  if v != checked_version and check_due < 0.0 then {
    check_due = now + CHECK_DEBOUNCE_MS
    sys.request_frame_after(CHECK_DEBOUNCE_MS)
  } else ()
  if check_due >= 0.0 and now >= check_due then {
    check_due = -1.0
    start_check()
    save()
  } else if check_due >= 0.0 then sys.request_frame_after(check_due - now) else ()
  if version_text == "" then {
    let n = runner.runner_version_len()
    if n > 0 then {
      var b = bytes.new(n)
      let _ = runner.runner_version_read(bytes.data_ptr(b), n)
      version_text = bytes.to_string_lossy(b)
    } else sys.request_frame_after(250.0)
  } else ()
  false
}

fn field_int(body: String, key: String) -> Int = match json.parse(body) {
  ok(v) => json.get_int(v, key) ?? -1,
  err(_) => -1,
}

fn field_float(body: String, key: String) -> Float = match json.parse(body) {
  ok(v) => json.get_float(v, key) ?? -1.0,
  err(_) => -1.0,
}

fn field_str(body: String, key: String) -> String = match json.parse(body) {
  ok(v) => json.get_string(v, key) ?? "",
  err(_) => body,
}

fn apply_diagnostics(body: String) -> Unit = {
  let arr = match json.parse(body) { ok(v) => (value.as_array(v) ?? []), err(_) => [] }
  var per_tab: List[List[ed.Diag]] = list.repeat([], list.len(tabs))
  var count = 0
  var first = ""
  for d in arr {
    let file = json.get_string(d, "file") ?? ENTRY
    let line = (json.get_int(d, "line") ?? 1) - 1
    let col = (json.get_int(d, "col") ?? 1) - 1
    let end_col = (json.get_int(d, "endCol") ?? (col + 2)) - 1
    let level = json.get_string(d, "level") ?? "error"
    let msg = json.get_string(d, "message") ?? ""
    let sev = if level == "error" then 0 else if level == "warning" then 1 else 2
    for i in 0..<list.len(tabs) {
      if tabs[i].name == file then {
        per_tab[i] = per_tab[i] + [{ line: int.max(0, line), col: int.max(0, col), end_line: int.max(0, line), end_col: int.max(col + 1, end_col), severity: sev, message: msg }]
      } else ()
    }
    if sev == 0 then {
      count = count + 1
      if first == "" then first = file + ":" + int.to_string(line + 1) + ":" + int.to_string(col + 1) + "  " + msg else ()
    } else ()
  }
  for i in 0..<list.len(tabs) { tabs[i] = { ...tabs[i], ed: ed.with_diagnostics(tabs[i].ed, per_tab[i]) } }
  problems = count
  problem_text = first
}

fn finish_run(ok_run: Bool, body: String) -> Unit = {
  running = false
  runs_finished = runs_finished + 1
  if ok_run then {
    let code = field_int(body, "exitCode")
    run_ms = float.to_int(field_float(body, "runMs"))
    compile_ms = float.to_int(field_float(body, "compileMs"))
    if code == 0 then status = "Exited 0" else { status = "Exited " + int.to_string(code); append_out("exit " + int.to_string(code), 1) }
    last_run_ok = code == 0
    last_run_error = if code == 0 then "" else string.join(stderr_text, "\n") + "\nexit code " + int.to_string(code)
    picture = visual.detect(string.join(stdout_text, "\n"))
    if picture.kind != visual.NoVisual then out_tab = 1 else ()
  } else {
    let phase = field_str(body, "phase")
    let err_text = field_str(body, "error")
    last_run_ok = false
    last_run_error = (if phase == "runtime" then "Runtime error:\n" else "Compile error:\n") + err_text
    if phase == "stopped" then status = "Stopped"
    else {
      for l in string.lines(err_text) { append_out(l, 1) }
      status = if phase == "compile" then "Compile error" else if phase == "runtime" then "Runtime error" else "Error (" + phase + ")"
      start_check()
    }
  }
}

pub fn on_result(id: Int, code: Int, body: Bytes) -> Unit = {
  let text = bytes.to_string_lossy(body)
  if id == run_id then {
    if code == 100 then { append_out(text, 0); list.push(stdout_text, text) }
    else if code == 101 then { append_out(text, 1); list.push(stderr_text, text) }
    else if code == 102 then { status = "Running…"; compile_ms = int.parse(text) ?? -1 }
    else if code == 200 then finish_run(true, text)
    else if code == 500 then finish_run(false, text)
    else ()
  } else if id == check_id and code == 200 then apply_diagnostics(text)
  else if id == rust_id then rust_view = ed.set_text(rust_view, if code == 200 then text else "// " + field_str(text, "error"))
  else if id == ast_id then ast_view = ed.set_text(ast_view, if code == 200 then text else "// " + field_str(text, "error"))
  else ()
}

// ── Examples ──

type Example = { id: String, title: String, files: List[String] }
type Category = { title: String, examples: List[Example] }

var categories: List[Category] = []

fn asset_text(name: String) -> String? = {
  let key = bytes.from_string(name)
  let n = sys.asset_len(bytes.data_ptr(key), bytes.len(key))
  if n < 0 then none
  else {
    var b = bytes.new(n)
    let _ = sys.asset_read(bytes.data_ptr(key), bytes.len(key), bytes.data_ptr(b), n)
    some(bytes.to_string_lossy(b))
  }
}

pub fn load_manifest() -> Unit = match asset_text("examples/manifest.json") {
  some(t) => match json.parse(t) {
    ok(v) => {
      var cats: List[Category] = []
      for c in json.get_array(v, "categories") ?? [] {
        var exs: List[Example] = []
        for e in json.get_array(c, "examples") ?? [] {
          var fs: List[String] = []
          for f in json.get_array(e, "files") ?? [] { list.push(fs, value.as_string(f) ?? "") }
          list.push(exs, { id: json.get_string(e, "id") ?? "", title: json.get_string(e, "title") ?? "", files: fs })
        }
        list.push(cats, { title: json.get_string(c, "title") ?? "", examples: exs })
      }
      categories = cats
    },
    err(_) => (),
  },
  none => (),
}

pub fn load_example(id: String) -> Bool = {
  var found = false
  for c in categories {
    for e in c.examples {
      if e.id == id and not found then {
        var fs: List[(String, String)] = []
        for f in e.files { list.push(fs, (f, asset_text("examples/" + id + "/" + f) ?? "")) }
        set_files(fs)
        clear_output()
        status = "Loaded example: " + e.title
        found = true
      } else ()
    }
  }
  examples_open = false
  found
}

pub fn load_default() -> Unit = set_files([(ENTRY, asset_text("examples/default.almd") ?? "effect fn main() -> Unit = println(\"Hello, Almide!\")\n")])

// ── Persistence ──

fn save() -> Unit = {
  let v = total_version()
  if v != saved_version and not embed then {
    saved_version = v
    let payload = bytes.from_string(share_json())
    let key = bytes.from_string(STORAGE_KEY)
    storage.storage_write(bytes.data_ptr(key), bytes.len(key), bytes.data_ptr(payload), bytes.len(payload))
  } else ()
}

pub fn restore() -> Bool = {
  let key = bytes.from_string(STORAGE_KEY)
  let n = storage.storage_len(bytes.data_ptr(key), bytes.len(key))
  if n <= 0 then false
  else {
    var b = bytes.new(n)
    let _ = storage.storage_read(bytes.data_ptr(key), bytes.len(key), bytes.data_ptr(b), n)
    match parse_share_json(bytes.to_string_lossy(b)) {
      some(fs) => { set_files(fs); true },
      none => false,
    }
  }
}

// ── Share links: #code=<base64url(deflate-raw(json))>, compatible with the
// previous playground ({ v: 1, files: [{ name, content }] }) ──

fn share_json() -> String = {
  var items: List[Value] = []
  for (n, t) in files() { list.push(items, value.object([("name", value.str(n)), ("content", value.str(t))])) }
  value.stringify(value.object([("v", value.int(1)), ("files", value.array(items))]))
}

fn parse_share_json(t: String) -> List[(String, String)]? = match json.parse(t) {
  ok(v) => {
    if (json.get_int(v, "v") ?? 0) != 1 then none
    else {
      var fs: List[(String, String)] = []
      for f in json.get_array(v, "files") ?? [] {
        list.push(fs, (json.get_string(f, "name") ?? "main.almd", json.get_string(f, "content") ?? ""))
      }
      if list.len(fs) == 0 then none else some(fs)
    }
  },
  err(_) => none,
}

pub fn share() -> Unit = {
  let enc = string.replace(base64.encode_url(deflate.raw(bytes.from_string(share_json()))), "=", "")
  let url = base_url + "#code=" + enc
  let loc = bytes.from_string("#code=" + enc)
  sys.set_location(bytes.data_ptr(loc), bytes.len(loc))
  ceangal.copy_text(url)
  status = "Share link copied (" + int.to_string(string.len(url)) + " chars)"
}

effect fn decode_share(code: String) -> List[(String, String)]? = {
  // base64url without padding → pad for the decoder
  let pad = (4 - string.len(code) % 4) % 4
  let padded = code + string.repeat("=", pad)
  match base64.decode_url(padded) {
    ok(raw) => match zlib.inflate(raw) {
      ok(t) => parse_share_json(bytes.to_string_lossy(t)),
      err(_) => none,
    },
    err(_) => none,
  }
}

// ── Boot: share hash > ?example= > saved tabs > default ──

fn launch() -> String = {
  let n = sys.launch_len()
  if n <= 0 then ""
  else {
    var b = bytes.new(n)
    let _ = sys.launch_read(bytes.data_ptr(b), n)
    bytes.to_string_lossy(b)
  }
}

fn param(l: String, name: String) -> String? = {
  let q = match string.index_of(l, "?") { some(i) => string.drop(l, i + 1), none => "" }
  let qs = match string.index_of(q, "#") { some(i) => string.take(q, i), none => q }
  var found: String? = none
  for kv in string.split(qs, "&") {
    match string.index_of(kv, "=") {
      some(i) => { if string.take(kv, i) == name then found = some(string.drop(kv, i + 1)) else () },
      none => { if kv == name then found = some("") else () },
    }
  }
  found
}

pub effect fn boot() -> Unit = {
  load_manifest()
  let l = launch()
  if string.starts_with(l, "http") then {
    let cut = match string.index_of(l, "#") { some(i) => string.take(l, i), none => l }
    base_url = match string.index_of(cut, "?") { some(i) => string.take(cut, i), none => cut }
  } else ()
  embed = param(l, "embed") == some("1")
  hidden = match param(l, "hide") { some(h) => string.split(h, ","), none => [] }
  var restored = false
  match string.index_of(l, "#code=") {
    some(i) => match decode_share(string.drop(l, i + 6))! {
      some(fs) => { set_files(fs); status = "Loaded shared code"; restored = true },
      none => { status = "Could not decode share link" },
    },
    none => (),
  }
  if not restored then match param(l, "example") { some(id) => { restored = load_example(id) }, none => () } else ()
  if not restored and not embed then restored = restore() else ()
  if not restored then load_default() else ()
  if param(l, "autorun") == some("1") then run() else ()
}

// ── Setters for view closures (writing `st.x = …` from a closure in another
// module miscompiles natively: almide/almide#3307) ──

pub fn toggle_examples() -> Unit = { examples_open = not examples_open }
pub fn close_examples() -> Unit = { examples_open = false }
pub fn toggle_mobile_output() -> Unit = { mobile_output = not mobile_output }
pub fn set_rename_field(e: ed.Editor) -> Unit = { rename_field = e }
pub fn set_out_tab(i: Int) -> Unit = { out_tab = i }
pub fn set_out(e: ed.Editor) -> Unit = { out = e }
pub fn set_rust_view(e: ed.Editor) -> Unit = { rust_view = e }
pub fn set_ast_view(e: ed.Editor) -> Unit = { ast_view = e }
pub fn picture_texture() -> Int = {
  if picture_tex == 0 then picture_tex = snaidhm.create_image(picture.w, picture.h, picture.rgba) else ()
  picture_tex
}

// ── For the AI assistant ──

pub fn active_text() -> String = ed.to_string(current())
pub fn set_active_text(s: String) -> Unit = set_current(ed.set_text(current(), s))
pub fn run_fresh() -> Unit = { if running then stop() else (); run() }
pub fn set_status(s: String) -> Unit = { status = s }

// ── Export: a runnable project (almide.toml, src/*.almd, data at the root) ──

pub fn export_zip() -> Unit = {
  var entries: List[(String, String)] = [("almide-playground/almide.toml", "[package]\nname = \"playground_export\"\nversion = \"0.1.0\"\n")]
  for (n, t) in files() {
    let path = if string.ends_with(n, ".almd") then "src/" + n else n
    list.push(entries, ("almide-playground/" + path, t))
  }
  let z = zip.build(entries)
  let name = bytes.from_string("almide-playground.zip")
  let _ = file.file_save(bytes.data_ptr(name), bytes.len(name), bytes.data_ptr(z), bytes.len(z))
  status = "Exported almide-playground.zip — unzip and `almide run src/main.almd`"
}
