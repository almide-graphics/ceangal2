# Right-to-left text in a text field: shown in visual order and joined,
# edited in logical order, arrows moving on screen (Right goes back in the
# text when it reads right to left).
tap "Name"
type "שלום"
see "Hello, שלום"
key Right
key Right
type "a"
see "Hello, שלaום"
key End
type " مرحبا لا"
see "Hello, שלaום مرحبا لا"
key Backspace
see "Hello, שלaום مرحبا ل"
# An isolate (LRI … PDI) keeps an English phrase with its number in order
# inside the right-to-left line; the controls draw nothing.
type " ⁦ok 12⁩!"
see "Hello, שלaום مرحبا ل ⁦ok 12⁩!"
shot "rtl-isolate.png"
shot "rtl.png"
# A field with_align_end: right-to-left text sits at the right edge, so a
# tap in the middle of the field lands after the (logical) end of a short word.
tap "Note"
type "مرحبا"
see "Note = مرحبا"
tap "Name"
tap "Note"
type "ب"
see "Note = مرحباب"
shot "rtl-aligned.png"
# An emoji ZWJ sequence and pointed Hebrew in right-to-left text stay whole
# (clusters are laid out from the right, not code points reversed).
key End
type " 👨‍👩‍👧 שָׁלוֹם"
see "Note = مرحباب 👨‍👩‍👧 שָׁלוֹם"
shot "rtl-emoji.png"
