# A dropdown and a menu: their lists float over what follows, a click picks
# an entry, the keyboard opens, moves and picks, Escape and a click outside
# close them.
tap "Country"
see "Egypt"
tap "Egypt"
see "status: country Egypt"
not "Brazil"
key Down
see "status: country Brazil"
key Enter
key Down
key Enter
see "status: country Norway"
tap "Actions"
see "Rename"
shot "menu.png"
key Escape
not "Rename"
tap "Actions"
tap "Archive"
see "status: archived"
tap "Actions"
tap "Wi-Fi"
not "Duplicate"
see "status: archived"
# A context menu: a right-click opens it at the pointer (a long press on a
# touch screen); a click picks an entry, Escape closes it.
tap "Lists"
context "Archive"
see "Empty"
tap "Empty"
see "status: emptied"
not "Open"
context "Archive"
see "Open"
key Escape
not "Open"
see "status: emptied"
# From the keyboard: Shift+F10 or the menu key opens the focused row's
# context menu; the arrows and Enter pick an entry.
tap "Inbox, 3 new"
key Tab
key Shift+F10
see "Open"
key Escape
not "Open"
tap "Inbox, 3 new"
key Tab
key Menu
see "Empty"
key Down
key Up
key Enter
see "status: open archive"
