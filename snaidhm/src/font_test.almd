import fs
import self.font as font

effect fn load(name: String) -> font.Font = match fs.read_bytes_raw("../assets/fonts/" + name) {
  ok(b) => font.parse(b),
  err(_) => font.parse(bytes.new(0)),
}

test "parses the bundled UI font" {
  let f = load("ui.ttf")!
  assert(f.ok)
  assert_eq(f.units_per_em, 2048.0)
  assert(font.glyph_index(f, 65) > 0)
  assert(font.advance(f, font.glyph_index(f, 65)) > 0.0)
}

test "maps kanji through the CJK font" {
  let f = load("cjk.ttf")!
  assert(f.ok)
  assert(font.glyph_index(f, 0x6F22) > 0)   // 漢
  assert(font.glyph_index(f, 0x3042) > 0)   // あ
  assert_eq(font.glyph_index(f, 0x1F600), 0)
}

test "rasterises A with sensible coverage" {
  let f = load("ui.ttf")!
  let bm = font.rasterize(f, font.glyph_index(f, 65), 32.0)
  assert(bm.w > 10 and bm.w < 30)
  assert(bm.h > 18 and bm.h < 30)
  var full = 0
  var empty = 0
  for i in 0..<(bm.w * bm.h) {
    let c = bytes.read_u8(bm.pixels, i)
    if c > 250 then full = full + 1 else ()
    if c < 5 then empty = empty + 1 else ()
  }
  assert(full > 40)
  assert(empty > 100)
  // the apex row is near-empty in the middle-left corner, the crossbar row is solid
  var art = ""
  for y in 0..<bm.h {
    var row = ""
    for x in 0..<bm.w {
      let c = bytes.read_u8(bm.pixels, y * bm.w + x)
      row = row + (if c > 170 then "#" else if c > 85 then "+" else if c > 20 then "." else " ")
    }
    art = art + row + "\n"
  }
  println(art)
}

test "composite glyph (Aacute) has more points than A" {
  let f = load("ui.ttf")!
  let a = font.outline(f, font.glyph_index(f, 65))
  let aa = font.outline(f, font.glyph_index(f, 0xC1))
  assert(list.len(aa.xs) > list.len(a.xs))
}
