// The code editor widget (also the single-line text field).
//
// State is a plain record the app owns; the widget reads it through `get`
// and writes it through `set`, so two events arriving before the next frame
// both see the latest state:
//
//   var doc = editor.from_string(source)
//   editor.view("main", () => doc, (e) => { doc = e })
//
// Text is kept as one codepoint list per line. Only visible lines are lexed,
// shaped and drawn, so cost per frame does not grow with document length.

import snaidhm
import math
import self as ui
import self.view as v
import self.text as tx
import self.syntax as syn

type Pos = { line: Int, col: Int }

// A diagnostic range: severity 0 error, 1 warning, 2 info.
type Diag = { line: Int, col: Int, end_line: Int, end_col: Int, severity: Int, message: String }

type Snap = { lines: List[List[Int]], cur: Pos, anchor: Pos }

type Editor = {
  lines: List[List[Int]],
  cur: Pos,
  anchor: Pos,
  want_x: Float,
  scroll_x: Float,
  scroll_y: Float,
  view_w: Float,
  view_h: Float,
  preedit: List[Int],
  preedit_cursor: Int,
  undo: List[Snap],
  redo: List[Snap],
  coalesce: Int,          // kind of the last edit (1 typing, 2 deleting), for undo grouping
  version: Int,           // bumps on every text change
  diags: List[Diag],
  font_size: Float,
  single_line: Bool,
  read_only: Bool,
  syntax: Bool,
  placeholder: String,
  scroll_to_cursor: Bool,
  line_style: List[Int],  // per-line color index into Theme.styles (plain text only)
  gutter: Bool,
  secret: Bool,           // shows • per character; copy / cut / a11y value are withheld
  touch: Touch,           // the finger on the view, if any
  fling_v: Float,         // momentum after a touch scroll (px/ms, + = down); 0 = none
  fling_t: Float,         // when the momentum was last advanced (ms)
  wrap: Bool,             // soft-wrap long lines at the view's width
  rows: List[Int],        // wrap cache: first visual row of each line, then the total
  rows_ver: Int,          // ... for this version
  rows_w: Float,          // ... and this wrap width
}

// A touch gesture: pending until it moves (scroll) or is held first (select);
// a touch that ends without moving is a tap.
type Touch = { id: Int, x0: Float, y0: Float, sx0: Float, sy0: Float, t0: Float, mode: Int, ly: Float, lt: Float, v: Float }

let TOUCH_NONE = 0
let TOUCH_PENDING = 1
let TOUCH_SCROLL = 2
let TOUCH_SELECT = 3
let TOUCH_SLOP = 8.0       // px a finger may wander and still tap
let LONG_PRESS_MS = 450.0
let FLING_DECAY_MS = 325.0 // velocity halves roughly every 225 ms, as on iOS

fn no_touch() -> Touch = { id: 0, x0: 0.0, y0: 0.0, sx0: 0.0, sy0: 0.0, t0: 0.0, mode: TOUCH_NONE, ly: 0.0, lt: 0.0, v: 0.0 }

let GUTTER_PAD = 12.0
let TEXT_PAD = 10.0

// ── Construction ──

fn split_lines(s: String) -> List[List[Int]] = {
  let cps = tx.codepoints(s)
  var lines: List[List[Int]] = []
  var cur: List[Int] = []
  for c in cps {
    if c == 10 then { list.push(lines, cur); cur = [] }
    else if c == 13 then ()
    else list.push(cur, c)
  }
  list.push(lines, cur)
  lines
}

// An editor holding `s` (multi-line, syntax highlighting on, caret at the start).
pub fn from_string(s: String) -> Editor = {
  lines: split_lines(s),
  cur: { line: 0, col: 0 },
  anchor: { line: 0, col: 0 },
  want_x: -1.0,
  scroll_x: 0.0,
  scroll_y: 0.0,
  view_w: 0.0,
  view_h: 0.0,
  preedit: [],
  preedit_cursor: 0,
  undo: [],
  redo: [],
  coalesce: 0,
  version: 0,
  diags: [],
  font_size: 13.0,
  single_line: false,
  read_only: false,
  syntax: true,
  placeholder: "",
  scroll_to_cursor: false,
  line_style: [],
  gutter: true,
  secret: false,
  touch: no_touch(),
  fling_v: 0.0,
  fling_t: 0.0,
  wrap: false,
  rows: [],
  rows_ver: -1,
  rows_w: 0.0,
}

// A one-line editor for a form field: Enter does not add a line, and
// `placeholder` shows while it is empty.
pub fn text_field(s: String, placeholder: String) -> Editor =
  { ...from_string(s), single_line: true, syntax: false, placeholder: placeholder, font_size: 14.0 }

// Text size in logical px.
pub fn with_font_size(e: Editor, size: Float) -> Editor = { ...e, font_size: size }
// Almide syntax highlighting on or off.
pub fn with_syntax(e: Editor, on: Bool) -> Editor = { ...e, syntax: on }
// The text can be selected and copied but not changed.
pub fn with_read_only(e: Editor, on: Bool) -> Editor = { ...e, read_only: on }
// Squiggles under these ranges (compiler errors and warnings).
pub fn with_diagnostics(e: Editor, ds: List[Diag]) -> Editor = { ...e, diags: ds }
// Line numbers on the left.
pub fn with_gutter(e: Editor, on: Bool) -> Editor = { ...e, gutter: on }
// Show a bullet per character (passwords, API keys); copying is off.
pub fn with_secret(e: Editor, on: Bool) -> Editor = { ...e, secret: on }
// almide/almide#3358: `[]` in a spread update needs a typed helper.
fn no_rows() -> List[Int] = []
// Soft-wrap long lines at the view's width instead of scrolling sideways.
pub fn with_wrap(e: Editor, on: Bool) -> Editor = if e.wrap == on then e else { ...e, wrap: on, rows: no_rows(), scroll_x: 0.0, scroll_to_cursor: true }

// What is drawn for a line: the text, or one bullet per character.
fn shown(e: Editor, cps: List[Int]) -> List[Int] = if e.secret then list.repeat(8226, list.len(cps)) else cps

// A read-only log (the playground's output panel): plain text, per-line style.
pub fn log() -> Editor = { ...from_string(""), syntax: false, read_only: true, gutter: false, font_size: 12.5 }

fn at_bottom(e: Editor) -> Bool =
  e.view_h <= 0.0 or e.scroll_y + e.view_h >= int.to_float(total_rows(e)) * line_h(e)

// Append one line with a style (0 normal, 1 error, 2 dim, 3 success);
// follows the tail while the view is scrolled to the bottom.
pub fn append_line(e: Editor, s: String, style: Int) -> Editor = {
  let follow = at_bottom(e)
  let n = list.len(e.lines)
  let empty_doc = n == 1 and list.len(e.lines[0]) == 0
  let lines = if empty_doc then [tx.codepoints(s)] else e.lines + [tx.codepoints(s)]
  var styles = e.line_style
  while list.len(styles) < (if empty_doc then 0 else n) { list.push(styles, 0) }
  list.push(styles, style)
  let last = list.len(lines) - 1
  let e2 = { ...e, lines: lines, line_style: styles, version: e.version + 1 }
  let e3 = with_rows(e2)
  let _ = last
  if follow then { ...e3, scroll_y: clamp_scroll(e3, int.to_float(total_rows(e3)) * line_h(e3) - e3.view_h + pad_y(e3) * 2.0) } else e3
}

// Empty the text (undo history and settings kept).
pub fn clear(e: Editor) -> Editor = {
  let p = { line: 0, col: 0 }
  let none_lines: List[List[Int]] = [[]]
  let none_styles: List[Int] = []
  { ...e, lines: none_lines, line_style: none_styles, cur: p, anchor: p, scroll_x: 0.0, scroll_y: 0.0, version: e.version + 1 }
}

fn cps_to_string(cps: List[Int]) -> String = {
  var b = bytes.new(0)
  for c in cps {
    if c < 128 then bytes.append_u8(b, c)
    else if c < 2048 then { bytes.append_u8(b, 192 + c / 64); bytes.append_u8(b, 128 + c % 64) }
    else if c < 65536 then { bytes.append_u8(b, 224 + c / 4096); bytes.append_u8(b, 128 + (c / 64) % 64); bytes.append_u8(b, 128 + c % 64) }
    else { bytes.append_u8(b, 240 + c / 262144); bytes.append_u8(b, 128 + (c / 4096) % 64); bytes.append_u8(b, 128 + (c / 64) % 64); bytes.append_u8(b, 128 + c % 64) }
  }
  bytes.to_string_lossy(b)
}

// The whole text, lines joined with "\n".
pub fn to_string(e: Editor) -> String = {
  var parts: List[String] = []
  for l in e.lines { list.push(parts, cps_to_string(l)) }
  string.join(parts, "\n")
}

// The lines on screen (plus a few around them), for assistive technology:
// a 10k-line buffer must not be re-joined every frame.
pub fn visible_text(e: Editor) -> String = if e.secret then "" else {
  let lh = line_h(e)
  let first = int.max(0, float.to_int(float.floor(e.scroll_y / lh)) - 5)
  let last = int.min(list.len(e.lines) - 1, float.to_int(float.ceil((e.scroll_y + float.max(e.view_h, lh * 40.0)) / lh)) + 5)
  var parts: List[String] = []
  for i in first..<(last + 1) { list.push(parts, cps_to_string(e.lines[i])) }
  string.join(parts, "\n")
}

// The number of lines.
pub fn line_count(e: Editor) -> Int = list.len(e.lines)
// The caret's position (line and column, from 0).
pub fn cursor(e: Editor) -> Pos = e.cur

// ── Positions ──

fn line_len(e: Editor, l: Int) -> Int = list.len(e.lines[l])

fn clamp_pos(e: Editor, p: Pos) -> Pos = {
  let l = int.max(0, int.min(list.len(e.lines) - 1, p.line))
  { line: l, col: int.max(0, int.min(line_len(e, l), p.col)) }
}

fn before(a: Pos, b: Pos) -> Bool = a.line < b.line or (a.line == b.line and a.col < b.col)

fn sel_start(e: Editor) -> Pos = if before(e.anchor, e.cur) then e.anchor else e.cur
fn sel_end(e: Editor) -> Pos = if before(e.anchor, e.cur) then e.cur else e.anchor
// Some text is selected.
pub fn has_selection(e: Editor) -> Bool = e.anchor.line != e.cur.line or e.anchor.col != e.cur.col

// The selected text ("" when none).
pub fn selected_text(e: Editor) -> String = {
  let a = sel_start(e)
  let b = sel_end(e)
  if a.line == b.line then cps_to_string(list.slice(e.lines[a.line], a.col, b.col))
  else {
    var parts: List[String] = [cps_to_string(list.drop(e.lines[a.line], a.col))]
    for l in (a.line + 1)..<b.line { list.push(parts, cps_to_string(e.lines[l])) }
    list.push(parts, cps_to_string(list.take(e.lines[b.line], b.col)))
    string.join(parts, "\n")
  }
}

fn move_to(e: Editor, p: Pos, extend: Bool) -> Editor = {
  let q = clamp_pos(e, p)
  { ...e, cur: q, anchor: if extend then e.anchor else q, coalesce: 0, scroll_to_cursor: true }
}

// Move the caret to (line, col), clearing the selection.
pub fn set_cursor(e: Editor, line: Int, col: Int) -> Editor =
  { ...move_to(e, { line: line, col: col }, false), want_x: -1.0 }

// Select the whole text.
pub fn select_all(e: Editor) -> Editor = {
  let last = list.len(e.lines) - 1
  { ...e, anchor: { line: 0, col: 0 }, cur: { line: last, col: line_len(e, last) }, coalesce: 0 }
}

// ── Editing ──

fn snapshot(e: Editor) -> Snap = { lines: e.lines, cur: e.cur, anchor: e.anchor }

// Record an undo point unless this edit continues the previous one of the
// same kind (typing a word, holding backspace).
fn checkpoint(e: Editor, kind: Int) -> Editor =
  if kind != 0 and kind == e.coalesce then e
  else {
    let u = if list.len(e.undo) >= 500 then list.drop(e.undo, 1) else e.undo
    let no_redo: List[Snap] = []
    { ...e, undo: u + [snapshot(e)], redo: no_redo, coalesce: kind }
  }

// Replace the selection with `ins` (codepoints, may contain newlines).
fn replace_selection(e: Editor, ins: List[Int], kind: Int) -> Editor =
  if e.read_only then e
  else {
    let e1 = checkpoint(e, kind)
    let a = sel_start(e1)
    let b = sel_end(e1)
    let head = list.take(e1.lines[a.line], a.col)
    let tail = list.drop(e1.lines[b.line], b.col)
    // split the insertion into lines
    var ins_lines: List[List[Int]] = []
    var cur: List[Int] = []
    for c in ins {
      if c == 10 and not e1.single_line then { list.push(ins_lines, cur); cur = [] }
      else if c == 13 or c == 10 then ()
      else list.push(cur, c)
    }
    list.push(ins_lines, cur)
    let k = list.len(ins_lines)
    var new_lines: List[List[Int]] = []
    if k == 1 then list.push(new_lines, head + ins_lines[0] + tail)
    else {
      list.push(new_lines, head + ins_lines[0])
      for i in 1..<(k - 1) { list.push(new_lines, ins_lines[i]) }
      list.push(new_lines, ins_lines[k - 1] + tail)
    }
    let lines = list.take(e1.lines, a.line) + new_lines + list.drop(e1.lines, b.line + 1)
    let end_col = if k == 1 then a.col + list.len(ins_lines[0]) else list.len(ins_lines[k - 1])
    let p = { line: a.line + k - 1, col: end_col }
    { ...e1, lines: lines, cur: p, anchor: p, want_x: -1.0, version: e1.version + 1, scroll_to_cursor: true }
  }

// Insert `s` at the caret (replacing the selection), as typing would.
pub fn insert(e: Editor, s: String) -> Editor = replace_selection(e, tx.codepoints(s), 1)

// Replace the whole text (an undoable edit; the caret goes to the end).
pub fn set_text(e: Editor, s: String) -> Editor = {
  let e1 = checkpoint(e, 0)
  let lines = split_lines(s)
  let p = { line: 0, col: 0 }
  { ...e1, lines: lines, cur: p, anchor: p, version: e1.version + 1, scroll_x: 0.0, scroll_y: 0.0 }
}

fn word_left(e: Editor, p: Pos) -> Pos =
  if p.col == 0 then (if p.line > 0 then { line: p.line - 1, col: line_len(e, p.line - 1) } else p)
  else {
    let l = e.lines[p.line]
    var c = p.col
    while c > 0 and not syn.is_word(l[c - 1]) { c = c - 1 }
    while c > 0 and syn.is_word(l[c - 1]) { c = c - 1 }
    { line: p.line, col: c }
  }

fn word_right(e: Editor, p: Pos) -> Pos = {
  let n = line_len(e, p.line)
  if p.col >= n then (if p.line + 1 < list.len(e.lines) then { line: p.line + 1, col: 0 } else p)
  else {
    let l = e.lines[p.line]
    var c = p.col
    while c < n and not syn.is_word(l[c]) { c = c + 1 }
    while c < n and syn.is_word(l[c]) { c = c + 1 }
    { line: p.line, col: c }
  }
}

// One caret stop left / right: past a whole cluster (a conjunct, an emoji).
fn left_of(e: Editor, p: Pos) -> Pos =
  if p.col > 0 then {
    let st = tx.stops(e.lines[p.line])
    var c = p.col - 1
    while c > 0 and not st[c] { c = c - 1 }
    { line: p.line, col: c }
  } else if p.line > 0 then { line: p.line - 1, col: line_len(e, p.line - 1) }
  else p

fn right_of(e: Editor, p: Pos) -> Pos = {
  let n = line_len(e, p.line)
  if p.col < n then {
    let st = tx.stops(e.lines[p.line])
    var c = p.col + 1
    while c < n and not st[c] { c = c + 1 }
    { line: p.line, col: c }
  } else if p.line + 1 < list.len(e.lines) then { line: p.line + 1, col: 0 }
  else p
}

// Backspace takes a whole emoji, but one sign of a conjunct (as typed).
fn delete_back(e: Editor, word: Bool) -> Editor =
  if has_selection(e) then replace_selection(e, [], 2)
  else {
    let target = if word then word_left(e, e.cur)
      else if e.cur.col > 0 then { line: e.cur.line, col: tx.backspace_to(e.lines[e.cur.line], e.cur.col) }
      else left_of(e, e.cur)
    replace_selection({ ...e, anchor: target }, [], 2)
  }

fn delete_forward(e: Editor, word: Bool) -> Editor =
  if has_selection(e) then replace_selection(e, [], 2)
  else {
    let target = if word then word_right(e, e.cur) else right_of(e, e.cur)
    replace_selection({ ...e, anchor: target }, [], 2)
  }

fn indent_of(l: List[Int]) -> List[Int] = {
  var out: List[Int] = []
  var i = 0
  while i < list.len(l) and (l[i] == 32 or l[i] == 9) { list.push(out, l[i]); i = i + 1 }
  out
}

fn newline(e: Editor) -> Editor = {
  let l = e.lines[e.cur.line]
  var ind = indent_of(l)
  // one level deeper after an opening bracket or `=`
  let before_cursor = list.take(l, e.cur.col)
  var k = list.len(before_cursor) - 1
  while k >= 0 and before_cursor[k] == 32 { k = k - 1 }
  if k >= 0 and (before_cursor[k] == 123 or before_cursor[k] == 40 or before_cursor[k] == 91 or before_cursor[k] == 61) then ind = ind + [32, 32] else ()
  replace_selection(e, [10] + ind, 3)
}

fn indent_lines(e: Editor, out: Bool) -> Editor = {
  let e1 = checkpoint(e, 0)
  let a = sel_start(e1)
  let b = sel_end(e1)
  var lines = e1.lines
  var shift_a = 0
  var shift_b = 0
  for l in a.line...b.line {
    let line = lines[l]
    if out then {
      var n = 0
      while n < 2 and n < list.len(line) and line[n] == 32 { n = n + 1 }
      lines[l] = list.drop(line, n)
      if l == a.line then shift_a = 0 - n else ()
      if l == b.line then shift_b = 0 - n else ()
    } else {
      lines[l] = [32, 32] + line
      if l == a.line then shift_a = 2 else ()
      if l == b.line then shift_b = 2 else ()
    }
  }
  let na = { line: a.line, col: int.max(0, a.col + shift_a) }
  let nb = { line: b.line, col: int.max(0, b.col + shift_b) }
  let forward = before(e1.anchor, e1.cur)
  { ...e1, lines: lines, anchor: if forward then na else nb, cur: if forward then nb else na, version: e1.version + 1 }
}

// Undo the last edit.
pub fn undo(e: Editor) -> Editor = {
  let n = list.len(e.undo)
  if n == 0 then e
  else {
    let s = e.undo[n - 1]
    { ...e, lines: s.lines, cur: s.cur, anchor: s.anchor, undo: list.take(e.undo, n - 1), redo: e.redo + [snapshot(e)], coalesce: 0, version: e.version + 1, scroll_to_cursor: true }
  }
}

// Redo what undo undid.
pub fn redo(e: Editor) -> Editor = {
  let n = list.len(e.redo)
  if n == 0 then e
  else {
    let s = e.redo[n - 1]
    { ...e, lines: s.lines, cur: s.cur, anchor: s.anchor, redo: list.take(e.redo, n - 1), undo: e.undo + [snapshot(e)], coalesce: 0, version: e.version + 1, scroll_to_cursor: true }
  }
}

// ── Metrics (logical px) ──

fn line_h(e: Editor) -> Float = float.ceil(e.font_size * 1.55)

fn gutter_w(e: Editor) -> Float =
  if e.single_line or not e.gutter then 0.0
  else {
    let digits = string.len(int.to_string(list.len(e.lines)))
    float.ceil(int.to_float(int.max(2, digits)) * tx.width("0", e.font_size, true, false)) + GUTTER_PAD * 2.0
  }

fn pad_x(e: Editor) -> Float = if e.single_line then 10.0 else TEXT_PAD

// x of each column boundary of a line (length cols+1), logical px.
fn col_xs(e: Editor, cps: List[Int]) -> List[Float] = {
  let shown_cps = shown(e, cps)
  tx.edges(tx.shape(shown_cps, e.font_size, not e.single_line, false), list.len(shown_cps))
}

fn x_of(e: Editor, p: Pos) -> Float = {
  let xs = col_xs(e, list.take(e.lines[p.line], p.col))
  xs[list.len(xs) - 1]
}

fn col_at_x(e: Editor, line: Int, x: Float) -> Int = {
  let xs = col_xs(e, e.lines[line])
  let st = tx.stops(e.lines[line])
  // the nearest caret stop (never inside a conjunct or an emoji)
  var best = 0
  var prev = 0
  for i in 1..<list.len(xs) {
    if st[i] then {
      if (xs[prev] + xs[i]) * 0.5 <= x then best = i else ()
      prev = i
    } else ()
  }
  best
}

fn vertical(e0: Editor, dl: Int, extend: Bool) -> Editor = if wrapping(e0) then vertical_rows(with_rows(e0), dl, extend) else {
  let e = e0
  let wx = if e.want_x >= 0.0 then e.want_x else x_of(e, e.cur)
  let target = int.max(0, int.min(list.len(e.lines) - 1, e.cur.line + dl))
  let col = if target == e.cur.line and dl < 0 then 0
    else if target == e.cur.line and dl > 0 then line_len(e, target)
    else col_at_x(e, target, wx)
  { ...move_to(e, { line: target, col: col }, extend), want_x: wx }
}

// Keep the cursor inside the viewport after it moved.
// Up / down by visual rows when wrapping (want_x is within the row).
fn vertical_rows(e: Editor, dl: Int, extend: Bool) -> Editor = {
  let bs = line_breaks(e, e.cur.line)
  let j = seg_of(bs, e.cur.col)
  let xs = col_xs(e, e.lines[e.cur.line])
  let wx = if e.want_x >= 0.0 then e.want_x else xs[e.cur.col] - xs[bs[j]]
  let row = row_start(e, e.cur.line) + j + dl
  if row < 0 then { ...move_to(e, { line: 0, col: 0 }, extend), want_x: wx }
  else if row >= total_rows(e) then {
    let last = list.len(e.lines) - 1
    { ...move_to(e, { line: last, col: line_len(e, last) }, extend), want_x: wx }
  } else { ...move_to(e, pos_in_row(e, row, wx), extend), want_x: wx }
}

// The position at x (relative to the row's start) on visual row `row`.
fn pos_in_row(e: Editor, row: Int, x: Float) -> Pos = {
  let l = line_of_row(e, row)
  let bs = line_breaks(e, l)
  let j = int.max(0, int.min(list.len(bs) - 1, row - row_start(e, l)))
  let xs = col_xs(e, e.lines[l])
  let c0 = bs[j]
  let c1 = if j + 1 < list.len(bs) then bs[j + 1] else list.len(e.lines[l])
  var best = c0
  for i in c0...c1 {
    if i > c0 and (xs[i - 1] + xs[i]) * 0.5 - xs[c0] <= x then best = i else ()
  }
  // the end of a non-final row is the next row's start: stay on this row
  let col = if j + 1 < list.len(bs) and best == c1 then int.max(c0, c1 - 1) else best
  { line: l, col: col }
}

// ── Soft wrap ──
//
// A wrapped line is drawn as several visual rows ("segments"), broken after
// the last space that fits (or mid-word when none does). `rows` caches the
// first row of every line for the current text and width; everything that
// maps lines to y goes through row_start / total_rows / row_at.

fn wrapping(e: Editor) -> Bool = e.wrap and not e.single_line and e.view_w > 0.0

fn wrap_avail(e: Editor) -> Float = float.max(40.0, e.view_w - gutter_w(e) - pad_x(e) * 2.0)

// Segment start columns of a line given its glyph end positions `xs`
// (xs[i] = x after i characters) and characters `cps`. Always starts with 0.
fn breaks_of(xs: List[Float], cps: List[Int], avail: Float) -> List[Int] = {
  var bs = [0]
  var start = 0
  var row_x = 0.0
  var space = -1
  for i in 1..<list.len(xs) {
    if xs[i] - row_x > avail and i - 1 > start then {
      let at = if space >= start + 1 then space else i - 1
      list.push(bs, at)
      start = at
      row_x = xs[at]
      space = -1
    } else ()
    if i - 1 < list.len(cps) and cps[i - 1] == 32 then space = i else ()
  }
  bs
}

fn line_breaks(e: Editor, l: Int) -> List[Int] =
  if not wrapping(e) then [0]
  else breaks_of(col_xs(e, e.lines[l]), e.lines[l], wrap_avail(e))

fn rows_fresh(e: Editor) -> Bool =
  e.rows_ver == e.version and e.rows_w == wrap_avail(e) and list.len(e.rows) == list.len(e.lines) + 1

// Refresh the wrap cache if the text or the width changed.
pub fn with_rows(e: Editor) -> Editor =
  if not wrapping(e) or rows_fresh(e) then e
  else {
    var rows = [0]
    var acc = 0
    for l in 0..<list.len(e.lines) {
      acc = acc + list.len(line_breaks(e, l))
      list.push(rows, acc)
    }
    { ...e, rows: rows, rows_ver: e.version, rows_w: wrap_avail(e) }
  }

fn row_start(e: Editor, l: Int) -> Int =
  if wrapping(e) and list.len(e.rows) == list.len(e.lines) + 1 then e.rows[l] else l

fn total_rows(e: Editor) -> Int =
  if wrapping(e) and list.len(e.rows) == list.len(e.lines) + 1 then e.rows[list.len(e.lines)] else list.len(e.lines)

// The line holding visual row r (clamped).
fn line_of_row(e: Editor, r: Int) -> Int =
  if not (wrapping(e) and list.len(e.rows) == list.len(e.lines) + 1) then int.max(0, int.min(list.len(e.lines) - 1, r))
  else {
    var lo = 0
    var hi = list.len(e.lines) - 1
    while lo < hi {
      let mid = (lo + hi + 1) / 2
      if e.rows[mid] <= r then lo = mid else hi = mid - 1
    }
    lo
  }

// Which segment of its line a column is on (the end of a segment belongs to
// the next one, except at the end of the line).
fn seg_of(bs: List[Int], col: Int) -> Int = {
  var j = 0
  for i in 0..<list.len(bs) { if bs[i] <= col then j = i else () }
  j
}

fn row_of_pos(e: Editor, p: Pos) -> Int = row_start(e, p.line) + seg_of(line_breaks(e, p.line), p.col)

fn ensure_visible(e0: Editor) -> Editor =
  if not e0.scroll_to_cursor or e0.view_h <= 0.0 then e0
  else {
    let e = with_rows(e0)
    let lh = line_h(e)
    let top = int.to_float(row_of_pos(e, e.cur)) * lh
    let sy = if top < e.scroll_y then top
      else if top + lh > e.scroll_y + e.view_h - pad_y(e) * 2.0 then top + lh - e.view_h + pad_y(e) * 2.0
      else e.scroll_y
    let cx = x_of(e, e.cur)
    let avail = e.view_w - gutter_w(e) - pad_x(e) * 2.0
    let sx = if wrapping(e) then 0.0
      else if cx < e.scroll_x then float.max(0.0, cx - 20.0)
      else if cx > e.scroll_x + avail then cx - avail + 20.0
      else e.scroll_x
    { ...e, scroll_x: clamp_scroll_x(e, sx), scroll_y: clamp_scroll(e, sy), scroll_to_cursor: false }
  }

fn pad_y(e: Editor) -> Float = if e.single_line then 0.0 else 8.0

// Scrolling stops at the content's edges (as CodeMirror does): the last
// line at the bottom, the end of the longest line at the right.
fn clamp_scroll(e: Editor, sy: Float) -> Float = {
  let content = int.to_float(total_rows(e)) * line_h(e) + pad_y(e) * 2.0
  float.max(0.0, float.min(sy, content - e.view_h))
}

// The width of the longest line (measured on the line with the most
// characters; a line of wide CJK characters may be a little wider).
fn content_w(e: Editor) -> Float = {
  var best = 0
  var at = 0
  for i in 0..<list.len(e.lines) {
    let n = list.len(e.lines[i])
    if n > best then { best = n; at = i } else ()
  }
  x_of(e, { line: at, col: best })
}

fn clamp_scroll_x(e: Editor, sx: Float) -> Float = if wrapping(e) then 0.0 else {
  let avail = e.view_w - gutter_w(e) - pad_x(e) * 2.0
  float.max(0.0, float.min(sx, content_w(e) - avail + 2.0))
}

// ── Input ──

// Key handling; returns (state, handled).
pub fn key(e: Editor, phase: Int, code: Int, mods: Int) -> (Editor, Bool) =
  if phase == 1 then (e, false)
  else {
    let sc = ui.is_shortcut(mods)
    let shift = ui.has_shift(mods)
    let alt = ui.has_alt(mods)
    let lh = line_h(e)
    let page = int.max(1, float.to_int(e.view_h / lh) - 1)
    let r: Editor? =
      if code == 10 then some(if has_selection(e) and not shift then move_to(e, sel_start(e), false) else if sc then move_to(e, { line: e.cur.line, col: 0 }, shift) else if alt then move_to(e, word_left(e, e.cur), shift) else move_to(e, left_of(e, e.cur), shift))
      else if code == 11 then some(if has_selection(e) and not shift then move_to(e, sel_end(e), false) else if sc then move_to(e, { line: e.cur.line, col: line_len(e, e.cur.line) }, shift) else if alt then move_to(e, word_right(e, e.cur), shift) else move_to(e, right_of(e, e.cur), shift))
      else if code == 12 and not e.single_line then some(if sc then move_to(e, { line: 0, col: 0 }, shift) else vertical(e, -1, shift))
      else if code == 13 and not e.single_line then some(if sc then move_to(e, { line: list.len(e.lines) - 1, col: line_len(e, list.len(e.lines) - 1) }, shift) else vertical(e, 1, shift))
      else if code == 14 then {
        // Home: first non-blank, then column 0
        let ind = list.len(indent_of(e.lines[e.cur.line]))
        some(move_to(e, { line: if sc then 0 else e.cur.line, col: if e.cur.col == ind or sc then 0 else ind }, shift))
      }
      else if code == 15 then some(move_to(e, if sc then { line: list.len(e.lines) - 1, col: line_len(e, list.len(e.lines) - 1) } else { line: e.cur.line, col: line_len(e, e.cur.line) }, shift))
      else if code == 16 and not e.single_line then some(vertical({ ...e, scroll_y: clamp_scroll(e, e.scroll_y - int.to_float(page) * lh) }, 0 - page, shift))
      else if code == 17 and not e.single_line then some(vertical({ ...e, scroll_y: clamp_scroll(e, e.scroll_y + int.to_float(page) * lh) }, page, shift))
      else if code == 3 then some(delete_back(e, alt or sc))
      else if code == 4 then some(delete_forward(e, alt))
      else if code == 1 and not e.single_line then some(newline(e))
      else if code == 2 and not e.single_line then {
        let multi = shift or (has_selection(e) and e.anchor.line != e.cur.line)
        some(if multi then indent_lines(e, shift) else replace_selection(e, [32, 32], 1))
      }
      else if code == 20 and sc then some(select_all(e))
      else if code == 24 and sc then some(if shift then redo(e) else undo(e))
      else if code == 25 and sc then some(redo(e))
      else if code == 21 and sc then { if has_selection(e) and not e.secret then ui.copy_text(selected_text(e)) else (); some(e) }
      else if code == 23 and sc then {
        if has_selection(e) and not e.secret then { ui.copy_text(selected_text(e)); some(replace_selection(e, [], 0)) } else some(e)
      }
      else none
    match r {
      some(e2) => (ensure_visible(e2), true),
      none => (e, false),
    }
  }

fn no_cps() -> List[Int] = []

// Text input: kind 0 commit, 1 IME preedit (shown at the caret, not yet
// text), 2 preedit end, 3 paste; `cursor` is the preedit's caret (bytes).
pub fn text(e: Editor, kind: Int, s: String, cursor: Int) -> Editor =
  if kind == 1 then { ...e, preedit: tx.codepoints(s), preedit_cursor: cursor, scroll_to_cursor: true }
  else if kind == 2 then { ...e, preedit: no_cps() }
  else {
    let cps = tx.codepoints(s)
    // closing bracket typed right before the same auto-inserted one: step over
    let lnow = e.lines[e.cur.line]
    let next = if e.cur.col < list.len(lnow) then lnow[e.cur.col] else 0
    if kind == 0 and list.len(cps) == 1 and not has_selection(e) and (cps[0] == 41 or cps[0] == 93 or cps[0] == 125) and next == cps[0] then
      ensure_visible(move_to({ ...e, preedit: no_cps() }, right_of(e, e.cur), false))
    else ensure_visible(replace_selection({ ...e, preedit: no_cps() }, cps, if kind == 3 then 0 else 1))
  }

// The text position under a point of the view.
fn pos_at(e: Editor, x: Float, y: Float) -> Pos = if wrapping(e) then {
  let row = int.max(0, float.to_int(float.floor((y + e.scroll_y - pad_y(e)) / line_h(e))))
  pos_in_row(e, int.min(row, total_rows(e) - 1), x - gutter_w(e) - pad_x(e))
} else {
  let line = int.max(0, int.min(list.len(e.lines) - 1, float.to_int(float.floor((y + e.scroll_y - pad_y(e)) / line_h(e)))))
  { line: line, col: col_at_x(e, line, x - gutter_w(e) - pad_x(e) + e.scroll_x) }
}

// Mouse: press places the cursor, drag extends the selection (shift+click
// extends too). Touch (pointer id >= 1): drag scrolls with momentum, a tap
// places the cursor, press-and-hold then drag selects.
pub fn pointer(e: Editor, p: v.Pointer) -> Editor =
  if p.id >= 1 then touch(e, p, ui.clock_ms())
  else if p.phase == 0 then { ...move_to(e, pos_at(e, p.x, p.y), ui.has_shift(p.mods)), want_x: -1.0, fling_v: 0.0 }
  else if p.phase == 1 and p.buttons % 2 == 1 then { ...move_to(e, pos_at(e, p.x, p.y), true), want_x: -1.0 }
  else e

fn touch(e: Editor, p: v.Pointer, now: Float) -> Editor = {
  let t = e.touch
  if p.phase == 0 then
    { ...e, fling_v: 0.0, touch: { id: p.id, x0: p.x, y0: p.y, sx0: e.scroll_x, sy0: e.scroll_y, t0: now, mode: TOUCH_PENDING, ly: p.y, lt: now, v: 0.0 } }
  else if t.id != p.id then e
  else if p.phase == 1 then {
    let dx = p.x - t.x0
    let dy = p.y - t.y0
    let moved = float.abs(dx) > TOUCH_SLOP or float.abs(dy) > TOUCH_SLOP
    let mode = if t.mode != TOUCH_PENDING then t.mode
      else if moved and now - t.t0 >= LONG_PRESS_MS then TOUCH_SELECT
      else if moved then TOUCH_SCROLL
      else TOUCH_PENDING
    if mode == TOUCH_SCROLL then {
      let dt = float.max(1.0, now - t.lt)
      let v_now = (t.ly - p.y) / dt
      // a long single-line field scrolls sideways; everything else vertically
      let sx = if e.single_line then clamp_scroll_x(e, t.sx0 - dx) else e.scroll_x
      { ...e, scroll_y: clamp_scroll(e, t.sy0 - dy), scroll_x: sx,
        touch: { ...t, mode: mode, ly: p.y, lt: now, v: v_now * 0.8 + t.v * 0.2 } }
    } else if mode == TOUCH_SELECT then {
      let started = if t.mode == TOUCH_SELECT then e else move_to(e, pos_at(e, t.x0, t.y0), false)
      { ...move_to(started, pos_at(e, p.x, p.y), true), want_x: -1.0, touch: { ...t, mode: mode } }
    } else e
  } else {
    // up (2) or cancel (3)
    let tap = p.phase == 2 and t.mode == TOUCH_PENDING
    let flick = t.mode == TOUCH_SCROLL and now - t.lt < 80.0 and float.abs(t.v) > 0.25
    let e2 = if tap then { ...move_to(e, pos_at(e, p.x, p.y), false), want_x: -1.0 } else e
    { ...e2, touch: no_touch(), fling_v: if flick then t.v else 0.0, fling_t: now }
  }
}

// Advance the momentum of a flick; true while it is still moving.
fn fling(e: Editor, now: Float) -> (Editor, Bool) =
  if e.fling_v == 0.0 then (e, false)
  else {
    let dt = float.min(64.0, float.max(0.0, now - e.fling_t))
    let sy = clamp_scroll(e, e.scroll_y + e.fling_v * dt)
    let v2 = e.fling_v * math.exp(0.0 - dt / FLING_DECAY_MS)
    let stopped = float.abs(v2) < 0.02 or sy != e.scroll_y + e.fling_v * dt
    ({ ...e, scroll_y: sy, fling_v: if stopped then 0.0 else v2, fling_t: now }, not stopped)
  }

// Wheel / trackpad: the dominant axis wins, so a vertical swipe does not
// drift sideways (and the reverse).
pub fn wheel(e: Editor, dx: Float, dy: Float) -> Editor = {
  let ax = float.abs(dx)
  let ay = float.abs(dy)
  let mx = if ax > ay * 2.0 then dx else 0.0
  let my = if ay > ax * 2.0 or ax <= ay then dy else 0.0
  { ...e, scroll_y: clamp_scroll(e, e.scroll_y + my), scroll_x: clamp_scroll_x(e, e.scroll_x + mx), fling_v: 0.0 }
}

// ── Theme ──

type Theme = {
  bg: snaidhm.Color, gutter_bg: snaidhm.Color, gutter_fg: snaidhm.Color, gutter_active: snaidhm.Color,
  text: snaidhm.Color, caret: snaidhm.Color, selection: snaidhm.Color, active_line: snaidhm.Color,
  colors: List[snaidhm.Color], error: snaidhm.Color, warning: snaidhm.Color, placeholder: snaidhm.Color,
  styles: List[snaidhm.Color],
}

// Tokyo-night-like, matching the playground's previous CodeMirror theme.
pub fn dark_theme() -> Theme = {
  bg: snaidhm.hex(0x1A1B26), gutter_bg: snaidhm.hex(0x1A1B26), gutter_fg: snaidhm.hex(0x3B4261), gutter_active: snaidhm.hex(0x737AA2),
  text: snaidhm.hex(0xC0CAF5), caret: snaidhm.hex(0xC0CAF5), selection: snaidhm.rgba(0.32, 0.38, 0.62, 0.45), active_line: snaidhm.rgba(1.0, 1.0, 1.0, 0.035),
  colors: [snaidhm.hex(0xC0CAF5), snaidhm.hex(0xBB9AF7), snaidhm.hex(0x9ECE6A), snaidhm.hex(0x565F89), snaidhm.hex(0xFF9E64),
           snaidhm.hex(0x2AC3DE), snaidhm.hex(0x7AA2F7), snaidhm.hex(0xE0AF68), snaidhm.hex(0x7DCFFF), snaidhm.hex(0x89DDFF), snaidhm.hex(0x9AA5CE)],
  error: snaidhm.hex(0xF7768E), warning: snaidhm.hex(0xE0AF68), placeholder: snaidhm.hex(0x565F89),
  styles: [snaidhm.hex(0xC0CAF5), snaidhm.hex(0xF7768E), snaidhm.hex(0x565F89), snaidhm.hex(0x9ECE6A), snaidhm.hex(0x7AA2F7)],
}

// Colours for a light background.
pub fn light_theme() -> Theme = {
  bg: snaidhm.hex(0xFFFFFF), gutter_bg: snaidhm.hex(0xFFFFFF), gutter_fg: snaidhm.hex(0xB0B7C3), gutter_active: snaidhm.hex(0x4B5563),
  text: snaidhm.hex(0x1F2937), caret: snaidhm.hex(0x111827), selection: snaidhm.rgba(0.23, 0.51, 0.96, 0.22), active_line: snaidhm.rgba(0.0, 0.0, 0.0, 0.035),
  colors: [snaidhm.hex(0x1F2937), snaidhm.hex(0x7C3AED), snaidhm.hex(0x15803D), snaidhm.hex(0x9CA3AF), snaidhm.hex(0xC2410C),
           snaidhm.hex(0x0E7490), snaidhm.hex(0x2563EB), snaidhm.hex(0xB45309), snaidhm.hex(0x0369A1), snaidhm.hex(0x475569), snaidhm.hex(0x6B7280)],
  error: snaidhm.hex(0xDC2626), warning: snaidhm.hex(0xD97706), placeholder: snaidhm.hex(0x9CA3AF),
  styles: [snaidhm.hex(0x1F2937), snaidhm.hex(0xDC2626), snaidhm.hex(0x9CA3AF), snaidhm.hex(0x15803D), snaidhm.hex(0x2563EB)],
}

// ── Paint ──

// Lexer state at the start of `line`, computed from the top (cheap: only
// comment depth and heredoc are carried).
fn state_at(e: Editor, line: Int) -> syn.LexState = {
  var st = syn.initial()
  for l in 0..<line {
    let ln = e.lines[l]
    // fast path: a line without ( " or * cannot change the state
    if st.comment > 0 or st.heredoc or list.contains(ln, 34) or list.contains(ln, 40) then {
      let (_, next) = syn.lex(ln, st)
      st = next
    } else ()
  }
  st
}

fn paint(e: Editor, focused: Bool, th: Theme, x: Float, y: Float, w: Float, h: Float) -> Unit = {
  let k = ui.pixel_scale()
  let lh = line_h(e)
  let gw = gutter_w(e)
  let px = pad_x(e)
  let py = pad_y(e)
  let mono = not e.single_line
  let size = e.font_size * k
  snaidhm.fill(x * k, y * k, w * k, h * k, 0.0, th.bg)
  // visible rows, and the lines they belong to
  let first_row = int.max(0, float.to_int(float.floor((e.scroll_y - py) / lh)))
  let last_row = float.to_int(float.ceil((e.scroll_y + h) / lh))
  let first = line_of_row(e, first_row)
  let last = int.min(list.len(e.lines) - 1, line_of_row(e, last_row))
  let text_x = x + gw + px - e.scroll_x
  let a = sel_start(e)
  let b = sel_end(e)
  let sel = has_selection(e)
  let row_y = (r: Int) => y + py + int.to_float(r) * lh - e.scroll_y
  snaidhm.push_clip(x * k, y * k, w * k, h * k)
  // active line (all of its rows)
  if focused and not sel and not e.single_line then {
    let r0 = row_start(e, e.cur.line)
    let r1 = row_start(e, e.cur.line) + list.len(line_breaks(e, e.cur.line))
    snaidhm.fill(x * k, row_y(r0) * k, w * k, int.to_float(r1 - r0) * lh * k, 0.0, th.active_line)
  } else ()
  // placeholder
  if e.single_line and list.len(e.lines) == 1 and list.len(e.lines[0]) == 0 and list.len(e.preedit) == 0 and e.placeholder != "" then
    tx.draw_style(e.placeholder, (x + px) * k, y * k, (w - px * 2.0) * k, h * k, size, false, false, th.placeholder)
  else ()
  var st = if e.syntax then state_at(e, first) else syn.initial()
  let baseline_off = (lh - tx.line_height(e.font_size, mono)) * 0.5 + tx.ascent(e.font_size, mono)
  snaidhm.push_clip((x + gw) * k, y * k, (w - gw) * k, h * k)
  for l in first...last {
    var cps = shown(e, e.lines[l])
    let on_cursor_line = l == e.cur.line
    let pre_n = if on_cursor_line then list.len(e.preedit) else 0
    if pre_n > 0 then cps = list.take(cps, e.cur.col) + e.preedit + list.drop(cps, e.cur.col) else ()
    let gs = tx.shape(cps, size, mono, false)
    // gx(i): x before code point i (device px)
    let ex = tx.edges(gs, list.len(cps))
    let gx = (i: Int) => ex[int.max(0, int.min(i, list.len(cps)))]
    let xs = list.map(ex, (v) => v / k)
    let bs = if wrapping(e) then breaks_of(xs, cps, wrap_avail(e)) else [0]
    let spans = if e.syntax then {
      let (sp, next) = syn.lex(e.lines[l], st)
      st = next
      sp
    } else []
    let n_all = list.len(cps)
    for j in 0..<list.len(bs) {
      let c0 = bs[j]
      let c1 = if j + 1 < list.len(bs) then bs[j + 1] else n_all
      let ly = if e.single_line then y + (h - lh) * 0.5 else row_y(row_start(e, l) + j)
      let sx = text_x * k - gx(c0)    // segment origin: its first glyph at text_x
      let last_seg = j + 1 == list.len(bs)
      if ly + lh >= y and ly <= y + h then {
        // selection (in original columns; preedit only exists without one)
        if sel and l >= a.line and l <= b.line then {
          let s0 = int.max(c0, if l == a.line then a.col else 0)
          let s1 = int.min(c1, if l == b.line then b.col else list.len(e.lines[l]))
          if s1 > s0 or (s1 == s0 and l < b.line and last_seg) then {
            let extra = if l < b.line and last_seg then 6.0 * k else 0.0
            snaidhm.fill(sx + gx(s0), ly * k, gx(s1) - gx(s0) + extra, lh * k, 2.0 * k, th.selection)
          } else ()
        } else ()
        // tokens
        let base = float.round(ly * k + baseline_off * k)
        if e.syntax then {
          for sp in spans {
            // shift spans after the cursor by the preedit length
            let s0 = if pre_n > 0 and sp.start >= e.cur.col then sp.start + pre_n else sp.start
            let s1 = if pre_n > 0 and sp.stop > e.cur.col then sp.stop + pre_n else sp.stop
            let r0 = int.max(s0, c0)
            let r1 = int.min(s1, c1)
            if r1 > r0 then tx.draw_run(tx.glyphs_in(gs, r0, r1), sx, base, size, th.colors[sp.kind]) else ()
          }
          if pre_n > 0 then {
            let r0 = int.max(e.cur.col, c0)
            let r1 = int.min(e.cur.col + pre_n, c1)
            if r1 > r0 then tx.draw_run(tx.glyphs_in(gs, r0, r1), sx, base, size, th.text) else ()
          } else ()
        } else {
          let st_i = if l < list.len(e.line_style) then e.line_style[l] else 0
          let col = if st_i > 0 and st_i < list.len(th.styles) then th.styles[st_i] else th.text
          tx.draw_run(tx.glyphs_in(gs, c0, c1), sx, base, size, col)
        }
        // preedit underline
        if pre_n > 0 then {
          let u0 = int.max(e.cur.col, c0)
          let u1 = int.min(e.cur.col + pre_n, c1)
          if u1 > u0 then snaidhm.fill(sx + gx(u0), (ly + lh - 3.0) * k, gx(u1) - gx(u0), 1.5 * k, 0.0, th.text) else ()
        } else ()
        // diagnostics underline
        for d in e.diags {
          if l >= d.line and l <= d.end_line then {
            let n = list.len(e.lines[l])
            let d0 = int.min(n, if l == d.line then d.col else 0)
            let d1 = int.min(n, if l == d.end_line then int.max(d.end_col, d0 + 1) else n)
            let r0 = int.max(d0, c0)
            let r1 = int.min(d1, c1)
            if r1 > r0 or (n == 0 and j == 0) then {
              let col = if d.severity == 0 then th.error else th.warning
              snaidhm.fill(sx + gx(r0), (ly + lh - 2.5) * k, float.max(4.0 * k, gx(r1) - gx(r0)), 2.0 * k, 1.0 * k, col)
            } else ()
          } else ()
        }
        // caret: on this segment if it starts here, or at the very end
        if focused and on_cursor_line then {
          let cc = e.cur.col + (if pre_n > 0 then preedit_cols(e) else 0)
          if (cc >= c0 and cc < c1) or (last_seg and cc >= c0) then {
            let cx = sx + gx(cc)
            snaidhm.fill(cx, (ly + 3.0) * k, 2.0 * k, (lh - 6.0) * k, 0.0, th.caret)
            ui.set_caret(cx / k, ly, 2.0, lh)
          } else ()
        } else ()
      } else ()
    }
  }
  snaidhm.pop_clip()
  // gutter: the number on a line's first row
  if not e.single_line and e.gutter then {
    snaidhm.fill(x * k, y * k, gw * k, h * k, 0.0, th.gutter_bg)
    for l in first...last {
      let ly = row_y(row_start(e, l))
      let label = int.to_string(l + 1)
      let lw = tx.width(label, size, true, false)
      let col = if l == e.cur.line then th.gutter_active else th.gutter_fg
      tx.draw_run(tx.shape(tx.codepoints(label), size, true, false), (x + gw - GUTTER_PAD) * k - lw, float.round(ly * k + baseline_off * k), size, col)
      // diagnostic marker
      var sev = 9
      for d in e.diags { if d.line == l then sev = int.min(sev, d.severity) else () }
      if sev < 9 then snaidhm.fill((x + 4.0) * k, (ly + lh * 0.5 - 3.0) * k, 6.0 * k, 6.0 * k, 3.0 * k, if sev == 0 then th.error else th.warning) else ()
    }
  } else ()
  snaidhm.pop_clip()
}

// The host reports the composition caret in UTF-8 bytes; convert to columns.
fn preedit_cols(e: Editor) -> Int = {
  var bytes_seen = 0
  var cols = 0
  for c in e.preedit {
    if bytes_seen < e.preedit_cursor then {
      bytes_seen = bytes_seen + (if c < 128 then 1 else if c < 2048 then 2 else if c < 65536 then 3 else 4)
      cols = cols + 1
    } else ()
  }
  cols
}

// ── View ──


// Functions called only from the view's closures are listed here so they are
// reachability roots: otherwise the wasm leg can drop them from its function
// table when `view` is called from a named fn of the app (almide/almide#3296).
let keep_paint = paint
let keep_fling = fling
let keep_with_rows = with_rows
let keep_rows_fresh = rows_fresh
let keep_wrapping = wrapping
let keep_visible = ensure_visible
let keep_pointer = pointer
let keep_wheel = wheel
let keep_key = key
let keep_text = text
let keep_focused = ui.is_focused
let keep_visible_text = visible_text
let keep_with_role = with_role

// A code editor (multi-line) view. `get` / `set` read and write the state.
pub fn view(key: String, get: () -> Editor, set: (Editor) -> Unit, th: Theme) -> v.View = with_role(key, get, set, th, 14)

// A single-line text field view (announced as a text field).
pub fn field(key: String, get: () -> Editor, set: (Editor) -> Unit, th: Theme) -> v.View = with_role(key, get, set, th, 5)

// `role` is passed in rather than read from the state: get() copies the
// whole buffer on the native leg, and the view is rebuilt every frame.
fn with_role(key: String, get: () -> Editor, set: (Editor) -> Unit, th: Theme, role: Int) -> v.View =
  v.custom(key, (x, y, w, h) => {
    let e = get()
    if e.view_w != w or e.view_h != h then set(ensure_visible(with_rows({ ...e, view_w: w, view_h: h }))) else ()
    if wrapping(get()) and not rows_fresh(get()) then set(with_rows(get())) else ()
    if e.fling_v != 0.0 then {
      let (e2, moving) = fling(get(), ui.clock_ms())
      set(e2)
      if moving then ui.invalidate() else ()
    } else ()
    paint(get(), ui.is_focused(key), th, x, y, w, h)
  })
    |> v.text_input(key)
    |> v.cursor(1)
    |> v.role(role)
    |> v.value(() => visible_text(get()))
    |> v.on_pointer((p) => { set(pointer(get(), p)); true })
    |> v.on_wheel((x, y, dx, dy) => { set(wheel(get(), dx, dy)); true })
    |> v.on_key((phase, code, mods) => {
      let (e2, handled) = key(get(), phase, code, mods)
      if handled then set(e2) else ()
      handled
    })
    |> v.on_text((kind, s, c) => {
      let e = get()
      if e.read_only then false else { set(text(e, kind, s, c)); true }
    })
