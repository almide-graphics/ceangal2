// Text: font loading, fallback, measurement and drawing.
//
// Fonts are bundled assets (assets/fonts, read through sys.asset_*) parsed
// once by snaidhm.font. Each codepoint is drawn with the first font in the
// style's fallback chain that has it (UI: ui → cjk → mono; code: mono →
// cjk → ui), after the font for its script when it has one (Arabic, Hebrew,
// Thai, Devanagari, Bengali, Tamil, symbols: loaded the first time a
// character needs them). Labels and paragraphs are joined and put in visual
// order first (self.bidi); Indic runs are shaped with their font's layout
// tables (self.indic); emoji (with their skin tones, ZWJ sequences, flags,
// keycaps) come from the colour emoji font, layer by layer.
// Glyphs are rasterised on first use into snaidhm's coverage
// atlas (shelf-packed); a full atlas is cleared at the start of the next
// frame and refilled lazily.

import snaidhm
import snaidhm.font as font
import snaidhm.otl as otl
import snaidhm.colr as colr
import self.layout as lay
import self.host.sys as sys
import self.bidi
import self.indic
import self.emoji_data as emoji

// Sizes are layout.Size: a second record type with the same fields makes the
// native leg emit the wrong struct (almide/almide#3283).
type Extent = lay.Size

let FONT_UI = 0
let FONT_UI_BOLD = 1
let FONT_MONO = 2
let FONT_CJK = 3
let FONT_ARABIC = 4
let FONT_HEBREW = 5
let FONT_THAI = 6
let FONT_EMOJI = 7
let FONT_DEVANAGARI = 8
let FONT_BENGALI = 9
let FONT_TAMIL = 10
let FONT_COLOR_EMOJI = 11

let FONT_FILES = ["fonts/ui.ttf", "fonts/ui-semibold.ttf", "fonts/mono.ttf", "fonts/cjk.ttf",
                  "fonts/arabic.ttf", "fonts/hebrew.ttf", "fonts/thai.ttf", "fonts/emoji.ttf",
                  "fonts/devanagari.ttf", "fonts/bengali.ttf", "fonts/tamil.ttf", "fonts/emoji-color.ttf"]

var fonts: List[font.Font] = []
var font_tried: List[Bool] = list.repeat(false, 12)

// A font was needed but has not arrived yet (the web loads fallback fonts
// on first use): the runtime redraws until it has.
var waiting = false

// Whether text drawn since the last call lacked a font still loading.
pub fn take_waiting() -> Bool = {
  let w = waiting
  waiting = false
  w
}

// The font for a script that the UI and code fonts lack (-1 = none).
fn script_font(cp: Int) -> Int =
  if (cp >= 0x0600 and cp <= 0x08FF) or (cp >= 0xFB50 and cp <= 0xFDFF) or (cp >= 0xFE70 and cp <= 0xFEFF) then FONT_ARABIC
  else if (cp >= 0x0590 and cp <= 0x05FF) or (cp >= 0xFB1D and cp <= 0xFB4F) then FONT_HEBREW
  else if cp >= 0x0E00 and cp <= 0x0E7F then FONT_THAI
  else if (cp >= 0x1F000 and cp <= 0x1FAFF) or (cp >= 0x2600 and cp <= 0x27BF) or (cp >= 0x2B00 and cp <= 0x2BFF)
    or (cp >= 0x2300 and cp <= 0x23FF) or cp == 0x3030 or cp == 0x303D then FONT_EMOJI
  else {
    let sc = indic.script_of(cp)
    if sc >= 0 then FONT_DEVANAGARI + sc else -1
  }

// Formatting characters that draw nothing: zero-width (non-)joiners and
// spaces, direction marks, variation selectors, emoji skin-tone modifiers
// outside an emoji (inside one, the colour font draws them), the byte-order
// mark.
fn invisible(cp: Int) -> Bool =
  (cp >= 0x200B and cp <= 0x200F) or (cp >= 0x202A and cp <= 0x202E) or (cp >= 0x2060 and cp <= 0x2064)
    or (cp >= 0xFE00 and cp <= 0xFE0F) or (cp >= 0x1F3FB and cp <= 0x1F3FF) or cp == 0xFEFF
    or (cp >= 0xE0100 and cp <= 0xE01EF)

fn load_asset(name: String) -> Bytes = {
  let key = bytes.from_string(name)
  let n = sys.asset_len(bytes.data_ptr(key), bytes.len(key))
  if n <= 0 then bytes.new(0)
  else {
    var buf = bytes.new(n)
    let _ = sys.asset_read(bytes.data_ptr(key), bytes.len(key), bytes.data_ptr(buf), n)
    buf
  }
}

fn font_at(slot: Int) -> font.Font = {
  if list.len(fonts) == 0 then fonts = list.map(FONT_FILES, (f) => font.empty_font()) else ()
  if not font_tried[slot] then {
    let f = font.parse(load_asset(FONT_FILES[slot]))
    fonts[slot] = f
    // A missing asset may still be loading (the web fetches fallback fonts
    // the first time they are needed): draw again on the next frame.
    if f.ok then font_tried[slot] = true else { waiting = true; sys.request_frame() }
    f
  } else fonts[slot]
}

fn chain(mono: Bool, bold: Bool) -> List[Int] =
  if mono then [FONT_MONO, FONT_CJK, FONT_UI]
  else if bold then [FONT_UI_BOLD, FONT_CJK, FONT_MONO]
  else [FONT_UI, FONT_CJK, FONT_MONO]

// ── UTF-8 ──

// The Unicode code points of `s` (decoded from UTF-8).
pub fn codepoints(s: String) -> List[Int] = {
  let b = bytes.from_string(s)
  let n = bytes.len(b)
  var out: List[Int] = []
  var i = 0
  while i < n {
    let c = bytes.read_u8(b, i)
    if c < 128 then { list.push(out, c); i = i + 1 }
    else if c < 224 and i + 1 < n then {
      list.push(out, (c % 32) * 64 + bytes.read_u8(b, i + 1) % 64)
      i = i + 2
    } else if c < 240 and i + 2 < n then {
      list.push(out, (c % 16) * 4096 + (bytes.read_u8(b, i + 1) % 64) * 64 + bytes.read_u8(b, i + 2) % 64)
      i = i + 3
    } else if i + 3 < n then {
      list.push(out, (c % 8) * 262144 + (bytes.read_u8(b, i + 1) % 64) * 4096 + (bytes.read_u8(b, i + 2) % 64) * 64 + bytes.read_u8(b, i + 3) % 64)
      i = i + 4
    } else { list.push(out, 0xFFFD); i = i + 1 }
  }
  out
}

// ── Shaping (cmap + advances + fallback) ──

// One positioned glyph: font slot, glyph id, x of its origin (px from the
// run start), y (px above the baseline), advance (px), its cluster (the
// index in the shaped code points of the first one it draws: a conjunct,
// ligature or emoji sequence draws several; a mark shares its base's), and
// its colour, 0xRRGGBBAA (-1: the text's; a colour emoji is a stack of
// glyphs with their own).
type Glyph = { slot: Int, gid: Int, x: Float, y: Float, advance: Float, cluster: Int, color: Int }

// ── Emoji ──

fn in_ranges(rs: List[(Int, Int)], cp: Int) -> Bool = {
  var lo = 0
  var hi = list.len(rs) - 1
  var hit = false
  while lo <= hi and not hit {
    let mid = (lo + hi) / 2
    let r = rs[mid]
    if cp < r.0 then hi = mid - 1 else if cp > r.1 then lo = mid + 1 else hit = true
  }
  hit
}

fn regional(cp: Int) -> Bool = cp >= 0x1F1E6 and cp <= 0x1F1FF
fn skin_tone(cp: Int) -> Bool = cp >= 0x1F3FB and cp <= 0x1F3FF
fn tag_char(cp: Int) -> Bool = cp >= 0xE0020 and cp <= 0xE007F
fn keycap_base(cp: Int) -> Bool = (cp >= 0x30 and cp <= 0x39) or cp == 0x23 or cp == 0x2A

// One emoji of a sequence from j: the character, then its variation
// selector, skin tone and tags.
fn emoji_element_end(cps: List[Int], j: Int) -> Int = {
  let n = list.len(cps)
  var k = j + 1
  if k < n and cps[k] == 0xFE0F then k = k + 1 else ()
  if k < n and skin_tone(cps[k]) then k = k + 1 else ()
  while k < n and tag_char(cps[k]) { k = k + 1 }
  k
}

// Where the emoji that starts at i ends (i: none starts there). An emoji is
// a character shown as emoji by default or asked for with U+FE0F, with its
// skin tone and tags, joined to more by ZWJ; a flag (two regional
// indicators); or a keycap (digit, #, * with U+20E3). U+FE0E asks for text.
fn emoji_end(cps: List[Int], i: Int) -> Int = {
  let n = list.len(cps)
  let cp = cps[i]
  let next = if i + 1 < n then cps[i + 1] else -1
  if cp < 0x23 or next == 0xFE0E then i
  else if keycap_base(cp) then {
    if next == 0x20E3 then i + 2
    else if next == 0xFE0F and i + 2 < n and cps[i + 2] == 0x20E3 then i + 3
    else i
  } else if cp < 0xA9 then i
  else if regional(cp) then (if regional(next) then i + 2 else i + 1)
  else if in_ranges(emoji.PRESENTATION, cp) or (in_ranges(emoji.PICTOGRAPHIC, cp) and (next == 0xFE0F or skin_tone(next))) then {
    var k = emoji_element_end(cps, i)
    while k + 1 < n and cps[k] == 0x200D and in_ranges(emoji.PICTOGRAPHIC, cps[k + 1]) { k = emoji_element_end(cps, k + 1) }
    k
  } else i
}

// The colour emoji font's sequence ligatures (its ccmp), found once.
var emoji_stage: List[otl.Entry] = []
var emoji_stage_made = false

// The glyphs of one emoji sequence in the colour font, after its ligatures:
// joiners and selectors the font did not fold in draw nothing.
fn emoji_glyphs(f: font.Font, cps: List[Int]) -> List[Int] = {
  let lay = otl.layout(f)
  if not emoji_stage_made then {
    let feat = (t: String) => { tag: otl.tag(t), mask: 1, manual: false, per_syllable: false }
    emoji_stage = otl.stage(f, lay, false, [], [feat("ccmp"), feat("locl"), feat("rlig"), feat("liga"), feat("clig"), feat("calt")])
    emoji_stage_made = true
  } else ()
  let buf = list.map(cps, (cp) => {
    let g = font.glyph_index(f, cp)
    { gid: g, cp: cp, cluster: 0, mask: 1, cat: 0, pos: 0, syl: 0, gclass: otl.glyph_class(f, lay, g), ligated: false, multiplied: false }
  })
  let out = otl.substitute(f, lay, emoji_stage, buf)
  list.map(list.filter(out, (g) => g.ligated or not (g.cp == 0x200D or g.cp == 0xFE0F or tag_char(g.cp) or g.cp == 0x20E3)), (g) => g.gid)
}

// Emoji sequences shaped already: by text.
var emoji_cache: Map[String, List[Int]] = map.new()

// Indic runs shaped already, in font units (shaping runs every lookup of
// the font): by font slot and text.
var indic_cache: Map[String, List[indic.Out]] = map.new()

fn shape_indic(slot: Int, script: Int, cps: List[Int]) -> List[indic.Out] = {
  let key = int.to_string(slot) + ":" + string.join(list.map(cps, (c) => int.to_string(c)), ",")
  match map.get(indic_cache, key) {
    some(gs) => gs,
    none => {
      let gs = indic.shape(font_at(slot), script, cps)
      if map.len(indic_cache) > 1000 then indic_cache = map.new() else ()
      map.insert(indic_cache, key, gs)
      gs
    },
  }
}

// Glyphs for `cps` at `size` px, with fallback fonts (UI → CJK → mono, or
// mono → CJK → UI for code) and x positions. Devanagari, Bengali and Tamil
// runs are shaped as a whole (self.indic); other text glyph by glyph.
pub fn shape(cps: List[Int], size: Float, mono: Bool, bold: Bool) -> List[Glyph] = {
  let ch = chain(mono, bold)
  var out: List[Glyph] = []
  var x = 0.0
  var i = 0
  let n = list.len(cps)
  while i < n {
    let cp = cps[i]
    let sc = if cp < 0x0900 then -1 else indic.script_of(cp)
    let slot_i = if sc >= 0 then FONT_DEVANAGARI + sc else -1
    let e_end = if cp < 0x23 or (cp < 0xA9 and not keycap_base(cp)) or sc >= 0 then i else emoji_end(cps, i)
    if e_end > i and font_at(FONT_COLOR_EMOJI).ok then {
      // an emoji: its glyphs (one, after the font's ligatures), each as its colour layers
      let f = font_at(FONT_COLOR_EMOJI)
      let k = size / f.units_per_em
      let seq = list.slice(cps, i, e_end)
      let key = string.join(list.map(seq, (c) => int.to_string(c)), ",")
      let gids = match map.get(emoji_cache, key) {
        some(gs) => gs,
        none => {
          let gs = emoji_glyphs(f, seq)
          if map.len(emoji_cache) > 1000 then emoji_cache = map.new() else ()
          map.insert(emoji_cache, key, gs)
          gs
        },
      }
      let ct = colr.tables(f)
      for gid in gids {
        let a = font.advance(f, gid) * k
        let ls = colr.layers(f, ct, gid)
        if list.len(ls) == 0 then list.push(out, { slot: FONT_COLOR_EMOJI, gid: gid, x: x, y: 0.0, advance: a, cluster: i, color: -1 })
        else {
          for l in ls { list.push(out, { slot: FONT_COLOR_EMOJI, gid: l.gid, x: x, y: 0.0, advance: a, cluster: i, color: l.color }) }
        }
        x = x + a
      }
      i = e_end
    } else if slot_i >= 0 and font_at(slot_i).ok then {
      var j = i + 1
      while j < n and (indic.script_of(cps[j]) == sc or indic.joins_run(cps[j])) { j = j + 1 }
      let f = font_at(slot_i)
      let k = size / f.units_per_em
      var adv = 0.0
      for g in shape_indic(slot_i, sc, list.slice(cps, i, j)) {
        list.push(out, { slot: slot_i, gid: g.gid, x: x + int.to_float(g.x) * k, y: int.to_float(g.y) * k,
                         advance: int.to_float(g.advance) * k, cluster: i + g.cluster, color: -1 })
        adv = adv + int.to_float(g.advance) * k
      }
      x = x + adv
      i = j
    } else if invisible(cp) then i = i + 1
    else {
      let sf = if cp < 0x0590 then -1 else script_font(cp)
      let order = if sf >= 0 then [sf] + ch else ch
      var slot = order[0]
      var gid = 0
      for s in order {
        if gid == 0 then {
          let f = font_at(s)
          let g = font.glyph_index(f, cp)
          if g != 0 then { slot = s; gid = g } else ()
        } else ()
      }
      // nothing has it: the primary font's missing-glyph box
      if gid == 0 then slot = ch[0] else ()
      let f = font_at(slot)
      let adv = if cp == 9 then font.advance(f, font.glyph_index(f, 32)) * 4.0 else font.advance(f, gid)
      let a = adv * size / f.units_per_em
      list.push(out, { slot: slot, gid: gid, x: x, y: 0.0, advance: a, cluster: i, color: -1 })
      x = x + a
      i = i + 1
    }
  }
  out
}

// x of each boundary between code points 0..n of the text `gs` was shaped
// from (n + 1 values): a cluster's start and end, and inside a cluster of
// several code points (a conjunct) evenly spaced between them.
pub fn edges(gs: List[Glyph], n: Int) -> List[Float] = {
  var out: List[Float] = []
  var x = 0.0
  var i = 0
  let m = list.len(gs)
  while i < m {
    let c = gs[i].cluster
    // code points before it that drew nothing sit where the last cluster ended
    while list.len(out) < int.min(c, n) { list.push(out, x) }
    // the cluster's glyphs: its start is its first spacing glyph's (marks do not widen it)
    var s = -1.0
    var e = x
    var j = i
    while j < m and gs[j].cluster == c {
      let g = gs[j]
      if g.advance > 0.0 and s < 0.0 then s = g.x else ()
      e = float.max(e, g.x + g.advance)
      j = j + 1
    }
    let s1 = if s < 0.0 then x else s
    // it reaches to the next cluster
    let c2 = if j < m then int.min(gs[j].cluster, n) else n
    let span = int.max(1, c2 - c)
    var k = c
    while k < c2 {
      list.push(out, s1 + (e - s1) * int.to_float(k - c) / int.to_float(span))
      k = k + 1
    }
    x = e
    i = j
  }
  while list.len(out) <= n { list.push(out, x) }
  out
}

// Where the caret may stop in `cps` (n + 1 values): not inside a cluster
// (a conjunct, an emoji sequence). Plain text stops everywhere.
pub fn stops(cps: List[Int]) -> List[Bool] = {
  let n = list.len(cps)
  if not list.any(cps, (c) => c >= 0x0300) then list.repeat(true, n + 1)
  else {
    var out = list.repeat(false, n + 1)
    out[0] = true
    out[n] = true
    for g in shape(cps, 16.0, false, false) { if g.cluster >= 0 and g.cluster <= n then out[g.cluster] = true else () }
    out
  }
}

// Where Backspace at `col` deletes back to: a whole emoji (with its skin
// tone or ZWJ sequence), otherwise one code point (one sign of a conjunct).
pub fn backspace_to(cps: List[Int], col: Int) -> Int =
  if col <= 0 then 0
  else {
    let st = stops(cps)
    var s = col - 1
    while s > 0 and not st[s] { s = s - 1 }
    if emoji_end(cps, s) >= col then s else col - 1
  }

// The glyphs of the code points from c0 up to c1 (by cluster; shaping
// keeps clusters in order, so this is a slice).
pub fn glyphs_in(gs: List[Glyph], c0: Int, c1: Int) -> List[Glyph] = list.slice(gs, first_at(gs, c0), first_at(gs, c1))

// The index of the first glyph whose cluster is at least c.
fn first_at(gs: List[Glyph], c: Int) -> Int = {
  var lo = 0
  var hi = list.len(gs)
  while lo < hi {
    let mid = (lo + hi) / 2
    if gs[mid].cluster < c then lo = mid + 1 else hi = mid
  }
  lo
}

// `s` as it is shown on one line: Arabic joined, right-to-left runs in
// visual order (self.bidi).
pub fn display(s: String) -> List[Int] = bidi.visual(codepoints(s))

// Line metrics of the primary font at `size`: ascent and full line height.
pub fn ascent(size: Float, mono: Bool) -> Float = {
  let f = font_at(if mono then FONT_MONO else FONT_UI)
  f.ascender * size / f.units_per_em
}

// The height of a line at `size`.
pub fn line_height(size: Float, mono: Bool) -> Float = {
  let f = font_at(if mono then FONT_MONO else FONT_UI)
  float.ceil((f.ascender - f.descender + f.line_gap) * size / f.units_per_em)
}

// The width of `s` on one line at `size`.
pub fn width(s: String, size: Float, mono: Bool, bold: Bool) -> Float =
  list.fold(shape(display(s), size, mono, bold), 0.0, (w, g) => float.max(w, g.x + g.advance))

// The size of `s` drawn on one line.
pub fn measure(s: String, size: Float, mono: Bool) -> Extent =
  { w: float.ceil(width(s, size, mono, false)), h: line_height(size, mono) }

// measure, with the bold font when `bold`.
pub fn measure_style(s: String, size: Float, mono: Bool, bold: Bool) -> Extent =
  { w: float.ceil(width(s, size, mono, bold)), h: line_height(size, mono) }

// ── Glyph atlas cache ──

type Cached = { ax: Int, ay: Int, w: Int, h: Int, left: Int, top: Int }

var cache: Map[Int, Cached] = map.new()
var shelf_x = 1
var shelf_y = 1
var shelf_h = 0
var atlas_full = false

fn cache_key(slot: Int, gid: Int, px: Float) -> Int =
  (slot * 65536 + gid) * 4096 + int.min(4095, float.to_int(px * 4.0 + 0.5))

// Call at the start of a frame: drops the atlas if it filled up last frame.
pub fn begin_frame() -> Unit =
  if atlas_full then {
    cache = map.new()
    shelf_x = 1
    shelf_y = 1
    shelf_h = 0
    atlas_full = false
  } else ()

fn glyph_entry(slot: Int, gid: Int, px: Float) -> Cached? = {
  let key = cache_key(slot, gid, px)
  match map.get(cache, key) {
    some(c) => some(c),
    none => {
      let bm = font.rasterize(font_at(slot), gid, px)
      let size = snaidhm.atlas_size()
      if bm.w == 0 then {
        let c = { ax: 0, ay: 0, w: 0, h: 0, left: 0, top: 0 }
        map.insert(cache, key, c)
        some(c)
      } else {
        if shelf_x + bm.w + 1 >= size then {
          shelf_x = 1
          shelf_y = shelf_y + shelf_h + 1
          shelf_h = 0
        } else ()
        if shelf_y + bm.h + 1 >= size then {
          atlas_full = true
          sys.request_frame()
          none
        } else {
          let c = { ax: shelf_x, ay: shelf_y, w: bm.w, h: bm.h, left: bm.left, top: bm.top }
          snaidhm.upload_coverage(shelf_x, shelf_y, bm.w, bm.h, bm.pixels)
          shelf_x = shelf_x + bm.w + 1
          shelf_h = int.max(shelf_h, bm.h)
          map.insert(cache, key, c)
          some(c)
        }
      }
    }
  }
}

// ── Drawing ──

// Draw `s` on one line inside (x, y, w, h) — physical pixels, vertically
// centred — at `size` physical px.
pub fn draw(s: String, x: Float, y: Float, w: Float, h: Float, size: Float, mono: Bool, c: snaidhm.Color) -> Unit =
  draw_style(s, x, y, w, h, size, mono, false, c)

// draw, with the bold font when `bold`.
pub fn draw_style(s: String, x: Float, y: Float, w: Float, h: Float, size: Float, mono: Bool, bold: Bool, c: snaidhm.Color) -> Unit = {
  let lh = line_height(size, mono)
  let baseline = float.round(y + (h - lh) * 0.5 + ascent(size, mono))
  draw_run(shape(display(s), size, mono, bold), x, baseline, size, c)
}

// Draw shaped glyphs with the pen starting at (x, baseline), physical px.
pub fn draw_run(gs: List[Glyph], x: Float, baseline: Float, size: Float, c: snaidhm.Color) -> Unit = {
  for g in gs {
    if g.gid != 0 then {
      match glyph_entry(g.slot, g.gid, size) {
        some(e) => {
          if e.w > 0 then {
            let gx = float.round(x + g.x) + int.to_float(e.left)
            let gy = float.round(baseline - g.y) - int.to_float(e.top)
            // a colour layer keeps its colour, faded with the text's alpha
            let col = if g.color < 0 then c
              else snaidhm.rgba(int.to_float(int.bshr(g.color, 24) % 256) / 255.0, int.to_float(int.bshr(g.color, 16) % 256) / 255.0,
                                int.to_float(int.bshr(g.color, 8) % 256) / 255.0, int.to_float(g.color % 256) / 255.0 * c.a)
            snaidhm.glyph(gx, gy, int.to_float(e.w), int.to_float(e.h), e.ax, e.ay, e.w, e.h, col)
          } else ()
        },
        none => (),
      }
    } else ()
  }
}
