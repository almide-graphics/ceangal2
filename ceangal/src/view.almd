// ceangal View — the declarative UI node.
//
// Create with text / col / row / spacer / custom, refine with modifiers
// (every modifier is View -> View), compose with ordinary functions:
//
//   v.col([v.text("Hello") |> v.font(20.0), button("Run", on_run)])
//     |> v.padding(16.0) |> v.gap(8.0) |> v.bg(theme.surface)
//
// Event handlers are closures stored on the node.

import snaidhm

type Color = snaidhm.Color

type Style = {
  width: Float, height: Float, width_pct: Float, height_pct: Float,
  min_width: Float, min_height: Float, max_width: Float, max_height: Float,
  pt: Float, pr: Float, pb: Float, pl: Float,
  mt: Float, mr: Float, mb: Float, ml: Float,
  grow: Float, shrink: Float, gap: Float,
  justify: Int, align: Int, align_self: Int,
  absolute: Bool,
  overlay: Bool,
  pos_top: Float, pos_right: Float, pos_bottom: Float, pos_left: Float,
  clip: Bool,
  wrap: Bool,
  bg: Color, fg: Color,
  radius: Float, opacity: Float,
  border_width: Float, border_color: Color,
  shadow_blur: Float, shadow_dy: Float, shadow_color: Color,
  font_size: Float, mono: Bool, bold: Bool,
  cursor: Int,
}

let TEXT = 0
let BOX = 1
let ROW = 2
let COL = 3
let CUSTOM = 4

let UNDEF = -1.0

let transparent: Color = { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
let white: Color = { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
let black: Color = { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }

let default_style: Style = {
  width: UNDEF, height: UNDEF, width_pct: UNDEF, height_pct: UNDEF,
  min_width: 0.0, min_height: 0.0, max_width: UNDEF, max_height: UNDEF,
  pt: 0.0, pr: 0.0, pb: 0.0, pl: 0.0,
  mt: 0.0, mr: 0.0, mb: 0.0, ml: 0.0,
  grow: 0.0, shrink: 0.0, gap: 0.0,
  justify: 0, align: 3, align_self: -1,
  absolute: false,
  overlay: false,
  pos_top: UNDEF, pos_right: UNDEF, pos_bottom: UNDEF, pos_left: UNDEF,
  clip: false,
  wrap: false,
  bg: transparent, fg: black,
  radius: 0.0, opacity: 1.0,
  border_width: 0.0, border_color: transparent,
  shadow_blur: 0.0, shadow_dy: 0.0, shadow_color: transparent,
  font_size: 14.0, mono: false, bold: false,
  cursor: 0,
}

// A pointer event as handlers see it: position relative to the node.
type Pointer = { phase: Int, x: Float, y: Float, w: Float, h: Float, buttons: Int, mods: Int, id: Int }

// A custom node paints itself into its laid-out rect (logical px) and may
// claim pointer events. `key` identifies it across frames.
type Painter = (Float, Float, Float, Float) -> Unit

type View = {
  kind: Int,
  children: List[View],
  content: String,
  style: Style,
  key: String,
  on_click: () -> Unit,
  clickable: Bool,
  on_pointer: (Pointer) -> Bool,
  pointer: Bool,
  on_wheel: (Float, Float, Float, Float) -> Bool,   // (x, y, dx, dy) in node px
  wheel: Bool,
  // A right-click or a long press: (x, y) in window px.
  on_context: (Float, Float) -> Unit,
  context: Bool,
  // A vertical scroll view (see scroll_y): children move up by the offset
  // ceangal keeps for `key`; wheel and touch drag scroll it.
  scroller: Bool,
  // Keyboard focus: a focusable node (it needs a key) receives key and text
  // events while focused; `text_input` asks the host for IME / soft keyboard.
  focusable: Bool,
  text_input: Bool,
  // Taps inside leave focus where it is (a key bar above the soft keyboard).
  keeps_focus: Bool,
  on_key: (Int, Int, Int) -> Bool,           // (phase, key, mods)
  on_text: (Int, String, Int) -> Bool,       // (kind, text, preedit cursor)
  on_focus: (Bool) -> Unit,
  paint: Painter,
  label: String,
  role: Int,
  // Text an assistive technology reads as the node's value (text fields,
  // editors). Called once per committed frame, so keep it cheap.
  value: () -> String,
  // State an assistive technology announces: 4 selected, 8 checked,
  // 16 disabled (docs/abi.md §4.4).
  states: Int,
}

// Default handlers are lambdas, not named fns: a named fn stored as a value
// walls the wasm leg here ("call:noop"; not reproduced in isolation yet).
fn node(kind: Int, children: List[View], content: String) -> View = {
  kind: kind, children: children, content: content, style: default_style, key: "",
  on_click: () => (), clickable: false, on_pointer: (p) => false, pointer: false,
  on_wheel: (x, y, dx, dy) => false, wheel: false, on_context: (x, y) => (), context: false, scroller: false,
  focusable: false, text_input: false, keeps_focus: false,
  on_key: (phase, key, mods) => false, on_text: (kind, t, c) => false, on_focus: (f) => (),
  paint: (x, y, w, h) => (), label: "", role: 0, value: () => "", states: 0,
}

// ── Constructors ──

// One line of text in the style's font, size and colour.
pub fn text(content: String) -> View = node(TEXT, [], content)
// Children stacked top to bottom.
pub fn col(children: List[View]) -> View = node(COL, children, "")
// Children side by side, left to right.
pub fn row(children: List[View]) -> View = node(ROW, children, "")
// A row whose children flow onto further lines when they do not fit.
pub fn wrap_row(children: List[View]) -> View = { ...node(ROW, children, ""), style: { ...default_style, wrap: true, align: 0 } }
// A container of one child (to give it padding, a background, a border).
pub fn box(child: View) -> View = node(COL, [child], "")
// The view with one more child after its others (on top of them, when it
// is absolute).
pub fn with_child(v: View, child: View) -> View = { ...v, children: v.children + [child] }
// A box with nothing in it: a swatch, a divider, a placeholder.
pub fn empty() -> View = node(BOX, [], "")
// Takes the free space along a row or column, pushing what follows to the end.
pub fn spacer() -> View = node(BOX, [], "") |> grow(1.0)
// A view that paints itself: `paint(x, y, w, h)` gets its laid-out rect in
// logical px each frame (draw with snaidhm, in physical px: × ceangal.pixel_scale()).
pub fn custom(key: String, paint: Painter) -> View = { ...node(CUSTOM, [], ""), key: key, paint: paint }

// ── Size ──

// Width in logical px.
pub fn w(v: View, width: Float) -> View = { ...v, style: { ...v.style, width: width } }
// Height in logical px.
pub fn h(v: View, height: Float) -> View = { ...v, style: { ...v.style, height: height } }
// Width and height in logical px.
pub fn size(v: View, width: Float, height: Float) -> View = { ...v, style: { ...v.style, width: width, height: height } }
// Width as a percentage of the parent's inner width.
pub fn w_pct(v: View, pct: Float) -> View = { ...v, style: { ...v.style, width_pct: pct } }
// Height as a percentage of the parent's inner height.
pub fn h_pct(v: View, pct: Float) -> View = { ...v, style: { ...v.style, height_pct: pct } }
// All of the parent's inner width and height.
pub fn fill(v: View) -> View = { ...v, style: { ...v.style, width_pct: 100.0, height_pct: 100.0 } }
// At least this wide (logical px), whatever flex does.
pub fn min_w(v: View, x: Float) -> View = { ...v, style: { ...v.style, min_width: x } }
// At least this tall.
pub fn min_h(v: View, x: Float) -> View = { ...v, style: { ...v.style, min_height: x } }
// At most this wide.
pub fn max_w(v: View, x: Float) -> View = { ...v, style: { ...v.style, max_width: x } }
// At most this tall.
pub fn max_h(v: View, x: Float) -> View = { ...v, style: { ...v.style, max_height: x } }

// ── Spacing ──

// Space inside the view on all four sides.
pub fn padding(v: View, all: Float) -> View = { ...v, style: { ...v.style, pt: all, pr: all, pb: all, pl: all } }
// Space inside on the left and right.
pub fn px(v: View, x: Float) -> View = { ...v, style: { ...v.style, pl: x, pr: x } }
// Space inside at the top and bottom.
pub fn py(v: View, y: Float) -> View = { ...v, style: { ...v.style, pt: y, pb: y } }
// Space inside, per side.
pub fn pad(v: View, top: Float, right: Float, bottom: Float, left: Float) -> View =
  { ...v, style: { ...v.style, pt: top, pr: right, pb: bottom, pl: left } }
// Space outside the view on all four sides.
pub fn margin(v: View, all: Float) -> View = { ...v, style: { ...v.style, mt: all, mr: all, mb: all, ml: all } }
// Space outside on the left and right.
pub fn mx(v: View, x: Float) -> View = { ...v, style: { ...v.style, ml: x, mr: x } }
// Space outside at the top and bottom.
pub fn my(v: View, y: Float) -> View = { ...v, style: { ...v.style, mt: y, mb: y } }
// Space between a row's or column's children.
pub fn gap(v: View, g: Float) -> View = { ...v, style: { ...v.style, gap: g } }

// ── Flex ──

// How much of the free space along the parent's axis this view takes
// (relative to its siblings' grow; 0 = none).
pub fn grow(v: View, g: Float) -> View = { ...v, style: { ...v.style, grow: g } }
// How much this view gives up when its siblings do not fit (0 = never
// smaller than its content).
pub fn shrink(v: View, s: Float) -> View = { ...v, style: { ...v.style, shrink: s } }
// Main-axis distribution and cross-axis alignment. (Variants rather than Int
// constants: a dependency's top-level `let` cannot be referenced from an app
// on the wasm leg yet — almide/almide#3286.)
type Justify = | Start | End | Center | Between | Around | Evenly
type Align = | Top | Bottom | Middle | Stretch

fn justify_code(j: Justify) -> Int = match j { Start => 0, End => 1, Center => 2, Between => 3, Around => 4, Evenly => 5 }
fn align_code(a: Align) -> Int = match a { Top => 0, Bottom => 1, Middle => 2, Stretch => 3 }

// Where a row's or column's children sit along its axis.
pub fn justify(v: View, j: Justify) -> View = { ...v, style: { ...v.style, justify: justify_code(j) } }
// Where a row's or column's children sit across its axis (Stretch fills it).
pub fn align(v: View, a: Align) -> View = { ...v, style: { ...v.style, align: align_code(a) } }
// This view's own alignment across its parent's axis.
pub fn align_self(v: View, a: Align) -> View = { ...v, style: { ...v.style, align_self: align_code(a) } }
// Children centred both ways.
pub fn center(v: View) -> View = { ...v, style: { ...v.style, justify: 2, align: 2 } }

// ── Position ──

// Out of the flow: placed in the parent by top / bottom / left / right
// (both of a pair given and no size: it spans between them).
pub fn absolute(v: View) -> View = { ...v, style: { ...v.style, absolute: true } }
// Over everything: placed like `absolute` (in its parent, by top / left…),
// but drawn after the whole window, given pointer input first, and not
// clipped by its ancestors. For popups: a dropdown's list, a menu.
pub fn overlay(v: View) -> View = { ...v, style: { ...v.style, absolute: true, overlay: true } }
// With absolute: distance from the parent's top edge.
pub fn top(v: View, t: Float) -> View = { ...v, style: { ...v.style, pos_top: t } }
// With absolute: distance from the parent's bottom edge.
pub fn bottom(v: View, b: Float) -> View = { ...v, style: { ...v.style, pos_bottom: b } }
// With absolute: distance from the parent's left edge.
pub fn left(v: View, l: Float) -> View = { ...v, style: { ...v.style, pos_left: l } }
// With absolute: distance from the parent's right edge.
pub fn right(v: View, r: Float) -> View = { ...v, style: { ...v.style, pos_right: r } }
// Children do not draw outside this view's rect.
pub fn clip(v: View) -> View = { ...v, style: { ...v.style, clip: true } }
// Text that wraps onto as many lines as its width needs (breaking where
// Unicode's line breaking rules allow; a "\n" starts a new line).
pub fn wrapped(v: View) -> View = { ...v, style: { ...v.style, wrap: true } }

// ── Paint ──

// The background colour.
pub fn bg(v: View, c: Color) -> View = { ...v, style: { ...v.style, bg: c } }
// The text colour.
pub fn color(v: View, c: Color) -> View = { ...v, style: { ...v.style, fg: c } }
// Corner radius in logical px.
pub fn rounded(v: View, r: Float) -> View = { ...v, style: { ...v.style, radius: r } }
// 0 (invisible) to 1, for the view and its children.
pub fn opacity(v: View, o: Float) -> View = { ...v, style: { ...v.style, opacity: o } }
// A border `width` logical px wide, inside the view's rect.
pub fn border(v: View, width: Float, c: Color) -> View = { ...v, style: { ...v.style, border_width: width, border_color: c } }
// A drop shadow: blur radius, vertical offset and colour.
pub fn shadow(v: View, blur: Float, dy: Float, c: Color) -> View =
  { ...v, style: { ...v.style, shadow_blur: blur, shadow_dy: dy, shadow_color: c } }

// ── Text ──

// Text size in logical px.
pub fn font(v: View, size: Float) -> View = { ...v, style: { ...v.style, font_size: size } }
// The monospace font.
pub fn mono(v: View) -> View = { ...v, style: { ...v.style, mono: true } }
// The semibold font.
pub fn bold(v: View) -> View = { ...v, style: { ...v.style, bold: true } }

// ── Interaction ──

// Run `f` on a click or tap (press and release on the view); the pointer
// becomes a hand over it. Give it a role and label for screen readers.
pub fn on_click(v: View, f: () -> Unit) -> View = { ...v, on_click: f, clickable: true, style: { ...v.style, cursor: 2 } }
// Every pointer event over the view (and, once pressed, until release):
// return true to take it (drags, sliders). Positions are relative to the view.
pub fn on_pointer(v: View, f: (Pointer) -> Bool) -> View = { ...v, on_pointer: f, pointer: true }
// Scroll wheel / trackpad deltas over the view: f(x, y, dx, dy); true = taken.
pub fn on_wheel(v: View, f: (Float, Float, Float, Float) -> Bool) -> View = { ...v, on_wheel: f, wheel: true }
// A right-click on the view, or a long press on a touch screen (0.5 s
// without moving): f(x, y), the point in window logical px. Its release
// does nothing else.
pub fn on_context(v: View, f: (Float, Float) -> Unit) -> View = { ...v, on_context: f, context: true }

// Make a view scroll its content vertically when it is taller than the view
// (give it a height or max height). `key` keeps the offset across frames.
pub fn scroll_y(v: View, key: String) -> View = { ...v, key: key, scroller: true, style: { ...v.style, clip: true } }
// Can hold keyboard focus, under key `k` (Tab moves between such views;
// on_key receives keys while focused).
pub fn focusable(v: View, k: String) -> View = { ...v, key: k, focusable: true }
// Focusable and takes text: the host shows the IME and, on phones, the
// soft keyboard (on_text receives the text).
pub fn text_input(v: View, k: String) -> View = { ...v, key: k, focusable: true, text_input: true }
// Taps inside leave focus where it is (a key bar above the soft keyboard).
pub fn keeps_focus(v: View) -> View = { ...v, keeps_focus: true }
// Keys while this view has focus: f(phase, code, mods), true = handled
// (phase 0 down, 1 up, 2 repeat; codes in docs/abi.md §2.2).
pub fn on_key(v: View, f: (Int, Int, Int) -> Bool) -> View = { ...v, on_key: f }
// Text while this view has focus: f(kind, text, preedit cursor), true =
// handled (kind 0 commit, 1 IME preedit, 2 preedit end, 3 paste).
pub fn on_text(v: View, f: (Int, String, Int) -> Bool) -> View = { ...v, on_text: f }
// Called with true when the view gains focus, false when it loses it.
pub fn on_focus(v: View, f: (Bool) -> Unit) -> View = { ...v, on_focus: f }
// The mouse cursor over the view: 0 arrow, 1 text, 2 hand, 3 grab,
// 4 left-right resize, 5 up-down resize.
pub fn cursor(v: View, kind: Int) -> View = { ...v, style: { ...v.style, cursor: kind } }
// Name the view: focus, scroll offsets, rect_of and hover go by keys.
pub fn key(v: View, k: String) -> View = { ...v, key: k }

// ── Accessibility ──

// What a screen reader says for the view (and what tests click by).
pub fn label(v: View, l: String) -> View = { ...v, label: l }
// What a screen reader calls the view: 3 button, 4 text, 5 text field,
// 6 list, 7 list item, 8 tab, 9 tab list, 10 heading, 11 link, 12 checkbox,
// 13 image, 14 code editor, 15 switch, 16 slider, 17 dialog, 18 radio button,
// 19 radio group, 20 progress bar.
pub fn role(v: View, r: Int) -> View = { ...v, role: r }
// Leave the view out of the accessibility tree (a parent speaks for it, as
// the words of a wrapped paragraph).
pub fn a11y_hidden(v: View) -> View = { ...v, role: -1 }
// The value a screen reader reads (a field's text, a slider's number);
// called once per committed frame, so keep it cheap.
pub fn value(v: View, f: () -> String) -> View = { ...v, value: f }

fn with_state(v: View, bit: Int, on: Bool) -> View = {
  let has = (v.states / bit) % 2 == 1
  { ...v, states: if on and not has then v.states + bit else if not on and has then v.states - bit else v.states }
}

// Announced as checked (a checkbox, switch or radio button: give it that role).
pub fn checked(v: View, on: Bool) -> View = with_state(v, 8, on)
// Announced as the selected one (a tab, a list item, a segment).
pub fn selected(v: View, on: Bool) -> View = with_state(v, 4, on)
// Announced as unavailable. It only marks the view: leave out its handlers
// too (the ceangal.widgets controls do).
pub fn disabled(v: View, on: Bool) -> View = with_state(v, 16, on)
// Announced as opening a popup, and whether it is open (a dropdown, a menu button).
pub fn expanded(v: View, open: Bool) -> View = with_state(with_state(v, 32, true), 64, open)
