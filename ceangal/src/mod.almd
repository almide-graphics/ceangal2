// ceangal — app runtime: event dispatch, layout, paint, hit testing.
//
// An app is a record of closures. `run` stores it and enters the host loop;
// the host then calls `dispatch` (docs/abi.md §2) for every event. Each
// handled event marks the UI dirty; the next frame event rebuilds the view
// tree, lays it out and paints it through snaidhm.

import snaidhm
import math
import self.view as v
import self.layout as lay
import self.text as tx
import self.host.sys as sys
import self.host.text_input as text_input
import self.host.clipboard as clip
import self.host.file as file
import self.host.a11y as a11y

// An app: its view (called whenever the UI is redrawn) and handlers for
// what views do not handle themselves. Build it with `app(view)` and the
// setters below, start it with `run`:
//
//   effect fn main() -> Unit = ceangal.run(ceangal.app(view) |> ceangal.background(BG))
type App = {
  view: () -> v.View,
  background: snaidhm.Color,
  on_key: (Int, Int, Int) -> Bool,     // (phase, key, mods) -> handled
  on_text: (Int, String) -> Bool,      // (kind, text) -> handled
  on_frame: (Float) -> Bool,           // (time ms) -> wants another frame
  on_result: (Int, Int, Bytes) -> Unit, // async request (id, status, body)
}

// An app that draws `view()` on a white background and handles no keys,
// text, frames or results itself.
pub fn app(view: () -> v.View) -> App = {
  view: view,
  background: snaidhm.hex(0xFFFFFF),
  on_key: (phase, key, mods) => false,
  on_text: (kind, s) => false,
  on_frame: (t) => false,
  on_result: (id, status, body) => (),
}

// The colour behind the views (and under the safe-area insets).
pub fn background(a: App, c: snaidhm.Color) -> App = { ...a, background: c }
// Keys: f(phase, key, mods), true = handled. Phase 0 down, 1 up, 2 repeat;
// key codes in docs/abi.md §2.2; read mods with has_shift, is_shortcut….
// Shortcuts (Cmd/Ctrl+…) reach the app first, except the editing ones a
// text view owns (select all, copy, cut, undo, redo); other keys only when
// the focused view did not take them.
pub fn on_key(a: App, f: (Int, Int, Int) -> Bool) -> App = { ...a, on_key: f }
// Text the focused view did not take: f(kind, text), true = handled. Kind
// 0 commit, 1 IME preedit, 2 preedit end, 3 paste.
pub fn on_text(a: App, f: (Int, String) -> Bool) -> App = { ...a, on_text: f }
// Called every frame with the clock (ms) while it returns true: animations.
pub fn on_frame(a: App, f: (Float) -> Bool) -> App = { ...a, on_frame: f }
// The answer to an asynchronous host request (an HTTP fetch, a file picker):
// f(id, status, body).
pub fn on_result(a: App, f: (Int, Int, Bytes) -> Unit) -> App = { ...a, on_result: f }

// Change the running app's background (the colour around the views, e.g.
// under the safe-area insets) — for apps that switch themes.
pub fn set_background(c: snaidhm.Color) -> Unit = { current = { ...current, background: c } }

// ── Runtime state ──

var current: App = app(() => v.empty())
var width = 1.0
var height = 1.0
var scale = 1.0
// Safe-area insets (logical px; notch, home indicator, system bars): the app
// is laid out inside them, the background fills the whole surface.
var safe_t = 0.0
var safe_r = 0.0
var safe_b = 0.0
var safe_l = 0.0
// The on-screen keyboard's height, which the host reports (event 11's a / 2;
// safe_b includes it while it is up).
var kb_height = 0.0
var dark_mode = false
var dirty = true
var started = false

// The last laid-out frame, in paint order, for hit testing.
var frame_views: List[v.View] = []
var frame_sizes: List[Int] = []
// The height a wrapping text needs at the width it got: by text and style
// (a second layout pass uses it).
var wrap_heights: Map[String, Float] = map.new()
var frame_rects: List[lay.LayoutRect] = []
// Which frame nodes are inside an overlay (v.overlay: drawn last, hit first).
var frame_over: List[Bool] = []
// Overlays met while painting, painted after the rest: (view, frame index).
var overlays: List[(v.View, Int)] = []

// The open popup (a dropdown's list, a menu): its control's key ("" =
// none) and the highlighted entry.
var popup_key = ""
var popup_hi = -1
// The press that closed a popup: its release does nothing either.
var press_swallowed = false
var pressed = -1
// The key of the view under the mouse (the topmost with a key and a click
// or pointer handler), and of the one being pressed: is_hovered / is_pressed.
var hover_key = ""
var pressed_key = ""
var hover_cursor = 0
var last_x = 0.0
var last_y = 0.0
// Scroll views: offset, its maximum (from the last layout) and momentum, by key.
var scroll_keys: List[String] = []
var scroll_offs: List[Float] = []
var scroll_max: List[Float] = []
var scroll_vel: List[Float] = []
var scroll_t = 0.0
// The scroll view a touch is dragging (index into scroll_keys, -1 none).
var drag_scroll = -1
var drag_active = false
var drag_y0 = 0.0
var drag_off0 = 0.0
var drag_ly = 0.0
var drag_lt = 0.0
var drag_v = 0.0

// Where the current touch went down: a touch moves focus only when it ends
// near there (a tap), so scrolling does not raise the soft keyboard.
var press_x = 0.0
var press_y = 0.0

// Keyboard focus, by view key ("" = none), and the caret the focused text
// input reported while painting (logical px; w < 0 = none).
var focus_key = ""
var caret_x = 0.0
var caret_y = 0.0
var caret_w = -1.0
var caret_h = 0.0
var ime_active = false
var ime_rect: List[Float] = [0.0, 0.0, 0.0, 0.0]
var platform_id = 0
// Phones and tablets: the on-screen keyboard opens when a finger taps a text
// field, not when the app focuses one by itself (it would cover the screen).
var kb_tapped = false
var frame_time = 0.0
// a11y values (editor text…) are refreshed at most every A11Y_VALUE_MS; in
// between the last ones are reused, and one trailing frame catches up.
let A11Y_VALUE_MS = 250.0
var a11y_values_at = -1000000.0
var a11y_values_focus = "-"
var a11y_cache: List[(String, String)] = []

// Start the app: the host opens its window (or page, or activity) and runs
// the event loop; on the desktop this returns when the window closes.
pub fn run(a: App) -> Unit = {
  current = a
  sys.run()
}

// Ask for a new frame (state changed outside an event handler).
pub fn invalidate() -> Unit = {
  dirty = true
  sys.request_frame()
}

// ── Toasts ──

let TOAST_MS = 4000.0
var toast_text = ""
var toast_until = 0.0

// Show `text` for a few seconds (of frame time: the host's clock) in a
// bubble at the bottom of the window.
// Screen readers announce it: it is a status (role 26), a polite live
// region.
pub fn toast(text: String) -> Unit = {
  toast_text = text
  toast_until = frame_time + TOAST_MS
  sys.request_frame_after(TOAST_MS + 20.0)
  invalidate()
}

fn toast_view() -> v.View =
  v.row([
    v.text(toast_text) |> v.wrapped() |> v.font(14.0) |> v.color(snaidhm.rgba(1.0, 1.0, 1.0, 1.0))
      |> v.pad(10.0, 16.0, 10.0, 16.0) |> v.bg(snaidhm.rgba(0.13, 0.14, 0.18, 0.94)) |> v.rounded(10.0)
      |> v.shadow(12.0, 4.0, snaidhm.rgba(0.0, 0.0, 0.0, 0.3)) |> v.max_w(480.0) |> v.role(26),
  ]) |> v.justify(v.Center) |> v.overlay() |> v.left(16.0) |> v.right(16.0) |> v.bottom(24.0 + safe_b) |> v.role(-1)

// ── Popups ──

// Open the popup of the control with `key` (one at a time), with entry
// `index` highlighted (-1 = none). A press outside the popup and its
// control closes it.
pub fn open_popup(key: String, index: Int) -> Unit = {
  popup_key = key
  popup_hi = index
  invalidate()
}

// Open the popup of `key` at the point (x, y) in window logical px (a
// context menu), with entry `index` highlighted.
pub fn open_popup_at(key: String, index: Int, x: Float, y: Float) -> Unit = {
  popup_x = x
  popup_y = y
  open_popup(key, index)
}

var popup_x = 0.0
var popup_y = 0.0

// Where open_popup_at opened the popup (window logical px).
pub fn popup_point() -> (Float, Float) = (popup_x, popup_y)

// Close the open popup.
pub fn close_popup() -> Unit = {
  if popup_key != "" then { popup_key = ""; popup_hi = -1; invalidate() } else ()
}

// Whether the control with `key` has its popup open.
pub fn popup_open(key: String) -> Bool = key != "" and key == popup_key

// The highlighted entry of the open popup (-1 = none).
pub fn popup_highlight() -> Int = popup_hi

// Highlight entry `index` of the open popup.
pub fn set_popup_highlight(index: Int) -> Unit = { popup_hi = index; invalidate() }

// ── Focus ──

// Give keyboard focus to the focusable view with `key` ("" = none).
pub fn focus(key: String) -> Unit = {
  // focus leaving a control closes its popup
  if popup_key != "" and key != popup_key then close_popup() else ()
  if key != focus_key then {
    let old = find_key(focus_key)
    focus_key = key
    if old >= 0 then frame_views[old].on_focus(false) else ()
    let cur = find_key(key)
    if cur >= 0 then frame_views[cur].on_focus(true) else ()
    invalidate()
  } else ()
}

// The focused view's key ("" = none).
pub fn focused() -> String = focus_key

// The view with `key` has focus.
pub fn is_focused(key: String) -> Bool = key != "" and key == focus_key

// The focused text input reports its caret while painting (logical px), so
// the host can place the IME candidate window and scroll the soft keyboard.
pub fn set_caret(x: Float, y: Float, w: Float, h: Float) -> Unit = {
  caret_x = x
  caret_y = y
  caret_w = w
  caret_h = h
}

// Cmd on Apple platforms, Ctrl elsewhere.
pub fn is_shortcut(mods: Int) -> Bool = {
  if platform_id == 0 then platform_id = sys.platform() else ()
  let apple = platform_id == 2 or platform_id == 5 or platform_id == 17
  if apple then mods % 16 >= 8 else (mods / 2) % 2 == 1
}

// The modifier bits of a key event.
pub fn has_shift(mods: Int) -> Bool = mods % 2 == 1
pub fn has_alt(mods: Int) -> Bool = (mods / 4) % 2 == 1

fn find_key(key: String) -> Int = {
  var found = -1
  if key != "" then {
    for i in 0..<list.len(frame_views) {
      if frame_views[i].key == key then found = i else ()
    }
  } else ()
  found
}

// Move focus to the next (or previous) focusable view in paint order.
fn cycle_focus(back: Bool) -> Unit = {
  var keys: List[String] = []
  for fv in frame_views { if fv.focusable and fv.key != "" then list.push(keys, fv.key) else () }
  let n = list.len(keys)
  if n > 0 then {
    var at = -1
    for i in 0..<n { if keys[i] == focus_key then at = i else () }
    let next = if at < 0 then (if back then n - 1 else 0) else if back then (at + n - 1) % n else (at + 1) % n
    focus(keys[next])
  } else ()
}

// The on-screen keyboard is up (phones and tablets, a text input focused by
// a tap, and the keyboard not put away with Back / the dismiss key): apps
// can show a key bar above it.
pub fn soft_keyboard() -> Bool = ime_active and touch_platform() and kb_height > 40.0

fn touch_platform() -> Bool = {
  if platform_id == 0 then platform_id = sys.platform() else ()
  platform_id == 5 or platform_id == 6
}

fn update_ime() -> Unit = {
  let fi = find_key(focus_key)
  let want = fi >= 0 and frame_views[fi].text_input and caret_w >= 0.0 and (kb_tapped or not touch_platform())
  if want then {
    let changed = not ime_active or ime_rect[0] != caret_x or ime_rect[1] != caret_y or ime_rect[3] != caret_h
    if changed then {
      if ime_active then text_input.ime_update(caret_x, caret_y, float.max(1.0, caret_w), caret_h)
      else text_input.ime_begin(caret_x, caret_y, float.max(1.0, caret_w), caret_h)
      ime_active = true
      ime_rect = [caret_x, caret_y, caret_w, caret_h]
    } else ()
  } else if ime_active then {
    text_input.ime_end()
    ime_active = false
  } else ()
}

// The area the app is laid out in (inside the safe-area insets).
pub fn viewport_width() -> Float = float.max(1.0, width - safe_l - safe_r)
pub fn viewport_height() -> Float = float.max(1.0, height - safe_t - safe_b)
// The system's dark appearance (it changes while the app runs: a new frame
// follows).
pub fn is_dark() -> Bool = dark_mode

var prefer_less_motion = false
var prefer_contrast = false
var text_scale = 1.0

// The system's text size as a factor of the normal one (Dynamic Type,
// Android's font scale, the browser's font size; 0.8–2.0). Text views and
// editors are drawn that much larger.
pub fn font_scale() -> Float = text_scale
// The system asks for less motion: scrolling stops when the finger lifts,
// and apps should skip animations.
pub fn reduce_motion() -> Bool = prefer_less_motion
// The system asks for more contrast: the standard themes strengthen borders
// and secondary text.
pub fn high_contrast() -> Bool = prefer_contrast

// `view` with every text's size × the font scale.
fn scale_text(view: v.View, k: Float) -> v.View = {
  var kids: List[v.View] = []
  for c in view.children { list.push(kids, scale_text(c, k)) }
  { ...view, children: kids, style: { ...view.style, font_size: view.style.font_size * k } }
}
// Physical pixels per logical px.
pub fn pixel_scale() -> Float = scale
// A monotonic clock in ms.
pub fn clock_ms() -> Float = sys.now_ms()

// ── Dispatch (docs/abi.md §2) ──

// The host's entry point: every event comes through here (docs/abi.md §2).
// Apps do not call it; tests can, to drive an app without a host.
pub fn dispatch(kind: Int, a: Int, b: Int, x: Float, y: Float, z: Float, w: Float) -> Int =
  if kind == 1 or kind == 2 then {
    width = x
    height = y
    scale = if z > 0.0 then z else 1.0
    started = true
    invalidate()
    0
  } else if kind == 3 then frame(x)
  else if kind == 4 then {
    if a == 0 then keyboard_used = false else ()
    if pointer(a, b, x, y, float.to_int(z), float.to_int(w)) then 1 else 0
  }
  else if kind == 5 then { if wheel(x, y, z, w, b) then 1 else 0 }
  else if kind == 6 then { keyboard_used = true; if key(a, b, float.to_int(x)) then 1 else 0 }
  else if kind == 7 then {
    let t = event_string()
    let fi = find_key(focus_key)
    let by_view = fi >= 0 and frame_views[fi].on_text(a, t, b)
    let handled = by_view or current.on_text(a, t)
    if handled then invalidate() else ()
    if handled then 1 else 0
  } else if kind == 10 then {
    current.on_result(a, b, event_bytes())
    invalidate()
    0
  } else if kind == 9 then { if a == 1 then invalidate() else (); 0 }
  else if kind == 11 then {
    dark_mode = int.band(a, 1) == 1
    kb_height = int.to_float(a / 2)
    // b: 1 reduce motion, 2 high contrast, + 256 × the text scale in %
    prefer_less_motion = int.band(b, 1) != 0
    prefer_contrast = int.band(b, 2) != 0
    let pct = b / 256
    text_scale = if pct > 0 then float.max(0.8, float.min(2.0, int.to_float(pct) / 100.0)) else 1.0
    safe_t = float.max(0.0, x)
    safe_r = float.max(0.0, y)
    safe_b = float.max(0.0, z)
    safe_l = float.max(0.0, w)
    invalidate()
    0
  }
  else if kind == 12 then { if a11y_action(a, b) then 1 else 0 }
  else 0

fn key(phase: Int, code: Int, mods: Int) -> Bool = {
  let fi = find_key(focus_key)
  // App shortcuts (Cmd/Ctrl+…) win over the focused widget, except the
  // editing ones a text widget owns (select all, copy, cut, undo, redo).
  let editing = code == 20 or code == 21 or code == 23 or code == 24 or code == 25
  var handled = is_shortcut(mods) and not editing and current.on_key(phase, code, mods)
  if not handled then handled = fi >= 0 and frame_views[fi].on_key(phase, code, mods) else ()
  if not handled then handled = current.on_key(phase, code, mods) else ()
  if not handled and phase != 1 and code == 2 then {
    cycle_focus(has_shift(mods))
    handled = true
  } else ()
  // the menu key or Shift+F10: the context menu of the focused view (or of
  // the nearest view around it that has one), opened at its lower left
  if not handled and phase == 0 and fi >= 0 and (code == 61 or (code == 49 and has_shift(mods))) then {
    var c = -1
    for j in 0..<int.min(fi + 1, list.len(frame_views)) {
      if frame_views[j].context and j + frame_sizes[j] > fi then c = j else ()
    }
    if c >= 0 and fi < list.len(frame_rects) then {
      let r = frame_rects[fi]
      context_touch = false
      frame_views[c].on_context(r.x + 8.0, r.y + r.h)
      handled = true
    } else ()
  } else ()
  if not handled and phase != 1 and code == 5 and focus_key != "" then {
    focus("")
    handled = true
  } else ()
  if handled then invalidate() else ()
  handled
}

// Lines are 40 px for line-unit wheels.
fn wheel(x: Float, y: Float, dx: Float, dy: Float, unit: Int) -> Bool = {
  let k = if unit == 0 then 40.0 else 1.0
  var target = -1
  let n = int.min(list.len(frame_views), list.len(frame_rects))
  for i in 0..<n {
    if (frame_views[i].wheel or frame_views[i].scroller) and inside(frame_rects[i], x, y) then target = i else ()
  }
  if target < 0 then false
  else if frame_views[target].scroller and not frame_views[target].wheel then {
    let j = scroll_index(frame_views[target].key)
    scroll_vel[j] = 0.0
    scroll_by(j, dy * k)
    invalidate()
    true
  } else {
    let r = frame_rects[target]
    let handled = frame_views[target].on_wheel(x - r.x, y - r.y, dx * k, dy * k)
    if handled then invalidate() else ()
    handled
  }
}

// A file bundled with the app (ceangal.toml `assets`): `name` is its path
// inside an assets directory ("data/words.txt"). None when there is no
// such file.
pub fn asset(name: String) -> Bytes? = {
  let key = bytes.from_string(name)
  let n = sys.asset_len(bytes.data_ptr(key), bytes.len(key))
  if n < 0 then none
  else {
    var buf = bytes.new(n)
    let _ = sys.asset_read(bytes.data_ptr(key), bytes.len(key), bytes.data_ptr(buf), n)
    some(buf)
  }
}

// A bundled text file (UTF-8), none when there is none.
pub fn asset_text(name: String) -> String? = match asset(name) {
  some(b) => some(bytes.to_string_lossy(b)),
  none => none,
}

// Open `url` in the system browser (a new tab on the web).
pub fn open_url(url: String) -> Unit = {
  let b = bytes.from_string(url)
  sys.open_url(bytes.data_ptr(b), bytes.len(b))
}

// The window's title (the page's on the web; phones show none).
pub fn set_title(title: String) -> Unit = {
  let b = bytes.from_string(title)
  sys.set_title(bytes.data_ptr(b), bytes.len(b))
}

// Offer `data` to the user to save as `name`: a save dialog on the desktop,
// a download on the web, the share sheet on iOS (Save to Files, AirDrop…),
// the shared Downloads folder on Android. Returns a request id; `on_result` gets it with
// status 200 when it was saved (the body is the path), 499 when the user
// cancelled, 0 when it failed (the body is why).
pub fn save_file(name: String, data: Bytes) -> Int = {
  let n = bytes.from_string(name)
  // bound, not returned directly: a value-returning call in tail position
  // sees its Bytes already freed on wasm (almide/almide#3420)
  let id = file.file_save(bytes.data_ptr(n), bytes.len(n), bytes.data_ptr(data), bytes.len(data))
  id
}

// Ask the user for a text file: the system picker (the document picker on
// iOS; Android has none yet and answers 0). Returns a request id;
// `on_result` gets it with status 200 and the contents, 499 when the user
// cancelled, 0 when it failed.
pub fn open_text_file() -> Int = file.file_open(0)

// Put `s` on the system clipboard.
pub fn copy_text(s: String) -> Unit = {
  let b = bytes.from_string(s)
  clip.clipboard_write(bytes.data_ptr(b), bytes.len(b))
}

fn event_bytes() -> Bytes = {
  let n = sys.event_len()
  var buf = bytes.new(n)
  if n > 0 then { let _ = sys.event_read(bytes.data_ptr(buf), n) } else ()
  buf
}

fn event_string() -> String = bytes.to_string_lossy(event_bytes())

// ── Frame ──

fn frame(t: Float) -> Int = {
  frame_time = t
  let flinging = advance_flings(t)
  if flinging then dirty = true else ()
  let animating = current.on_frame(t) or flinging
  // a font still loading: draw again until it is there
  if tx.take_waiting() then dirty = true else ()
  // a toast's time is up; the pointer has rested long enough for a tooltip
  let now = frame_time
  if toast_text != "" and now >= toast_until then dirty = true else ()
  if hover_pending and now - hover_since >= TOOLTIP_DELAY_MS then { hover_pending = false; dirty = true } else ()
  if tip_key != "" and tip_until >= 0.0 and now >= tip_until then { tip_key = ""; dirty = true } else ()
  fire_long_press()
  if dirty or animating then {
    dirty = false
    render()
  } else ()
  if animating then 1 else 0
}

fn render() -> Unit = {
  if toast_text != "" and frame_time >= toast_until then toast_text = "" else ()
  let page0 = current.view() |> v.w(viewport_width()) |> v.h(viewport_height())
  let page = if text_scale != 1.0 then scale_text(page0, text_scale) else page0
  let inner = if toast_text != "" then v.with_child(page, toast_view()) else page
  let inset = safe_t > 0.0 or safe_r > 0.0 or safe_b > 0.0 or safe_l > 0.0
  let root = if inset then v.col([inner]) |> v.pad(safe_t, safe_r, safe_b, safe_l) |> v.w(width) |> v.h(height) else inner
  flatten(root)
  let laid = layout_with_wraps(root, frame_views)
  frame_over = overlay_marks(frame_views)
  let rects = free_overlays(frame_views, frame_over, apply_scrolls(frame_views, laid))
  frame_rects = rects
  tx.begin_frame()
  caret_w = -1.0
  snaidhm.begin(float.to_int(float.ceil(width * scale)), float.to_int(float.ceil(height * scale)))
  overlays = []
  paint(root, rects, 0)
  // overlays last (and the overlays inside them after them)
  var o = 0
  while o < list.len(overlays) {
    let (ov, at) = overlays[o]
    let _ = paint(ov, rects, at)
    o = o + 1
  }
  let _ = snaidhm.end(current.background)
  update_ime()
  if a11y.a11y_active() == 1 then emit_a11y() else ()
}

// ── Accessibility: a flat tree of the nodes that carry meaning ──
// Ids are frame indices + 1; the host diffs by id after each commit.

fn cached_value(id: String) -> String = {
  var found = ""
  for kv in a11y_cache { if kv.0 == id then found = kv.1 else () }
  found
}

fn emit_a11y() -> Unit = {
  let elapsed = frame_time - a11y_values_at
  let refresh = elapsed >= A11Y_VALUE_MS or elapsed < 0.0 or focus_key != a11y_values_focus
  var fresh: List[(String, String)] = []
  a11y.a11y_begin()
  for i in 0..<list.len(frame_views) {
    let vw = frame_views[i]
    let is_text = vw.kind == v.TEXT and vw.content != ""
    if vw.role >= 0 and (vw.role != 0 or vw.label != "" or vw.focusable or is_text) then {
      let r = frame_rects[i]
      let role = if vw.role != 0 then vw.role else if is_text then 4 else 2
      let label = if vw.label != "" then vw.label else vw.content
      let lb = bytes.from_string(label)
      let focused_flag = if vw.focusable and vw.key != "" and vw.key == focus_key then 2 else 0
      let flags = (if vw.focusable then 1 else 0) + focused_flag + vw.states
      a11y.a11y_node(i + 1, 0, role, r.x, r.y, r.w, r.h, flags, bytes.data_ptr(lb), bytes.len(lb))
      let id = vw.key + "\u{1}" + label
      let val = if refresh then vw.value() else cached_value(id)
      if refresh and val != "" then list.push(fresh, (id, val)) else ()
      if val != "" then {
        let vb = bytes.from_string(val)
        a11y.a11y_value(i + 1, bytes.data_ptr(vb), bytes.len(vb))
      } else ()
    } else ()
  }
  a11y.a11y_commit(find_key(focus_key) + 1)
  if refresh then {
    a11y_cache = fresh
    a11y_values_at = frame_time
    a11y_values_focus = focus_key
  } else {
    // until the values are fresh again: a timer can fire a little early,
    // so every stale frame asks for the next one (the host keeps the earliest)
    dirty = true
    sys.request_frame_after(float.max(1.0, A11Y_VALUE_MS - elapsed))
  }
}

fn a11y_action(id: Int, action: Int) -> Bool = {
  let i = id - 1
  if i < 0 or i >= list.len(frame_views) then false
  else if action == 1 and frame_views[i].clickable then { frame_views[i].on_click(); invalidate(); true }
  else if action == 2 and frame_views[i].focusable then { focus(frame_views[i].key); true }
  // increment / decrement (a slider): as the Right / Left arrow keys
  else if action == 3 or action == 4 then {
    let done = frame_views[i].on_key(0, if action == 3 then 11 else 10, 0)
    if done then invalidate() else ()
    done
  }
  else false
}

// ── View → layout node ──

fn wrap_key(vw: v.View) -> String = {
  let s = vw.style
  vw.content + "|" + float.to_string(s.font_size) + (if s.mono then "m" else "") + (if s.bold then "b" else "")
}

fn wraps(vw: v.View) -> Bool = vw.kind == v.TEXT and vw.style.wrap and vw.style.height == lay.UNDEFINED and vw.style.height_pct == lay.UNDEFINED

// Lay out `root`; then each wrapping text gets the height of its rows at
// the width it was given, and if one changed the tree is laid out again.
fn layout_with_wraps(root: v.View, views: List[v.View]) -> List[lay.LayoutRect] = {
  node_seq = 0
  let laid = lay.layout(to_node(root), width, height)
  var changed = false
  for i in 0..<int.min(list.len(views), list.len(laid)) {
    let vw = views[i]
    if wraps(vw) then {
      let s = vw.style
      let inner = laid[i].w - s.pl - s.pr
      let rows = list.len(tx.wrap_rows(vw.content, float.max(1.0, inner), s.font_size, s.mono, s.bold))
      let h = int.to_float(rows) * tx.line_height(s.font_size, s.mono) + s.pt + s.pb
      if float.abs(h - laid[i].h) > 0.5 then {
        changed = true
        if map.len(wrap_heights) > 500 then wrap_heights = map.new() else ()
        map.insert(wrap_heights, wrap_key(vw), h)
      } else ()
    } else ()
  }
  if changed then { node_seq = 0; lay.layout(to_node(root), width, height) } else laid
}

fn edges(t: Float, r: Float, b: Float, l: Float) -> lay.Edges = { top: t, right: r, bottom: b, left: l }

var node_seq = 0  // the next layout node's id (to_node numbers them)

fn to_node(view: v.View) -> lay.Node = {
  let id = node_seq
  node_seq = node_seq + 1
  let s = view.style
  let base = lay.node_defaults()
  // Text measures its content box; padding adds to it.
  let intrinsic = if view.kind == v.TEXT then tx.measure_style(view.content, s.font_size, s.mono, s.bold) else { w: lay.UNDEFINED, h: lay.UNDEFINED }
  let is_text = view.kind == v.TEXT
  let unset = lay.UNDEFINED
  // wrapping text: as wide as its one line at most, shrinking to fit, as
  // tall as its rows (worked out after a first layout)
  let wrapping = wraps(view)
  let width = if s.width != unset or s.width_pct != unset then s.width else if is_text and not wrapping then intrinsic.w + s.pl + s.pr else unset
  let height = if s.height != unset or s.height_pct != unset then s.height
    else if wrapping then (match map.get(wrap_heights, wrap_key(view)) { some(h) => h, none => intrinsic.h + s.pt + s.pb })
    else if is_text then intrinsic.h + s.pt + s.pb else unset
  {
    ...base,
    id: id,
    direction: if view.kind == v.ROW then lay.ROW else lay.COLUMN,
    wrap: if s.wrap then lay.WRAP_WRAP else lay.WRAP_NONE,
    gap_cross: if s.wrap then s.gap else 0.0,
    justify: s.justify,
    align_items: s.align,
    align_self: s.align_self,
    gap_main: s.gap,
    grow: s.grow,
    shrink: if wrapping and s.shrink == 0.0 then 1.0 else s.shrink,
    padding: edges(s.pt, s.pr, s.pb, s.pl),
    margin: edges(s.mt, s.mr, s.mb, s.ml),
    width: width,
    height: height,
    min_width: s.min_width,
    min_height: s.min_height,
    max_width: if wrapping and s.max_width == unset and width == unset then intrinsic.w + s.pl + s.pr else s.max_width,
    max_height: s.max_height,
    width_pct: s.width_pct,
    height_pct: s.height_pct,
    overflow: if s.clip then lay.OVERFLOW_HIDDEN else lay.OVERFLOW_VISIBLE,
    position: if s.absolute then lay.POSITION_ABSOLUTE else lay.POSITION_RELATIVE,
    pos_top: s.pos_top,
    pos_right: s.pos_right,
    pos_bottom: s.pos_bottom,
    pos_left: s.pos_left,
    children: children_of(view),
  }
}

// The children's nodes; in a row, a wrapping text starts at the width of
// its one line and shrinks from there.
fn children_of(view: v.View) -> List[lay.Node] = {
  var out: List[lay.Node] = []
  for c in view.children {
    let n = to_node(c)
    if view.kind == v.ROW and wraps(c) and n.width == lay.UNDEFINED then {
      let one = tx.measure_style(c.content, c.style.font_size, c.style.mono, c.style.bold).w + c.style.pl + c.style.pr
      list.push(out, { ...n, basis: if n.max_width == lay.UNDEFINED then one else float.min(one, n.max_width) })
    } else list.push(out, n)
  }
  out
}

// ── Scroll views ──

fn scroll_index(key: String) -> Int = {
  var at = -1
  for i in 0..<list.len(scroll_keys) { if scroll_keys[i] == key then at = i else () }
  if at < 0 then {
    list.push(scroll_keys, key)
    list.push(scroll_offs, 0.0)
    list.push(scroll_max, 0.0)
    list.push(scroll_vel, 0.0)
    list.len(scroll_keys) - 1
  } else at
}

fn subtree_len(view: v.View) -> Int = {
  var n = 1
  for c in view.children { n = n + subtree_len(c) }
  n
}

var scroll_end_keys: List[String] = []

// How far the `scroll_y` view with `key` is scrolled (logical px; 0 for a
// view not seen yet).
pub fn scroll_offset(key: String) -> Float = {
  var off = 0.0
  for i in 0..<list.len(scroll_keys) { if scroll_keys[i] == key then off = scroll_offs[i] else () }
  off
}

// Scroll the `scroll_y` view with `key` to `off` px from its top (kept within
// its content at the next layout).
pub fn scroll_to(key: String, off: Float) -> Unit = {
  let j = scroll_index(key)
  scroll_offs[j] = float.max(0.0, off)
  scroll_vel[j] = 0.0
  invalidate()
}

// Scroll the `scroll_y` view with `key` to its end on the next layout (a log
// or a conversation following what was just added).
pub fn scroll_to_end(key: String) -> Unit = {
  if not list.contains(scroll_end_keys, key) then list.push(scroll_end_keys, key) else ()
  invalidate()
}

// Shift each scroll view's descendants up by its offset (clamped to the
// content) and clip them to it. Rects are in flatten / paint order, where a
// view's subtree is the contiguous run after it.
fn apply_scrolls(views: List[v.View], laid: List[lay.LayoutRect]) -> List[lay.LayoutRect] = {
  var rs = laid
  let n = int.min(list.len(views), list.len(rs))
  for i in 0..<n {
    if views[i].scroller then {
      let j = scroll_index(views[i].key)
      let r = rs[i]
      let end = int.min(n, i + frame_sizes[i])
      // how far the content reaches (not the view's own box: a view whose
      // content fits must not scroll by its bottom padding)
      var bottom = r.y
      for d in (i + 1)..<end { bottom = float.max(bottom, rs[d].y + rs[d].h) }
      let mx = float.max(0.0, bottom + views[i].style.pb - (r.y + r.h))
      scroll_max[j] = mx
      if list.contains(scroll_end_keys, views[i].key) then {
        scroll_offs[j] = mx
        scroll_end_keys = list.filter(scroll_end_keys, (k) => k != views[i].key)
      } else ()
      let off = float.max(0.0, float.min(scroll_offs[j], mx))
      scroll_offs[j] = off
      if off > 0.0 then {
        // the scroll view's own visible area
        let has = r.clip_w >= 0.0
        let x0 = if has then float.max(r.x, r.clip_x) else r.x
        let y0 = if has then float.max(r.y, r.clip_y) else r.y
        let x1 = if has then float.min(r.x + r.w, r.clip_x + r.clip_w) else r.x + r.w
        let y1 = if has then float.min(r.y + r.h, r.clip_y + r.clip_h) else r.y + r.h
        for d in (i + 1)..<end {
          let q = rs[d]
          // A clip that is the scroll view's own area stays put; a clip from
          // a view inside it moves with the content.
          let own = float.abs(q.clip_y - y0) < 0.5 and float.abs(q.clip_h - (y1 - y0)) < 0.5
          let inner = q.clip_w >= 0.0 and not own
          let qx0 = if inner then float.max(x0, q.clip_x) else x0
          let qy0 = if inner then float.max(y0, q.clip_y - off) else y0
          let qx1 = if inner then float.min(x1, q.clip_x + q.clip_w) else x1
          let qy1 = if inner then float.min(y1, q.clip_y - off + q.clip_h) else y1
          rs[d] = { ...q, y: q.y - off, clip_x: qx0, clip_y: qy0, clip_w: float.max(0.0, qx1 - qx0), clip_h: float.max(0.0, qy1 - qy0) }
        }
      } else ()
    } else ()
  }
  rs
}

fn scroll_by(j: Int, dy: Float) -> Unit = {
  scroll_offs[j] = float.max(0.0, float.min(scroll_offs[j] + dy, scroll_max[j]))
}

// Momentum after a flick; true while any scroll view is still moving.
fn advance_flings(t: Float) -> Bool = {
  if prefer_less_motion then { for j in 0..<list.len(scroll_vel) { scroll_vel[j] = 0.0 } } else ()
  let dt = float.min(64.0, float.max(0.0, t - scroll_t))
  scroll_t = t
  var moving = false
  for j in 0..<list.len(scroll_vel) {
    if scroll_vel[j] != 0.0 then {
      let before = scroll_offs[j]
      scroll_by(j, scroll_vel[j] * dt)
      let v2 = scroll_vel[j] * math.exp(0.0 - dt / 325.0)
      let stuck = scroll_offs[j] == before and dt > 0.0
      scroll_vel[j] = if float.abs(v2) < 0.02 or stuck then 0.0 else v2
      if scroll_vel[j] != 0.0 then moving = true else ()
    } else ()
  }
  moving
}

// The innermost scroll view under a point (index into frame_views), or -1.
fn scroller_at(x: Float, y: Float) -> Int = {
  var found = -1
  let n = int.min(list.len(frame_views), list.len(frame_rects))
  for i in 0..<n {
    if frame_views[i].scroller and inside(frame_rects[i], x, y) then found = i else ()
  }
  found
}

// A finger on a scroll view: once it moves past the slop it scrolls the view
// (the press on whatever is under it is cancelled, so no click fires).
// Returns true when the event was consumed.
fn touch_scroll(phase: Int, x: Float, y: Float) -> Bool =
  if phase == 0 then {
    let i = scroller_at(x, y)
    drag_scroll = if i >= 0 then scroll_index(frame_views[i].key) else -1
    drag_active = false
    if drag_scroll >= 0 then {
      scroll_vel[drag_scroll] = 0.0
      drag_y0 = y
      drag_off0 = scroll_offs[drag_scroll]
      drag_ly = y
      drag_lt = sys.now_ms()
      drag_v = 0.0
    } else ()
    false
  } else if drag_scroll < 0 then false
  else if phase == 1 then {
    if not drag_active and float.abs(y - drag_y0) > 8.0 then {
      drag_active = true
      if pressed >= 0 then {
        let fv = frame_views[pressed]
        let r = frame_rects[pressed]
        if fv.pointer then { let _ = fv.on_pointer({ phase: 3, x: x - r.x, y: y - r.y, w: r.w, h: r.h, buttons: 0, mods: 0, id: 1 }) } else ()
        pressed = -1
      } else ()
    } else ()
    if drag_active then {
      let now = sys.now_ms()
      let v_now = (drag_ly - y) / float.max(1.0, now - drag_lt)
      drag_v = v_now * 0.8 + drag_v * 0.2
      drag_ly = y
      drag_lt = now
      scroll_offs[drag_scroll] = float.max(0.0, float.min(drag_off0 - (y - drag_y0), scroll_max[drag_scroll]))
      invalidate()
      true
    } else false
  } else {
    let was = drag_active
    if was and phase == 2 and sys.now_ms() - drag_lt < 80.0 and float.abs(drag_v) > 0.25 then {
      scroll_vel[drag_scroll] = drag_v
      scroll_t = sys.now_ms()
      invalidate()
    } else ()
    drag_scroll = -1
    drag_active = false
    was
  }

// The views in the order lay.layout emits rects: self, in-flow children
// (recursively), then absolutely positioned children.
// For each node of the frame, whether it is in an overlay's subtree.
fn overlay_marks(views: List[v.View]) -> List[Bool] = {
  var out = list.repeat(false, list.len(views))
  var i = 0
  while i < list.len(views) {
    if views[i].style.overlay then {
      let n = frame_sizes[i]
      for k in i..<int.min(i + n, list.len(views)) { out[k] = true }
    } else ()
    i = i + 1
  }
  out
}

// Overlays are not clipped by their ancestors: in an overlay's subtree, the
// clip it inherited is dropped (clips of its own stay).
fn free_overlays(views: List[v.View], over: List[Bool], rects: List[lay.LayoutRect]) -> List[lay.LayoutRect] =
  if not list.contains(over, true) then rects
  else {
    var out = rects
    var i = 0
    while i < list.len(views) and i < list.len(out) {
      if views[i].style.overlay then {
        let r = out[i]
        let n = frame_sizes[i]
        for k in i..<int.min(i + n, list.len(out)) {
          let c = out[k]
          if c.clip_x == r.clip_x and c.clip_y == r.clip_y and c.clip_w == r.clip_w and c.clip_h == r.clip_h then
            out[k] = { ...c, clip_x: -1.0, clip_y: -1.0, clip_w: -1.0, clip_h: -1.0 }
          else ()
        }
      } else ()
      i = i + 1
    }
    out
  }

// The tree in flatten order (a view, then its in-flow children's subtrees,
// then its absolute ones'), into frame_views — each view without its
// children, which follow it — and frame_sizes, each view's subtree length.
// Keeping the children made every frame_views[i] a copy of its subtree.
fn flatten(view: v.View) -> Unit = {
  frame_views = []
  frame_sizes = []
  flatten_into(view)
}

fn flatten_into(view: v.View) -> Unit = {
  let at = list.len(frame_views)
  let no_kids: List[v.View] = []
  list.push(frame_views, { ...view, children: no_kids })
  list.push(frame_sizes, 1)
  for c in view.children {
    if not c.style.absolute then flatten_into(c) else ()
  }
  for c in view.children {
    if c.style.absolute then flatten_into(c) else ()
  }
  frame_sizes[at] = list.len(frame_views) - at
}


// ── Paint ──

// Paint `view` whose rect is rects[idx]; returns the index after its subtree.
fn paint(view: v.View, rects: List[lay.LayoutRect], idx: Int) -> Int = {
  let r = rects[idx]
  let s = view.style
  let k = scale
  let x = r.x * k
  let y = r.y * k
  let w = r.w * k
  let h = r.h * k
  let has_clip = r.clip_w >= 0.0
  if has_clip then snaidhm.push_clip(r.clip_x * k, r.clip_y * k, r.clip_w * k, r.clip_h * k) else ()
  if s.shadow_color.a > 0.0 then
    snaidhm.shadow(x, y + s.shadow_dy * k, w, h, s.radius * k, s.shadow_blur * k, s.shadow_color)
  else ()
  snaidhm.fill(x, y, w, h, s.radius * k, snaidhm.with_alpha(s.bg, s.bg.a * s.opacity))
  if s.border_width > 0.0 then
    snaidhm.stroke(x, y, w, h, s.radius * k, s.border_width * k, s.border_color)
  else ()
  if view.kind == v.TEXT then {
    snaidhm.push_clip(x, y, w, h)
    if wraps(view) then {
      // the rows layout measured (logical px), drawn at the pixel scale
      let bs = tx.wrap_rows(view.content, float.max(1.0, r.w - s.pl - s.pr), s.font_size, s.mono, s.bold)
      tx.draw_rows(view.content, bs, x + s.pl * k, y + s.pt * k, w - (s.pl + s.pr) * k, tx.line_height(s.font_size, s.mono) * k, s.font_size * k, s.mono, s.bold, s.fg)
    }
    else tx.draw_style(view.content, x + s.pl * k, y + s.pt * k, w - (s.pl + s.pr) * k, h - (s.pt + s.pb) * k, s.font_size * k, s.mono, s.bold, s.fg)
    snaidhm.pop_clip()
  } else ()
  if view.kind == v.CUSTOM then view.paint(r.x, r.y, r.w, r.h) else ()
  if has_clip then snaidhm.pop_clip() else ()
  var next = idx + 1
  for c in view.children {
    if not c.style.absolute then next = paint(c, rects, next) else ()
  }
  for c in view.children {
    if c.style.overlay then { list.push(overlays, (c, next)); next = next + subtree_len(c) }
    else if c.style.absolute then next = paint(c, rects, next)
    else ()
  }
  next
}

// ── Pointer ──

fn inside(r: lay.LayoutRect, x: Float, y: Float) -> Bool = {
  let in_rect = x >= r.x and y >= r.y and x < r.x + r.w and y < r.y + r.h
  let in_clip = r.clip_w < 0.0 or (x >= r.clip_x and y >= r.clip_y and x < r.clip_x + r.clip_w and y < r.clip_y + r.clip_h)
  in_rect and in_clip
}

fn in_overlay(i: Int) -> Bool = i < list.len(frame_over) and frame_over[i]

// Topmost node at (x, y) that takes pointer input (or -1): overlays first.
fn hit(x: Float, y: Float) -> Int = {
  var found = -1
  var over = -1
  let n = int.min(list.len(frame_views), list.len(frame_rects))
  for i in 0..<n {
    let fv = frame_views[i]
    if (fv.clickable or fv.pointer) and inside(frame_rects[i], x, y) then {
      if in_overlay(i) then over = i else found = i
    } else ()
  }
  if over >= 0 then over else found
}

// The laid-out rect of the view with `key` in the last frame (logical px).
pub fn rect_of(key: String) -> lay.LayoutRect = {
  let i = find_key(key)
  if i >= 0 then frame_rects[i] else { x: 0.0, y: 0.0, w: 0.0, h: 0.0, clip_x: -1.0, clip_y: -1.0, clip_w: -1.0, clip_h: -1.0 }
}

// Topmost node at (x, y) with a cursor.
fn hover_at(x: Float, y: Float) -> String = {
  var k = ""
  var ko = ""
  var over = false
  let n = int.min(list.len(frame_views), list.len(frame_rects))
  for i in 0..<n {
    let fv = frame_views[i]
    if (fv.clickable or fv.pointer) and inside(frame_rects[i], x, y) then {
      if in_overlay(i) then { over = true; if fv.key != "" then ko = fv.key else () }
      else if fv.key != "" then k = fv.key
      else ()
    } else ()
  }
  if over then ko else k
}

// The mouse is over the clickable view with `key` (never on touch screens).
pub fn is_hovered(key: String) -> Bool = key != "" and key == hover_key

let TOOLTIP_DELAY_MS = 600.0

// Whether the last input was a key (not a press): focus that came from the
// keyboard shows tooltips and focus rings.
var keyboard_used = false

// Whether the control with `key` has focus that the keyboard moved there.
pub fn keyboard_focused(key: String) -> Bool = keyboard_used and is_focused(key)
var hover_since = 0.0
var hover_pending = false

// Whether the pointer has rested on the view with `key` long enough for its
// tooltip (0.6 s).
pub fn hover_rested(key: String) -> Bool = is_hovered(key) and frame_time - hover_since >= TOOLTIP_DELAY_MS
// The view with `key` is being pressed (mouse button or finger down on it).
pub fn is_pressed(key: String) -> Bool = key != "" and key == pressed_key

fn cursor_at(x: Float, y: Float) -> Int = {
  var c = 0
  var over = -1
  let n = int.min(list.len(frame_views), list.len(frame_rects))
  for i in 0..<n {
    if frame_views[i].style.cursor != 0 and inside(frame_rects[i], x, y) then {
      if in_overlay(i) then over = frame_views[i].style.cursor else c = frame_views[i].style.cursor
    } else ()
  }
  if over >= 0 then over else c
}

fn pointer(phase: Int, id: Int, x: Float, y: Float, buttons: Int, mods: Int) -> Bool =
  if id >= 1 and touch_scroll(phase, x, y) then true
  else pointer_target(phase, id, x, y, buttons, mods)

// ── Context gestures ──

let LONG_PRESS_MS = 500.0
var right_swallow = false     // the right button's release after a context click
var lp_id = -1                // the touch that may become a long press
var lp_x = 0.0
var lp_y = 0.0
var lp_t = 0.0
var lp_fired = false
var context_touch = false     // the last context gesture was a long press
var tip_key = ""              // the control whose tooltip a long press shows
var tip_until = 0.0           // ... until then (frame time; -1 while held)
let TIP_AFTER_MS = 1500.0

// Whether the last context gesture (`v.on_context`) was a touch held still
// rather than a right-click.
pub fn context_by_touch() -> Bool = context_touch

// Show the tooltip of the control with `key` for the current long press:
// while the finger stays down and 1.5 s after it lifts.
pub fn hold_tooltip(key: String) -> Unit = { tip_key = key; tip_until = -1.0 }

// Whether a long press is showing the tooltip of the control with `key`.
pub fn tooltip_held(key: String) -> Bool = key != "" and key == tip_key

// The topmost view with a context handler at (x, y) (overlays first).
fn context_at(x: Float, y: Float) -> Int = {
  var found = -1
  var over = -1
  let n = int.min(list.len(frame_views), list.len(frame_rects))
  for i in 0..<n {
    if frame_views[i].context and inside(frame_rects[i], x, y) then {
      if in_overlay(i) then over = i else found = i
    } else ()
  }
  if over >= 0 then over else found
}

// A touch that stays put for LONG_PRESS_MS on a view with a context
// handler becomes a long press (checked by frame()).
fn track_long_press(phase: Int, id: Int, x: Float, y: Float) -> Unit =
  if phase == 0 then {
    // a new touch puts away a tooltip a long press left
    if tip_key != "" then { tip_key = ""; dirty = true } else ()
    if context_at(x, y) >= 0 then {
      lp_id = id
      lp_x = x
      lp_y = y
      lp_t = sys.now_ms()
      lp_fired = false
      sys.request_frame_after(LONG_PRESS_MS + 10.0)
    } else lp_id = -1
  } else if id == lp_id and phase == 1 and (float.abs(x - lp_x) > 10.0 or float.abs(y - lp_y) > 10.0) then lp_id = -1
  else if id == lp_id and (phase == 2 or phase == 3) then lp_id = -1
  else ()

fn fire_long_press() -> Unit =
  if lp_id >= 0 and not lp_fired and sys.now_ms() - lp_t >= LONG_PRESS_MS then {
    let c = context_at(lp_x, lp_y)
    if c >= 0 then {
      lp_fired = true
      pressed = -1
      pressed_key = ""
      context_touch = true
      frame_views[c].on_context(lp_x, lp_y)
      dirty = true
    } else lp_id = -1
  } else ()

fn pointer_target(phase: Int, id: Int, x: Float, y: Float, buttons: Int, mods: Int) -> Bool =
  // a right-click: the context handler under the pointer, and nothing else
  if id == 0 and phase == 0 and int.band(buttons, 2) != 0 and context_at(x, y) >= 0 then {
    right_swallow = true
    context_touch = false
    frame_views[context_at(x, y)].on_context(x, y)
    invalidate()
    true
  } else if right_swallow and id == 0 and phase == 2 then { right_swallow = false; true }
  // a touch that became a long press: the rest of it does nothing
  else if lp_fired and id == lp_id then {
    if phase == 2 or phase == 3 then {
      lp_fired = false
      lp_id = -1
      if tip_key != "" and tip_until < 0.0 then {
        tip_until = frame_time + TIP_AFTER_MS
        sys.request_frame_after(TIP_AFTER_MS + 20.0)
      } else ()
    } else ()
    true
  } else {
    if id >= 1 then track_long_press(phase, id, x, y) else ()
    pointer_inner(phase, id, x, y, buttons, mods)
  }

fn pointer_inner(phase: Int, id: Int, x: Float, y: Float, buttons: Int, mods: Int) -> Bool = {
  if phase == 1 then {
    let c = cursor_at(x, y)
    if c != hover_cursor then { hover_cursor = c; sys.set_cursor(c) } else ()
  } else ()
  if id == 0 then {
    let h = if phase == 5 then "" else hover_at(x, y)
    if h != hover_key then {
      hover_key = h
      hover_since = frame_time
      // a tooltip shows after the pointer rests: draw again then
      hover_pending = h != ""
      if h != "" then sys.request_frame_after(TOOLTIP_DELAY_MS + 10.0) else ()
      invalidate()
    } else ()
  } else ()
  last_x = x
  last_y = y
  let target0 = if pressed >= 0 and (phase == 1 or phase == 2 or phase == 3) then pressed else hit(x, y)
  // a press outside the open popup and its control closes it, and does nothing else
  let outside = phase == 0 and popup_key != "" and not (target0 >= 0 and (in_overlay(target0) or frame_views[target0].key == popup_key))
  if outside then { close_popup(); press_swallowed = true } else if phase == 0 then press_swallowed = false else ()
  let swallowed = outside or (press_swallowed and (phase == 1 or phase == 2 or phase == 3))
  if phase == 2 or phase == 3 then press_swallowed = false else ()
  let target = if swallowed then -1 else target0
  if phase == 0 then { press_x = x; press_y = y } else ()
  let tap_end = phase == 2 and float.abs(x - press_x) <= 10.0 and float.abs(y - press_y) <= 10.0
  if not swallowed and ((phase == 0 and id == 0) or (tap_end and id >= 1)) then {
    // Pressing (a mouse) or tapping (a finger) moves focus to the focusable
    // node under the pointer, or clears it.
    var f = ""
    var text = false
    var keep = false
    // over an overlay, only its nodes count (not what is under it)
    let over_target = target >= 0 and in_overlay(target)
    let n = int.min(list.len(frame_views), list.len(frame_rects))
    for i in 0..<n {
      if inside(frame_rects[i], x, y) and (in_overlay(i) or not over_target) then {
        if frame_views[i].focusable then { f = frame_views[i].key; text = frame_views[i].text_input } else ()
        if frame_views[i].keeps_focus then keep = true else ()
      } else ()
    }
    if not keep then {
      if id >= 1 then kb_tapped = text else ()
      focus(f)
    } else ()
  } else ()
  if target < 0 then false
  else {
    let fv = frame_views[target]
    let r = frame_rects[target]
    var handled = false
    if fv.pointer then {
      handled = fv.on_pointer({ phase: phase, x: x - r.x, y: y - r.y, w: r.w, h: r.h, buttons: buttons, mods: mods, id: id })
    } else ()
    if phase == 0 then {
      pressed = target
      pressed_key = fv.key
      if fv.key != "" then invalidate() else ()
    } else ()
    if phase == 2 or phase == 3 then {
      if pressed_key != "" then invalidate() else ()
      pressed_key = ""
      if phase == 2 and fv.clickable and inside(r, x, y) then {
        fv.on_click()
        handled = true
      } else ()
      pressed = -1
    } else ()
    if handled then invalidate() else ()
    handled or fv.clickable
  }
}
