// Right-to-left text: a reduced Unicode Bidirectional Algorithm for one
// line (paragraph direction from the first strong character, numbers kept
// left to right, neutrals taking the direction around them), the order
// runs are shown in, and mirrored brackets. Joining Arabic letters is the
// font's work (self.arabic); this module only orders.

// Arabic marks (harakat and the like): neutral here, they go with their letter.
fn transparent(cp: Int) -> Bool =
  (cp >= 0x064B and cp <= 0x065F) or cp == 0x0670 or (cp >= 0x06D6 and cp <= 0x06DC)
    or (cp >= 0x06DF and cp <= 0x06E4) or cp == 0x06E7 or cp == 0x06E8 or (cp >= 0x06EA and cp <= 0x06ED)

// ── Direction ──

// Classes: 0 L, 1 R, 2 EN, 3 neutral (ON, WS), 4 LRE, 5 RLE, 6 LRO,
// 7 RLO, 8 PDF, 9 LRI, 10 RLI, 11 FSI, 12 PDI, 13 AN, 14 NSM, 15 AL,
// 16 ES, 17 ET, 18 CS
fn class_of(cp: Int) -> Int =
  if cp >= 0x202A and cp <= 0x202E then [4, 5, 8, 6, 7][cp - 0x202A]
  else if cp >= 0x2066 and cp <= 0x2069 then cp - 0x2066 + 9
  else if cp == 0x200E then 0
  else if cp == 0x200F then 1
  else if cp == 0x061C then 15
  else if (cp >= 0x30 and cp <= 0x39) or (cp >= 0x06F0 and cp <= 0x06F9) or cp == 0xB2 or cp == 0xB3 or cp == 0xB9
    or (cp >= 0xFF10 and cp <= 0xFF19) then 2
  else if (cp >= 0x0660 and cp <= 0x0669) or cp == 0x066B or cp == 0x066C or (cp >= 0x0600 and cp <= 0x0605) then 13
  else if cp == 0x2B or cp == 0x2D or cp == 0x2212 or cp == 0xFF0B or cp == 0xFF0D then 16
  else if (cp >= 0x23 and cp <= 0x25) or (cp >= 0xA2 and cp <= 0xA5) or cp == 0xB0 or cp == 0xB1 or cp == 0x066A
    or cp == 0x0609 or cp == 0x060A or (cp >= 0x2030 and cp <= 0x2034) or (cp >= 0x20A0 and cp <= 0x20CF) or cp == 0x058F then 17
  else if cp == 0x2C or cp == 0x2E or cp == 0x2F or cp == 0x3A or cp == 0xA0 or cp == 0x060C or cp == 0x202F or cp == 0x2044
    or cp == 0xFF0C or cp == 0xFF0E or cp == 0xFF0F or cp == 0xFF1A then 18
  else if (cp >= 0x0590 and cp <= 0x05FF) or (cp >= 0x07C0 and cp <= 0x085F) or (cp >= 0xFB1D and cp <= 0xFB4F) then
    (if (cp >= 0x0591 and cp <= 0x05BD) or cp == 0x05BF or cp == 0x05C1 or cp == 0x05C2 or cp == 0x05C4 or cp == 0x05C5 or cp == 0x05C7 then 14 else 1)
  else if (cp >= 0x0600 and cp <= 0x07BF) or (cp >= 0x0860 and cp <= 0x08FF) or (cp >= 0xFB50 and cp <= 0xFDFF) or (cp >= 0xFE70 and cp <= 0xFEFF) then
    (if transparent(cp) or (cp >= 0x0610 and cp <= 0x061A) then 14 else 15)
  else if cp < 0x30 or (cp >= 0x3A and cp <= 0x40) or (cp >= 0x5B and cp <= 0x60) or (cp >= 0x7B and cp <= 0xBF) or (cp >= 0x2000 and cp <= 0x206F) then 3
  else 0

// The closing bracket for an opening one, -1 if `cp` opens no pair
// (Bidi_Paired_Bracket, the common ones).
fn closer(cp: Int) -> Int =
  if cp == 0x28 then 0x29 else if cp == 0x5B then 0x5D else if cp == 0x7B then 0x7D
  else if cp == 0xFF08 then 0xFF09 else if cp == 0xFF3B then 0xFF3D else if cp == 0xFF5B then 0xFF5D
  else if cp >= 0x3008 and cp <= 0x3011 and cp % 2 == 0 then cp + 1
  else if cp == 0x2329 then 0x232A else -1

// The mirror image of a bracket or other paired character (itself if none):
// how it is shown in right-to-left text.
pub fn mirror(cp: Int) -> Int =
  if cp == 0x28 then 0x29 else if cp == 0x29 then 0x28 else if cp == 0x5B then 0x5D else if cp == 0x5D then 0x5B
  else if cp == 0x7B then 0x7D else if cp == 0x7D then 0x7B else if cp == 0x3C then 0x3E else if cp == 0x3E then 0x3C
  else if cp == 0xAB then 0xBB else if cp == 0xBB then 0xAB else cp

// Whether `cps` has a right-to-left letter (or a right-to-left control).
pub fn has_rtl(cps: List[Int]) -> Bool = {
  var r = false
  for c in cps {
    let k = class_of(c)
    if k == 1 or k == 15 or k == 5 or k == 7 or k == 10 or k == 13 then r = true else ()
  }
  r
}

fn classes_of(cps: List[Int]) -> List[Int] = {
  var out: List[Int] = []
  for c in cps { list.push(out, class_of(c)) }
  out
}

fn initiator(k: Int) -> Bool = k >= 9 and k <= 11

// The direction of the first strong character from `i` (0 left to right,
// 1 right to left, -1 none), skipping isolates; when `in_isolate`, stops
// at the PDI that closes the isolate `i` is in.
fn first_strong(classes: List[Int], i: Int, in_isolate: Bool) -> Int = {
  var d = -1
  var depth = 0
  var j = i
  while j < list.len(classes) and d < 0 {
    let k = classes[j]
    if initiator(k) then depth = depth + 1
    else if k == 12 then { if depth == 0 and in_isolate then j = list.len(classes) else depth = int.max(0, depth - 1) }
    else if depth == 0 and (k == 0 or k == 1 or k == 15) then d = int.min(k, 1)
    else ()
    j = j + 1
  }
  d
}

// The direction of the paragraph `cps` (0 left to right, 1 right to left):
// its first strong character's, outside isolates.
pub fn direction(cps: List[Int]) -> Int = int.max(0, first_strong(classes_of(cps), 0, false))

// The embedding level of each character of the line `cps` (odd: right to
// left) in a paragraph of direction `base` (0 left to right, 1 right to
// left, -1 from its first strong character): the Unicode Bidirectional
// Algorithm's explicit embeddings, overrides and isolates (X1–X10), weak
// types (W1–W7), bracket pairs (N0, the common brackets), neutrals (N1–N2),
// implicit levels (I1–I2) and trailing whitespace (L1).
pub fn levels(cps: List[Int], base: Int) -> List[Int] = {
  let classes = classes_of(cps)
  let par = if base >= 0 then base else int.max(0, first_strong(classes, 0, false))
  let n = list.len(cps)
  // X1–X8: each character's embedding level and its type after overrides;
  // the embedding controls are removed (X9); each isolate initiator's PDI
  var emb: List[Int] = []
  var t: List[Int] = []
  var removed: List[Bool] = []
  var partner = list.repeat(-1, n)
  var st_lv = [par]
  var st_ov = [-1]
  var st_iso = [-1]    // the isolate initiator's index, -1 for an embedding
  for i in 0..<n {
    let k = classes[i]
    let top = list.len(st_lv) - 1
    let lv = st_lv[top]
    let ov = st_ov[top]
    if (k >= 4 and k <= 7) or initiator(k) then {
      let rtl = if k == 11 then first_strong(classes, i + 1, true) == 1 else (k == 5 or k == 7 or k == 10)
      let next = if rtl then (if lv % 2 == 0 then lv + 1 else lv + 2) else (if lv % 2 == 0 then lv + 2 else lv + 1)
      list.push(emb, lv)
      list.push(t, if initiator(k) and ov >= 0 then ov else k)
      list.push(removed, not initiator(k))
      if next <= 125 then {
        list.push(st_lv, next)
        list.push(st_ov, if k == 6 then 0 else if k == 7 then 1 else -1)
        list.push(st_iso, if initiator(k) then i else -1)
      } else ()
    } else if k == 12 then {
      // close everything up to the innermost isolate, if one is open
      var d = top
      while d > 0 and st_iso[d] < 0 { d = d - 1 }
      if d > 0 then {
        partner[st_iso[d]] = i
        partner[i] = st_iso[d]
        st_lv = list.take(st_lv, d)
        st_ov = list.take(st_ov, d)
        st_iso = list.take(st_iso, d)
      } else ()
      let o = st_ov[list.len(st_ov) - 1]
      list.push(emb, st_lv[list.len(st_lv) - 1])
      list.push(t, if o >= 0 then o else 12)
      list.push(removed, false)
    } else if k == 8 then {
      list.push(emb, lv)
      list.push(t, k)
      list.push(removed, true)
      if top > 0 and st_iso[top] < 0 then {
        st_lv = list.take(st_lv, top)
        st_ov = list.take(st_ov, top)
        st_iso = list.take(st_iso, top)
      } else ()
    } else {
      list.push(emb, lv)
      list.push(t, if ov >= 0 then ov else k)
      list.push(removed, false)
    }
  }
  // X10: level runs of the characters that stay, joined across isolates
  // into isolating run sequences
  var run_of = list.repeat(-1, n)
  var runs: List[List[Int]] = []
  var prev = -1
  for i in 0..<n {
    if not removed[i] then {
      if prev >= 0 and emb[prev] == emb[i] then {
        let r = list.len(runs) - 1
        runs[r] = runs[r] + [i]
      } else list.push(runs, [i])
      run_of[i] = list.len(runs) - 1
      prev = i
    } else ()
  }
  var out = list.repeat(par, n)
  for r in runs {
    let first = r[0]
    if not (classes[first] == 12 and partner[first] >= 0) then {
      var seq = r
      var last = r[list.len(r) - 1]
      while initiator(classes[last]) and partner[last] >= 0 {
        let more = runs[run_of[partner[last]]]
        seq = seq + more
        last = more[list.len(more) - 1]
      }
      out = resolve(seq, t, emb, removed, par, classes, cps, out)
    } else ()
  }
  // removed controls take the level before them; L1: tabs, and whitespace
  // and isolate controls before a tab or at the end of the line, take the
  // paragraph's
  for i in 0..<n { if removed[i] then out[i] = if i > 0 then out[i - 1] else par else () }
  for i in 0..<(n + 1) {
    if i == n or cps[i] == 0x09 then {
      if i < n then out[i] = par else ()
      var e = i - 1
      while e >= 0 and (cps[e] == 0x20 or cps[e] == 0x09 or initiator(classes[e]) or classes[e] == 12 or removed[e]) {
        out[e] = par
        e = e - 1
      }
    } else ()
  }
  out
}

// A resolved type as a strong direction for N0 (numbers count as right to
// left), -1 for a neutral.
fn strong_of(ty: Int) -> Int = if ty == 0 then 0 else if ty == 1 or ty == 2 or ty == 13 then 1 else -1

// `levels` with those of one isolating run sequence `seq` (indices) set.
fn resolve(seq: List[Int], t0: List[Int], emb: List[Int], removed: List[Bool], par: Int, classes: List[Int], cps: List[Int], levels: List[Int]) -> List[Int] = {
  var out = levels
  let m = list.len(seq)
  let e = emb[seq[0]]
  // sos / eos: the higher of this level and the one next to the sequence
  var j = seq[0] - 1
  while j >= 0 and removed[j] { j = j - 1 }
  let sos = int.max(e, if j >= 0 then emb[j] else par) % 2
  let last = seq[m - 1]
  var k = last + 1
  while k < list.len(emb) and removed[k] { k = k + 1 }
  let eos = int.max(e, if initiator(classes[last]) or k >= list.len(emb) then par else emb[k]) % 2
  var t: List[Int] = []
  for i in seq { list.push(t, t0[i]) }
  // W1: a mark takes the type before it (a neutral after an isolate control)
  for p in 0..<m {
    if t[p] == 14 then t[p] = if p == 0 then sos else if initiator(t[p - 1]) or t[p - 1] == 12 then 3 else t[p - 1] else ()
  }
  // W2: a European number after Arabic letters is an Arabic number; W3: AL is R
  var last_strong = sos
  for p in 0..<m {
    let ty = t[p]
    if ty == 15 then { last_strong = 15; t[p] = 1 }
    else if ty == 0 or ty == 1 then last_strong = ty
    else if ty == 2 and last_strong == 15 then t[p] = 13
    else ()
  }
  // W4: one separator between two numbers of a kind joins them
  for p in 1..<int.max(1, m - 1) {
    if t[p] == 16 and t[p - 1] == 2 and t[p + 1] == 2 then t[p] = 2
    else if t[p] == 18 and (t[p - 1] == 2 or t[p - 1] == 13) and t[p + 1] == t[p - 1] then t[p] = t[p - 1]
    else ()
  }
  // W5: terminators next to a European number are part of it
  var p5 = 0
  while p5 < m {
    if t[p5] == 17 then {
      var q = p5
      while q < m and t[q] == 17 { q = q + 1 }
      if (p5 > 0 and t[p5 - 1] == 2) or (q < m and t[q] == 2) then { for r in p5..<q { t[r] = 2 } } else ()
      p5 = q
    } else p5 = p5 + 1
  }
  // W6: other separators and terminators are neutral; W7: a European
  // number after left-to-right text (or sos) is L
  var strong = sos
  for p in 0..<m {
    let ty = t[p]
    if ty >= 16 then t[p] = 3
    else if ty == 0 or ty == 1 then strong = ty
    else if ty == 2 and strong == 0 then t[p] = 0
    else ()
  }
  // N0: a pair of brackets takes the direction inside it (the embedding's,
  // or failing that one context agrees with); a mark after one goes with it
  let dir = e % 2
  // the closing bracket of the pair each opening one starts (-1: none)
  var close_at = list.repeat(-1, m)
  var open_cp: List[Int] = []
  var open_at: List[Int] = []
  var p0 = 0
  while p0 < m {
    let c = cps[seq[p0]]
    if t[p0] == 3 and closer(c) >= 0 then {
      if list.len(open_at) >= 63 then p0 = m else { list.push(open_cp, closer(c)); list.push(open_at, p0) }
    } else if t[p0] == 3 then {
      var s = list.len(open_at) - 1
      while s >= 0 and open_cp[s] != c { s = s - 1 }
      if s >= 0 then {
        close_at[open_at[s]] = p0
        open_cp = list.take(open_cp, s)
        open_at = list.take(open_at, s)
      } else ()
    } else ()
    p0 = p0 + 1
  }
  for o in 0..<m {
    let c = close_at[o]
    if c >= 0 then {
      var inside = -1
      for q in (o + 1)..<c {
        let d = strong_of(t[q])
        if d == dir then inside = dir else if d >= 0 and inside < 0 then inside = d else ()
      }
      var b = o - 1
      while b >= 0 and strong_of(t[b]) < 0 { b = b - 1 }
      let before = if b >= 0 then strong_of(t[b]) else sos
      let set = if inside == dir then dir else if inside >= 0 then (if before != dir then 1 - dir else dir) else -1
      if set >= 0 then {
        t[o] = set
        t[c] = set
        var k2 = o + 1
        while k2 < m and t0[seq[k2]] == 14 { t[k2] = set; k2 = k2 + 1 }
        k2 = c + 1
        while k2 < m and t0[seq[k2]] == 14 { t[k2] = set; k2 = k2 + 1 }
      } else ()
    } else ()
  }
  // N1, N2: neutrals (and isolate controls) between two of the same
  // direction take it (numbers count as right to left), else e's
  var p = 0
  while p < m {
    if t[p] == 3 or t[p] >= 9 and t[p] <= 12 then {
      var q = p
      while q < m and (t[q] == 3 or t[q] >= 9 and t[q] <= 12) { q = q + 1 }
      let before = if p == 0 then sos else (if t[p - 1] == 0 then 0 else 1)
      let after = if q == m then eos else (if t[q] == 0 then 0 else 1)
      let d = if before == after then before else e % 2
      for r in p..<q { t[r] = d }
      p = q
    } else p = p + 1
  }
  // I1, I2
  for p2 in 0..<m {
    let ty = t[p2]
    out[seq[p2]] = if e % 2 == 0 then (if ty == 1 then e + 1 else if ty == 2 or ty == 13 then e + 2 else e)
      else (if ty == 1 then e else e + 1)
  }
  out
}

// The display order of characters with these levels (the character shown
// at each position, left to right): every run at or above each level
// reversed, highest first.
pub fn order_of(levels: List[Int]) -> List[Int] = {
  let n = list.len(levels)
  var order: List[Int] = list.range(0, n)
  var top = 0
  for lv in levels { top = int.max(top, lv) }
  while top >= 1 {
    var i = 0
    while i < n {
      if levels[order[i]] >= top then {
        var j = i
        while j < n and levels[order[j]] >= top { j = j + 1 }
        let run = list.reverse(list.slice(order, i, j))
        order = list.take(order, i) + run + list.drop(order, j)
        i = j
      } else i = i + 1
    }
    top = top - 1
  }
  order
}

