// `ceangal dev`: build, watch, rebuild. The web target serves the build and
// reloads open pages after each one (a failed build shows its error on the
// page); the desktop targets restart the app.

import self.manifest as mf

@extern(rust, "crate::dev", "dev_stamp")
fn stamp(paths: List[String]) -> String = _
// A line on stdout, flushed at once (almide/almide#3417): for output that
// comes before a child process's.
@extern(rust, "crate::dev", "dev_say")
pub fn say(line: String) -> Unit = _
@extern(rust, "crate::dev", "dev_sleep")
fn sleep(ms: Int) -> Unit = _
@extern(rust, "crate::dev", "dev_serve")
fn serve(root: String, port: Int) -> Int = _
@extern(rust, "crate::dev", "dev_announce")
fn announce(error: String) -> Unit = _
@extern(rust, "crate::dev", "dev_publish")
fn publish(next: String, live: String) -> Int = _
@extern(rust, "crate::dev", "dev_run_tee")
fn run_tee(cmd: String, args: List[String], dir: String, keys: List[String], vals: List[String]) -> Int = _
@extern(rust, "crate::dev", "dev_last_output")
fn last_output() -> String = _
@extern(rust, "crate::dev", "dev_spawn")
fn spawn(cmd: String, args: List[String], dir: String, keys: List[String], vals: List[String]) -> Int = _
@extern(rust, "crate::dev", "dev_exit_code")
fn exit_code(id: Int) -> Int = _
@extern(rust, "crate::dev", "dev_kill")
fn kill(id: Int) -> Unit = _
// Where to start the build from: on Windows a copy (a running .exe cannot be
// replaced by the next build).
@extern(rust, "crate::dev", "dev_runnable")
fn runnable(exe: String, turn: Int) -> String = _

// What a change to rebuilds after: the sources (the entry's directory),
// ceangal.toml, and the asset, native and web paths it names. Not the whole
// app directory: logs, notes and build output land there too, and a file
// written on every rebuild (a log of `ceangal dev` itself) would rebuild
// forever.
pub fn watched(app: mf.App) -> List[String] = {
  let entry = mf.absolute(app.dir, app.entry)
  let parts = string.split(entry, "/")
  let src = string.join(list.take(parts, list.len(parts) - 1), "/")
  [src, app.dir + "/ceangal.toml"] + list.filter(app.assets + app.web_files + [app.web_boot, app.web_prebuild, app.native_dir], (p) => p != "")
}

// After a change: the stamp once the files stay put for a moment (a save
// can be several writes: truncate, write, rename).
fn settled(paths: List[String], first: String) -> String = {
  var last = first
  var next = { sleep(150); stamp(paths) }
  while next != last {
    last = next
    next = { sleep(150); stamp(paths) }
  }
  last
}

fn keys_of(pairs: List[(String, String)]) -> List[String] = list.map(pairs, (p) => p.0)
fn vals_of(pairs: List[(String, String)]) -> List[String] = list.map(pairs, (p) => p.1)

// One web build into `next`, then swapped in; pages reload (or show the error).
fn build_web(app: mf.App, sdk: String, pairs: List[(String, String)], next: String, live: String) -> Bool = {
  let env = pairs + [("WEB_OUT", next), ("SKIP_COMPILER", "1"), ("CEANGAL_WASM_OPT", "0")]
  let code = run_tee("bash", [sdk + "/tools/build_web.sh"], app.dir, keys_of(env), vals_of(env))
  if code == 0 and publish(next, live) == 1 then { announce(""); true }
  else { announce(last_output()); false }
}

pub effect fn web(app: mf.App, sdk: String, pairs: List[(String, String)], port: Int) -> Result[Unit, String] = {
  let live = app.out + "/dev-web"
  let next = app.out + "/dev-web-next"
  let actual = serve(live, port)
  if actual < 0 then err("the dev server could not start")
  else {
    let url = "http://localhost:" + int.to_string(actual) + "/"
    say("ceangal dev: " + app.name + " at " + url + " — edits rebuild it and reload the page (Ctrl+C stops)")
    let paths = watched(app)
    let first = build_web(app, sdk, pairs, next, live)
    // after the build: the first one writes the store icons it was missing
    var seen = stamp(paths)
    say(if first then "ceangal dev: ready at " + url else "ceangal dev: the build failed — the page shows why; fix it and save")
    while true {
      sleep(300)
      let now = stamp(paths)
      if now != seen then {
        seen = settled(paths, now)
        say("ceangal dev: rebuilding…")
        let built = build_web(app, sdk, pairs, next, live)
        // edits made during the build start another one
        seen = if stamp(paths) == seen then seen else ""
        say(if built then "ceangal dev: reloaded" else "ceangal dev: the build failed (shown on the page)")
      } else ()
    }
    ok(())
  }
}

// The desktop: build, start, and on each change build again and restart the
// app with the new build (a failed build keeps the running one). Closing the
// app ends `ceangal dev`; a crash does not: it says so and waits for an edit.
pub effect fn desktop(app: mf.App, sdk: String, pairs: List[(String, String)], exe: String, assets: String) -> Result[Unit, String] = {
  let paths = watched(app)
  let build = () => run_tee("bash", [sdk + "/tools/build_native.sh", "-o", exe], app.dir, keys_of(pairs), vals_of(pairs))
  if build() != 0 then err("the build failed")
  else {
    var seen = stamp(paths)
    var turn = 0
    let start = (n: Int) => {
      let path = runnable(exe, n)
      spawn(path, [], app.dir, ["CEANGAL_ASSETS"], [assets])
    }
    var pid = start(turn)
    say("ceangal dev: " + app.name + " is running — edits rebuild and restart it (close it or Ctrl+C to stop)")
    var running = pid >= 0
    while running {
      sleep(300)
      let now = stamp(paths)
      if now != seen then {
        seen = settled(paths, now)
        say("ceangal dev: rebuilding…")
        if build() == 0 then {
          if pid >= 0 then kill(pid) else ()
          turn = turn + 1
          pid = start(turn)
          say("ceangal dev: restarted")
        } else say("ceangal dev: the build failed — the running app is the last good build")
        seen = if stamp(paths) == seen then seen else ""
      } else if pid >= 0 then {
        let code = exit_code(pid)
        if code == 0 then running = false
        else if code != -1 then {
          say("ceangal dev: the app exited with " + int.to_string(code) + " (output above) — save an edit to start it again")
          pid = -1
        } else ()
      } else ()
    }
    ok(())
  }
}
