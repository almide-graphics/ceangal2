// composite over a 1024x1024 canvas, every pixel covered (one call).
import self.vec as vec

effect fn main() -> Unit = {
  let w = 1024
  let h = 1024
  let pxo = (w + 2) * h + 4
  var buf = bytes.new((pxo + w * h * 4) * 4)
  for y in 0..<h { bytes.set_f32_le(buf, (y * (w + 2)) * 4, 1.0) }
  let m = { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
  vec.composite(w, h, buf, pxo, 0, w + 2, 0, h, { r: 0.5, g: 0.6, b: 0.9, a: 1.0 }, none, m, 0.0, 0.0, 1.0, 1.0, 1.0, false)
  println("${bytes.read_f32_le(buf, (pxo + 4 * (w * h - 1)) * 4)}")
}
