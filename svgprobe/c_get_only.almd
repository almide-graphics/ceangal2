// The same buffer and loop, read through the by-value helper only.
fn getf(b: Bytes, i: Int) -> Float = bytes.get_f32_le(b, i * 4) ?? 0.0

fn pass(b: Bytes, n: Int) -> Float = {
  var s = 0.0
  for i in 0..<n { s = s + getf(b, i) }
  s
}

effect fn main() -> Unit = {
  let n = 1000000
  let buf = bytes.zeros(n * 4 * 5)
  println("${pass(buf, n)}")
}
