// A 20 MB local buffer threaded through a `mut` param; each element is read
// through a helper that takes the buffer by value (as snaidhm.vector does).
fn getf(b: Bytes, i: Int) -> Float = bytes.get_f32_le(b, i * 4) ?? 0.0
fn setf(mut b: Bytes, i: Int, v: Float) -> Unit = bytes.put_f32_le(b, i * 4, v)

fn pass(mut b: Bytes, n: Int) -> Unit = {
  for i in 0..<n { setf(b, i, getf(b, i) + 1.0) }
}

effect fn main() -> Unit = {
  let n = 1000000
  var buf = bytes.zeros(n * 4 * 5)
  pass(buf, n)
  println("${getf(buf, n - 1)}")
}
