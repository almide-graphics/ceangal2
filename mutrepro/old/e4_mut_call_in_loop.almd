// One `mut` helper called in a loop from a `mut` param fn.
fn setf(mut b: Bytes, i: Int, v: Float) -> Unit = bytes.set_f32_le(b, i * 4, v)
fn walk(mut b: Bytes, n: Int) -> Unit = { for i in 0..<n { setf(b, i, 1.0) } }
effect fn main() -> Unit = {
  var buf = bytes.new(4000000)
  walk(buf, 20000)
  println("done")
}
